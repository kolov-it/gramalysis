rule v.indirect-inverted-perfect-avoir-adverb: V[lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, subj=yes, acc=no, neg=?ng, gender=?g, gap=yes, aux_mood=?m, aux_tense=?auxt, aux_person=?r, aux_number=?n, aux_form=?auxf] -> Clitics[attached=no, reflexive=no, acc=no, refl=?r, obj=?o, rnum=?n] Verb[lemma=avoir, finite=yes, mood=?m, person=?p, number=?n, person=?r, person!=?o, tense=?auxt, form=?auxf] Pron[attached=yes, case=nom, person=?p, number=?n, gender=?g] Mod[neg=?ng] Verb[lemma=?l, form=pastpart, takes_avoir=yes, number=sg, gender=m]
  "The same with an adverb or pas (Ne lui as-tu pas écrit ?)."

rule v.inverted-perfect-etre: V[lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=yes, acc=no, neg=no, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> Verb[lemma=être, finite=yes, mood=ind|cnd|sub, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Pron[attached=yes, case=nom, person=?p, number=?n, pnum=?pn, gender=?g] Verb[lemma=?l, form=pastpart, takes_etre=yes, number=?pn, gender=?g]
  "A compound tense with être, inverted (Est-il parti ?)."

rule v.inverted-perfect-etre-adverb: V[lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=yes, acc=no, neg=?ng, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> Verb[lemma=être, finite=yes, mood=ind|cnd|sub, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Pron[attached=yes, case=nom, person=?p, number=?n, pnum=?pn, gender=?g] Mod[neg=?ng] Verb[lemma=?l, form=pastpart, takes_etre=yes, number=?pn, gender=?g]
  "A compound tense with être, inverted, with an adverb or pas (Est-il déjà venu ? N'est-il pas venu ?)."

rule v.proclitic-inverted-perfect-etre: V[dperson=?dp, dnum=?dn, lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=yes, acc=no, neg=no, aux_mood=?m, aux_tense=?auxt, aux_person=?r, aux_number=?n, aux_form=?auxf] -> Clitics[dperson=?dp, dnum=?dn, attached=no, reflexive=no, acc=no, refl=?r, obj=?o, rnum=?n] Verb[lemma=être, finite=yes, mood=ind|cnd|sub, mood=?m, person=?p, number=?n, person=?r, person!=?o, tense=?auxt, form=?auxf] Pron[attached=yes, case=nom, person=?p, number=?n, pnum=?pn, gender=?g] Verb[lemma=?l, form=pastpart, takes_etre=yes, number=?pn, gender=?g]
  "y or en, then an inverted compound tense with être (Y est-il allé ? En est-elle sortie ?)."

rule v.proclitic-inverted-perfect-etre-adverb: V[dperson=?dp, dnum=?dn, lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=yes, acc=no, neg=?ng, aux_mood=?m, aux_tense=?auxt, aux_person=?r, aux_number=?n, aux_form=?auxf] -> Clitics[dperson=?dp, dnum=?dn, attached=no, reflexive=no, acc=no, refl=?r, obj=?o, rnum=?n] Verb[lemma=être, finite=yes, mood=ind|cnd|sub, mood=?m, person=?p, number=?n, person=?r, person!=?o, tense=?auxt, form=?auxf] Pron[attached=yes, case=nom, person=?p, number=?n, pnum=?pn, gender=?g] Mod[neg=?ng] Verb[lemma=?l, form=pastpart, takes_etre=yes, number=?pn, gender=?g]
  "The same with an adverb or pas (N'y est-il pas allé ?)."

rule v.perfect-infinitive: V[lemma=?l, finite=no, form=inf, subj=no, acc=no, neg=no, aux_mood=?auxm, aux_tense=?auxt, aux_person=?auxp, aux_number=?auxn, aux_form=?auxf] -> Verb[lemma=avoir, form=inf, mood=?auxm, tense=?auxt, person=?auxp, number=?auxn, form=?auxf] Verb[lemma=?l, form=pastpart, takes_avoir=yes, number=sg, gender=m]
  "The past infinitive with avoir: the participle does not agree (après avoir mangé)."

rule v.perfect-infinitive-etre: V[lemma=?l, finite=no, form=inf, subj=no, acc=no, neg=no, pnum=?pn, gender=?g, aux_mood=?auxm, aux_tense=?auxt, aux_person=?auxp, aux_number=?auxn, aux_form=?auxf] -> Verb[lemma=être, form=inf, mood=?auxm, tense=?auxt, person=?auxp, number=?auxn, form=?auxf] Verb[lemma=?l, form=pastpart, takes_etre=yes, number=?pn, gender=?g]
  "The past infinitive with être, for verbs that take être (après être arrivé); the participle agrees with whoever controls the infinitive (elle veut être partie)."

rule v.passive-past-infinitive: V[intrans=yes, lemma=?l, finite=no, form=inf, subj=no, acc=no, neg=no, pnum=?pn, gender=?g, aux_mood=?auxm, aux_tense=?auxt, aux_person=?auxp, aux_number=?auxn, aux_form=?auxf, voice=passive] -> Verb[lemma=avoir, form=inf, mood=?auxm, tense=?auxt, person=?auxp, number=?auxn, form=?auxf] Verb[lemma=être, form=pastpart] Verb[lemma=?l, form=pastpart, takes_avoir=yes, number=?pn, gender=?g]
  "The passive in the past infinitive: avoir été + participle (après avoir été blessé)."

rule v.proclitic-perfect-infinitive: V[dperson=?dp, dnum=?dn, lemma=?l, finite=no, form=inf, subj=no, acc=yes, neg=no, anum=?on, agen=?og, aperson=?ap, aux_mood=?auxm, aux_tense=?auxt, aux_person=?auxp, aux_number=?auxn, aux_form=?auxf] -> Clitics[dperson=?dp, dnum=?dn, attached=no, reflexive=no, acc=yes, anum=?on, agen=?og, aperson=?ap] Verb[lemma=avoir, form=inf, mood=?auxm, tense=?auxt, person=?auxp, number=?auxn, form=?auxf] Verb[lemma=?l, form=pastpart, takes_avoir=yes, number=?on, gender=?og]
  "le, la, les before the past infinitive with avoir: the participle agrees with it (pour les avoir vues)."

rule v.indirect-perfect-infinitive: V[lemma=?l, finite=no, form=inf, subj=no, acc=no, neg=no, aux_mood=?auxm, aux_tense=?auxt, aux_person=?auxp, aux_number=?auxn, aux_form=?auxf] -> Clitics[attached=no, reflexive=no, acc=no] Verb[lemma=avoir, form=inf, mood=?auxm, tense=?auxt, person=?auxp, number=?auxn, form=?auxf] Verb[lemma=?l, form=pastpart, takes_avoir=yes, number=sg, gender=m]
  "An indirect pronoun before the past infinitive with avoir (pour lui avoir parlé)."

rule v.proclitic-perfect-infinitive-etre: V[dperson=?dp, dnum=?dn, lemma=?l, finite=no, form=inf, subj=no, acc=no, neg=no, pnum=?pn, gender=?g, aux_mood=?auxm, aux_tense=?auxt, aux_person=?auxp, aux_number=?auxn, aux_form=?auxf] -> Clitics[dperson=?dp, dnum=?dn, attached=no, reflexive=no, acc=no] Verb[lemma=être, form=inf, mood=?auxm, tense=?auxt, person=?auxp, number=?auxn, form=?auxf] Verb[lemma=?l, form=pastpart, takes_etre=yes, number=?pn, gender=?g]
  "y or en before the past infinitive with être (après y être allé)."

rule v.reflexive-perfect-infinitive: V[lemma=?l, finite=no, form=inf, subj=no, acc=?a, neg=no, pnum=?pn, gender=?g, irefl=?ir, irnum=?irn, aux_mood=?auxm, aux_tense=?auxt, aux_person=?auxp, aux_number=?auxn, aux_form=?auxf] -> Clitics[attached=no, reflexive=yes, acc=?a, refl=?ir, rnum=?irn] Verb[lemma=être, form=inf, mood=?auxm, tense=?auxt, person=?auxp, number=?auxn, form=?auxf] Verb[lemma=?l, form=pastpart, number=?pn, gender=?g]
  "A pronominal verb's past infinitive takes être (après s'être levé)."

rule v.reflexive-perfect-infinitive-indirect: V[lemma=?l, finite=no, form=inf, subj=no, acc=no, neg=no, needs_obj=yes, irefl=?ir, irnum=?irn, aux_mood=?auxm, aux_tense=?auxt, aux_person=?auxp, aux_number=?auxn, aux_form=?auxf] -> Clitics[attached=no, reflexive=yes, acc=no, refl=?ir, rnum=?irn] Verb[lemma=être, form=inf, mood=?auxm, tense=?auxt, person=?auxp, number=?auxn, form=?auxf] Verb[lemma=?l, form=pastpart, number=sg, gender=m]
  "The same with an indirect reflexive and a direct object after it: the participle stays masculine singular and does not agree with the subject (elle croit s'être écrit une lettre), as in v.reflexive-perfect-indirect."

rule v.perfect-gerund: V[lemma=?l, finite=no, form=prespart, subj=no, acc=no, neg=no, aux_mood=?auxm, aux_tense=?auxt, aux_person=?auxp, aux_number=?auxn, aux_form=?auxf] -> Verb[lemma=avoir, form=prespart|ger, mood=?auxm, tense=?auxt, person=?auxp, number=?auxn, form=?auxf] Verb[lemma=?l, form=pastpart, takes_avoir=yes, number=sg, gender=m]
  "ayant + participle, which does not agree (ayant fini)."

rule v.perfect-gerund-etre: V[lemma=?l, finite=no, form=prespart, subj=no, acc=no, neg=no, pnum=?pn, gender=?g, aux_mood=?auxm, aux_tense=?auxt, aux_person=?auxp, aux_number=?auxn, aux_form=?auxf] -> Verb[lemma=être, form=prespart|ger, mood=?auxm, tense=?auxt, person=?auxp, number=?auxn, form=?auxf] Verb[lemma=?l, form=pastpart, takes_etre=yes, number=?pn, gender=?g]
  "étant + participle of an être verb (étant arrivé)."

rule v.proclitic-perfect-gerund: V[dperson=?dp, dnum=?dn, lemma=?l, finite=no, form=prespart, subj=no, acc=yes, neg=no, anum=?on, agen=?og, aperson=?ap, aux_mood=?auxm, aux_tense=?auxt, aux_person=?auxp, aux_number=?auxn, aux_form=?auxf] -> Clitics[dperson=?dp, dnum=?dn, attached=no, reflexive=no, acc=yes, anum=?on, agen=?og, aperson=?ap] Verb[lemma=avoir, form=prespart|ger, mood=?auxm, tense=?auxt, person=?auxp, number=?auxn, form=?auxf] Verb[lemma=?l, form=pastpart, takes_avoir=yes, number=?on, gender=?og]
  "le, la, les before ayant + participle, which agrees with it (en les ayant vus)."

rule v.indirect-perfect-gerund: V[lemma=?l, finite=no, form=prespart, subj=no, acc=no, neg=no, aux_mood=?auxm, aux_tense=?auxt, aux_person=?auxp, aux_number=?auxn, aux_form=?auxf] -> Clitics[attached=no, reflexive=no, acc=no] Verb[lemma=avoir, form=prespart|ger, mood=?auxm, tense=?auxt, person=?auxp, number=?auxn, form=?auxf] Verb[lemma=?l, form=pastpart, takes_avoir=yes, number=sg, gender=m]
  "An indirect pronoun before ayant + participle (en lui ayant parlé)."

rule v.reflexive-perfect-gerund: V[lemma=?l, finite=no, form=prespart, subj=no, acc=?a, neg=no, pnum=?pn, gender=?g, irefl=?ir, irnum=?irn, aux_mood=?auxm, aux_tense=?auxt, aux_person=?auxp, aux_number=?auxn, aux_form=?auxf] -> Clitics[attached=no, reflexive=yes, acc=?a, refl=?ir, rnum=?irn] Verb[lemma=être, form=prespart|ger, mood=?auxm, tense=?auxt, person=?auxp, number=?auxn, form=?auxf] Verb[lemma=?l, form=pastpart, number=?pn, gender=?g]
  "A pronominal verb with étant (s'étant levé)."

rule v.passive-event: V[intrans=yes, lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=no, acc=no, neg=no, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf, voice=passive] -> Verb[lemma=être, finite=yes, tense=pret|fut, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Verb[lemma=?l, form=pastpart, takes_avoir=yes, number=?pn, gender=?g]
  "The passive with être in the passé simple or the future: an event, not a state (il fut tué, ce sera fait)."

rule v.passive-event-inverted: V[intrans=yes, lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=yes, acc=no, neg=no, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf, voice=passive] -> Verb[lemma=être, finite=yes, tense=pret|fut, mood=ind|cnd|sub, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Pron[attached=yes, case=nom, person=?p, number=?n, pnum=?pn, gender=?g] Verb[lemma=?l, form=pastpart, takes_avoir=yes, number=?pn, gender=?g]
  "The passive with être in the passé simple or the future, inverted (Sera-t-elle fermée ? Fut-il tué ?)."

rule v.passive-perfect: V[intrans=yes, lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=no, acc=no, neg=no, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf, voice=passive] -> Verb[lemma=avoir, finite=yes, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Verb[lemma=être, form=pastpart] Verb[lemma=?l, form=pastpart, takes_avoir=yes, number=?pn, gender=?g]
  "The passive in a compound tense: a été + participle (il a été tué, elles ont été vendues)."

rule v.passive-perfect-inverted: V[intrans=yes, lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=yes, acc=no, neg=no, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf, voice=passive] -> Verb[lemma=avoir, finite=yes, mood=ind|cnd|sub, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Pron[attached=yes, case=nom, person=?p, number=?n, pnum=?pn, gender=?g] Verb[lemma=être, form=pastpart] Verb[lemma=?l, form=pastpart, takes_avoir=yes, number=?pn, gender=?g]
  "The passive in a compound tense, inverted: the participle agrees with the subject pronoun (A-t-elle été fermée ?)."

rule v.passive-perfect-inverted-adverb: V[intrans=yes, lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=yes, acc=no, neg=?ng, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf, voice=passive] -> Verb[lemma=avoir, finite=yes, mood=ind|cnd|sub, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Pron[attached=yes, case=nom, person=?p, number=?n, pnum=?pn, gender=?g] Mod[neg=?ng, qnum=?pn, qgen=?g] Verb[lemma=être, form=pastpart] Verb[lemma=?l, form=pastpart, takes_avoir=yes, number=?pn, gender=?g]
  "The inverted passive in a compound tense with an adverb or pas (A-t-elle déjà été vendue ? N'a-t-il pas été invité ?)."

rule v.passive-perfect-adverb: V[intrans=yes, lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=no, acc=no, neg=?ng, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf, voice=passive] -> Verb[lemma=avoir, finite=yes, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Mod[neg=?ng] Verb[lemma=être, form=pastpart] Verb[lemma=?l, form=pastpart, takes_avoir=yes, number=?pn, gender=?g]
  "The passive in a compound tense with an adverb (il a déjà été vendu, il n'a pas été invité)."

rule v.passive-perfect-adverb-after: V[intrans=yes, lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=no, acc=no, neg=no, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf, voice=passive] -> Verb[lemma=avoir, finite=yes, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Verb[lemma=être, form=pastpart] Adv Verb[lemma=?l, form=pastpart, takes_avoir=yes, number=?pn, gender=?g]
  "The passive in a compound tense with an adverb before the participle (j'ai été massivement piqué)."

rule v.passive-perfect-clitic: V[intrans=yes, lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=no, acc=no, neg=no, aux_mood=?m, aux_tense=?auxt, aux_person=?r, aux_number=?n, aux_form=?auxf, voice=passive] -> Clitics[attached=no, acc=no, refl=?r, obj=?o, rnum=?n] Verb[lemma=avoir, finite=yes, mood=?m, person=?p, number=?n, person=?r, person!=?o, tense=?auxt, form=?auxf] Verb[lemma=être, form=pastpart] Verb[lemma=?l, form=pastpart, takes_avoir=yes, number=?pn, gender=?g]
  "A pronoun before a passive compound tense (il m'a été donné)."

rule v.passive-infinitive: V[intrans=yes, lemma=?l, finite=no, form=inf, subj=no, acc=no, neg=no, pnum=?pn, gender=?g, aux_mood=?auxm, aux_tense=?auxt, aux_person=?auxp, aux_number=?auxn, aux_form=?auxf, voice=passive] -> Verb[lemma=être, form=inf, mood=?auxm, tense=?auxt, person=?auxp, number=?auxn, form=?auxf] Verb[lemma=?l, form=pastpart, takes_avoir=yes, number=?pn, gender=?g] Prep[lemma=par] NP
  "être + participle + par + agent, in the infinitive (être aimé par tous)."

rule mod.adverb: Mod[neg=no] -> Adv
  "An adverb between the auxiliary and the participle (déjà, toujours, bien)."

rule mod.d-abord: Mod[neg=no] -> Prep[lemma=de] Noun[lemma=abord]
  "d'abord between the auxiliary and the participle (j'ai d'abord écrit la lettre)."

rule mod.negation: Mod[neg=yes] -> NegAdv
  "pas, plus, jamais, rien between the auxiliary and the participle."

rule mod.negation-adverb: Mod[neg=yes] -> NegAdv Adv
  "pas encore, plus jamais."

rule mod.two-negations: Mod[neg=yes] -> NegAdv NegAdv
  "plus jamais, jamais rien."

rule mod.two-adverbs: Mod[neg=no] -> Adv Adv
  "Two adverbs (déjà bien)."

rule mod.all: Mod[neg=no, qnum=pl, qgen=?g] -> Pron[lemma=tout, number=pl, gender=?g]
  "tous, toutes between the auxiliary and the participle (nous a tous surpris)."

rule v.negated-compound: V[intrans=?it, lemma=?l, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, acc=?a, neg=yes, gap=?gp, irefl=?ir, irnum=?irn, needs_obj=?no, agreed=?agr, causative=?cz, etre=?e, anum=?an, agen=?ag, aperson=?ap, dperson=?dp, dnum=?dn] -> Neg V[intrans=?it, encl=no, gap=?gp, irefl=?ir, irnum=?irn, needs_obj=?no, agreed=?agr, causative=?cz, etre=?e, anum=?an, agen=?ag, aperson=?ap, dperson=?dp, dnum=?dn, lemma=?l, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, acc=?a, neg=yes]
  "ne before a compound tense that holds pas (je n'ai pas vu)."

# clitic groups before the verb
rule clitics.reflexive: Clitics[reflexive=yes, attached=?t, refl=?p, acc=no, rnum=?rn] -> Pron[attached=?t, clitic=yes, case=refl, person=?p, number=?rn]
  "A reflexive pronoun: the action falls back on the subject (je me lave, il se lève)."

rule clitics.local-acc: Clitics[reflexive=no, attached=?t, obj=?p, acc=yes, anum=?n, aperson=?p] -> Pron[attached=?t, clitic=yes, case=acc, person=1|2, person=?p, number=?n]
  "A 1st or 2nd person direct object pronoun (il me voit, je vous aime)."

rule clitics.local-acc-plural: Clitics[reflexive=no, attached=?t, acc=yes, anum=?n, aperson=?p] -> Pron[attached=?t, clitic=yes, case=acc, person=1, person=?p, number=?n, number=pl]
  "nous as the object may share a singular subject's person (je nous vois): no obj check. Not vous, which is also the polite singular (tu vous laves stays out)."

rule clitics.local-dat: Clitics[reflexive=no, attached=?t, obj=?p, acc=no, dperson=?p, dnum=?dn] -> Pron[attached=?t, clitic=yes, case=dat, person=1|2, person=?p, number=?dn]
  "A 1st or 2nd person indirect object pronoun (il me parle, je te donne)."

rule clitics.local-dat-plural: Clitics[reflexive=no, attached=?t, acc=no, dperson=1, dnum=pl] -> Pron[attached=?t, clitic=yes, case=dat, person=1, person=?p, number=pl]
  "nous as the object may share a singular subject's person (je nous vois): no obj check. Not vous, which is also the polite singular (tu vous laves stays out)."

rule clitics.acc: Clitics[reflexive=no, attached=?t, acc=yes, anum=?n, agen=?g, aperson=3] -> Pron[attached=?t, clitic=yes, case=acc, person=3, number=?n, gender=?g]
  "A direct object pronoun: le, la, l', les."

rule clitics.other: Clitics[reflexive=no, attached=?t, acc=no] -> Pron[attached=?t, clitic=yes, case=loc|gen, person=3]
  "lui, leur, y, en."

rule clitics.dat3: Clitics[reflexive=no, attached=?t, acc=no, dperson=3, dnum=?n] -> Pron[attached=?t, clitic=yes, case=dat, person=3, number=?n]
  "lui, leur: a 3rd-person indirect object, which can control an infinitive (elle leur dit d'être heureuses)."

rule clitics.reflexive-acc: Clitics[reflexive=yes, attached=?t, refl=?p, acc=yes, anum=?n, agen=?g, rnum=?rn, aperson=3] -> Pron[attached=?t, clitic=yes, case=refl, person=?p, number=?rn] Pron[clitic=yes, case=acc, person=3, number=?n, gender=?g]
  "A reflexive pronoun before le, la, les (je me le demande)."

rule clitics.reflexive-other: Clitics[reflexive=yes, attached=?t, refl=?p, acc=no, rnum=?rn] -> Pron[attached=?t, clitic=yes, case=refl, person=?p, number=?rn] Pron[clitic=yes, case=loc|gen]
  "A reflexive pronoun before y or en (il s'en va, je m'y attendais)."

rule clitics.local-acc3: Clitics[reflexive=no, attached=?t, obj=?p, acc=yes, anum=?n, agen=?g, aperson=3] -> Pron[attached=?t, clitic=yes, case=dat, person=1|2, person=?p] Pron[clitic=yes, case=acc, person=3, number=?n, gender=?g]
  "me, te, nous, vous before le, la, les (il me le donne)."

rule clitics.local-acc3-plural: Clitics[reflexive=no, attached=?t, acc=yes, anum=?n, agen=?g, aperson=3] -> Pron[attached=?t, clitic=yes, case=dat, person=1, person=?p, number=pl] Pron[clitic=yes, case=acc, person=3, number=?n, gender=?g]
  "nous as the object may share a singular subject's person (je nous vois): no obj check. Not vous, which is also the polite singular (tu vous laves stays out)."

rule clitics.local-other: Clitics[reflexive=no, attached=?t, obj=?p, acc=no] -> Pron[attached=?t, clitic=yes, case=dat, person=1|2, person=?p] Pron[clitic=yes, case=gen]
  "me, te, nous, vous before en (il m'en parle)."

rule clitics.local-other-plural: Clitics[reflexive=no, attached=?t, acc=no] -> Pron[attached=?t, clitic=yes, case=dat, person=1, person=?p, number=pl] Pron[clitic=yes, case=gen]
  "nous as the object may share a singular subject's person (je nous vois): no obj check. Not vous, which is also the polite singular (tu vous laves stays out)."

rule clitics.local-acc-y: Clitics[reflexive=no, attached=?t, obj=?p, acc=yes, anum=?n, aperson=?p] -> Pron[attached=?t, clitic=yes, case=acc, person=1|2, person=?p, number=?n] Pron[clitic=yes, case=loc]
  "me, te before y (je t'y emmène)."

rule clitics.local-acc-y-plural: Clitics[reflexive=no, attached=?t, acc=yes, anum=?n, aperson=?p] -> Pron[attached=?t, clitic=yes, case=acc, person=1, person=?p, number=?n, number=pl] Pron[clitic=yes, case=loc]
  "nous as the object may share a singular subject's person (je nous vois): no obj check. Not vous, which is also the polite singular (tu vous laves stays out)."

rule clitics.acc-dat: Clitics[reflexive=no, attached=?t, acc=yes, anum=?n, agen=?g, aperson=3] -> Pron[attached=?t, clitic=yes, case=acc, person=3, number=?n, gender=?g] Pron[clitic=yes, case=dat, person=3]
  "le, la, les before lui, leur (je le lui donne)."

rule clitics.acc-other: Clitics[reflexive=no, attached=?t, acc=yes, anum=?n, agen=?g, aperson=3] -> Pron[attached=?t, clitic=yes, case=acc, person=3, number=?n, gender=?g] Pron[clitic=yes, case=loc]
  "le, la, les before y (je l'y ai mis)."

rule clitics.acc-en: Clitics[reflexive=no, attached=?t, acc=yes, anum=?n, agen=?g, aperson=3] -> Pron[attached=?t, clitic=yes, case=acc, person=3, number=?n, gender=?g] Pron[clitic=yes, case=gen]
  "le, la, les before en (il les en empêche)."

rule clitics.dat-en: Clitics[reflexive=no, attached=?t, acc=no] -> Pron[attached=?t, clitic=yes, case=dat|loc, person=3] Pron[clitic=yes, case=gen]
  "lui, leur or y before en (je lui en parle, il y en a)."

# clitic groups after an imperative (hyphenated)
rule encl.reflexive: EnCl[refl=?p, acc=no, rnum=?rn] -> Pron[attached=yes, case=refl, person=?p, number=?rn]
  "A reflexive pronoun after an order (lève-toi, asseyez-vous)."

rule encl.local: EnCl[obj=?p, acc=no] -> Pron[attached=yes, case=dat, person=1|2, person=?p]
  "me (moi), nous, vous after an order (aide-moi, dis-nous)."

rule encl.local-plural: EnCl[acc=no] -> Pron[attached=yes, case=dat, person=1, person=?p, number=pl]
  "nous as the object may share a singular subject's person (je nous vois): no obj check. Not vous, which is also the polite singular (tu vous laves stays out)."

rule encl.local-acc: EnCl[obj=?p, acc=yes, anum=?an] -> Pron[attached=yes, case=acc, person=1|2, person=?p, number=?an]
  "moi, nous, vous as the direct object after an order; an adjective after it agrees with it (rends-moi heureux, aide-nous)."

rule encl.local-acc-plural: EnCl[acc=yes, anum=pl] -> Pron[attached=yes, case=acc, person=1, person=?p, number=pl]
  "nous as the direct object of a singular order (rends-nous heureux)."

rule encl.acc: EnCl[acc=yes, anum=?an, agen=?ag] -> Pron[attached=yes, case=acc, person=3, number=?an, gender=?ag]
  "le, la, les after an order (prends-le)."

rule encl.other: EnCl[acc=no] -> Pron[attached=yes, case=dat|loc|gen, person=3]
  "lui, leur, y, en after an order (dis-lui, allez-y, prends-en)."

rule encl.acc-dat: EnCl[acc=yes, obj=?p, anum=?an, agen=?ag] -> Pron[attached=yes, case=acc, person=3, number=?an, gender=?ag] Pron[attached=yes, case=dat, person=?p]
  "le, la, les before moi, lui, nous, leur after an order (donne-le-moi)."

rule encl.acc-dat-plural: EnCl[acc=yes, anum=?an, agen=?ag] -> Pron[attached=yes, case=acc, person=3, number=?an, gender=?ag] Pron[attached=yes, case=dat, person=?p, person=1, number=pl]
  "nous as the object may share a singular subject's person (je nous vois): no obj check. Not vous, which is also the polite singular (tu vous laves stays out)."

rule encl.acc-reflexive: EnCl[acc=yes, refl=?p, anum=?an, agen=?ag] -> Pron[attached=yes, case=acc, person=3, number=?an, gender=?ag] Pron[attached=yes, case=refl, person=?p]
  "le, la, les before a reflexive moi, toi, nous, vous after an order (donne-le-toi, offrez-la-vous)."

rule encl.reflexive-en: EnCl[refl=?p, acc=no, rnum=?rn] -> Pron[attached=yes, case=refl, person=?p, number=?rn] Pron[attached=yes, case=gen|loc]
  "A reflexive pronoun + en after an order (va-t'en, allez-vous-en)."

rule encl.dat-en: EnCl[obj=?p, acc=no] -> Pron[attached=yes, case=dat, person=?p] Pron[attached=yes, case=gen|loc]
  "moi, lui + en after an order (donne-m'en, parle-lui-en)."

rule encl.dat-en-plural: EnCl[acc=no] -> Pron[attached=yes, case=dat, person=?p, person=1, number=pl] Pron[attached=yes, case=gen|loc]
  "nous as the object may share a singular subject's person (je nous vois): no obj check. Not vous, which is also the polite singular (tu vous laves stays out)."

# ------------------------------------------------- linking verbs

rule cop.verb: Cop[mood=?m, person=?p, number=?n, subj=no, marked=no, neg=no] -> Verb[lemma=devenir|sembler|paraître|rester|demeurer, finite=yes, mood=?m, person=?p, number=?n]
  "A linking verb: devenir, sembler, paraître, rester, demeurer."

rule cop.etre: Cop[mood=?m, person=?p, number=?n, subj=no, marked=no, neg=no] -> Verb[lemma=être, finite=yes, tense=pres|impf, mood=?m, person=?p, number=?n]
  "être in the present or the imperfect (or a mood without those tenses): a participle after it may be a state (la porte est fermée). In the passé simple and the future it is `cop.event`."

rule cop.event: Cop[mood=?m, person=?p, number=?n, subj=no, marked=yes, neg=no] -> Verb[lemma=être, finite=yes, tense=pret|fut, mood=?m, person=?p, number=?n]
  "être in the passé simple or the future: a participle after it is a passive (il fut tué)."

rule cop.inverted: Cop[mood=?m, person=?p, number=?n, subj=yes, marked=no, neg=no, pnum=?pn, gender=?g, cesubj=?dm] -> Verb[lemma=être, tense=pres|impf, finite=yes, mood=ind|cnd|sub, mood=?m, person=?p, number=?n] Pron[attached=yes, case=nom, person=?p, number=?n, pnum=?pn, gender=?g, demonstrative=?dm]
  "être with its subject after it (Es-tu prêt ? Est-ce vrai ?); the adjective agrees with that subject."

rule cop.inverted-other: Cop[mood=?m, person=?p, number=?n, subj=yes, marked=no, neg=no, pnum=?pn, gender=?g] -> Verb[lemma=devenir|sembler|paraître|rester|demeurer, finite=yes, mood=ind|cnd|sub, mood=?m, person=?p, number=?n] Pron[attached=yes, case=nom, person=?p, number=?n, pnum=?pn, gender=?g]
  "Another linking verb with its subject after it, in any tense (Deviendra-t-elle heureuse ?)."

rule cop.event-inverted: Cop[mood=?m, person=?p, number=?n, subj=yes, marked=yes, neg=no, pnum=?pn, gender=?g] -> Verb[lemma=être, finite=yes, tense=pret|fut, mood=ind|cnd|sub, mood=?m, person=?p, number=?n] Pron[attached=yes, case=nom, person=?p, number=?n, pnum=?pn, gender=?g]
  "être in the passé simple or the future with its subject after it (Sera-t-elle belle ?); a participle after it is a passive."

rule cop.perfect: Cop[mood=?m, person=?p, number=?n, subj=no, marked=yes, neg=no, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> Verb[lemma=avoir, finite=yes, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Verb[lemma=être, form=pastpart]
  "être in a compound tense (il a été malade); a participle after it is a passive (il a été tué)."

rule cop.perfect-inverted: Cop[mood=?m, person=?p, number=?n, subj=yes, marked=yes, neg=no, pnum=?pn, gender=?g, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> Verb[lemma=avoir, finite=yes, mood=ind|cnd|sub, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Pron[attached=yes, case=nom, person=?p, number=?n, pnum=?pn, gender=?g] Verb[lemma=être, form=pastpart]
  "être in a compound tense, inverted (A-t-elle été malade ?)."

rule cop.perfect-inverted-adverb: Cop[mood=?m, person=?p, number=?n, subj=yes, marked=yes, neg=?ng, pnum=?pn, gender=?g, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> Verb[lemma=avoir, finite=yes, mood=ind|cnd|sub, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Pron[attached=yes, case=nom, person=?p, number=?n, pnum=?pn, gender=?g] Mod[neg=?ng, qnum=?pn, qgen=?g] Verb[lemma=être, form=pastpart]
  "être in a compound tense, inverted, with an adverb or pas (A-t-elle déjà été heureuse ?)."

rule cop.perfect-other: Cop[mood=?m, person=?p, number=?n, subj=no, marked=no, neg=no, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> Verb[lemma=avoir, finite=yes, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Verb[lemma=devenir|sembler|paraître|rester|demeurer, form=pastpart, takes_avoir=yes, number=sg, gender=m]
  "A linking verb that takes avoir in a compound tense; its participle does not agree (elle a semblé heureuse)."

rule cop.perfect-other-etre: Cop[mood=?m, person=?p, number=?n, subj=no, marked=no, neg=no, pnum=?pn, gender=?g, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> Verb[lemma=être, finite=yes, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Verb[lemma=devenir|sembler|paraître|rester|demeurer, form=pastpart, takes_etre=yes, number=?pn, gender=?g]
  "A linking verb that takes être in a compound tense; its participle agrees with the subject (elle est devenue heureuse)."

rule cop.perfect-other-adverb: Cop[mood=?m, person=?p, number=?n, subj=no, marked=no, neg=?ng, pnum=?pn, gender=?g, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> Verb[lemma=avoir, finite=yes, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Mod[neg=?ng, qnum=?pn, qgen=?g] Verb[lemma=devenir|sembler|paraître|rester|demeurer, form=pastpart, takes_avoir=yes, number=sg, gender=m]
  "A linking verb that takes avoir in a compound tense with an adverb or pas (elle n'a pas semblé heureuse)."

rule cop.perfect-other-etre-adverb: Cop[mood=?m, person=?p, number=?n, subj=no, marked=no, neg=?ng, pnum=?pn, gender=?g, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> Verb[lemma=être, finite=yes, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Mod[neg=?ng, qnum=?pn, qgen=?g] Verb[lemma=devenir|sembler|paraître|rester|demeurer, form=pastpart, takes_etre=yes, number=?pn, gender=?g]
  "A linking verb that takes être in a compound tense with an adverb or pas; the participle agrees (il est déjà devenu, elle n'est pas restée)."

rule cop.perfect-other-inverted: Cop[mood=?m, person=?p, number=?n, subj=yes, marked=no, neg=no, pnum=?pn, gender=?g, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> Verb[lemma=avoir, finite=yes, mood=ind|cnd|sub, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Pron[attached=yes, case=nom, person=?p, number=?n, pnum=?pn, gender=?g] Verb[lemma=devenir|sembler|paraître|rester|demeurer, form=pastpart, takes_avoir=yes, number=sg, gender=m]
  "A linking verb that takes avoir in a compound tense, inverted (A-t-elle semblé heureuse ?)."

rule cop.perfect-other-etre-inverted: Cop[mood=?m, person=?p, number=?n, subj=yes, marked=no, neg=no, pnum=?pn, gender=?g, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> Verb[lemma=être, finite=yes, mood=ind|cnd|sub, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Pron[attached=yes, case=nom, person=?p, number=?n, pnum=?pn, gender=?g] Verb[lemma=devenir|sembler|paraître|rester|demeurer, form=pastpart, takes_etre=yes, number=?pn, gender=?g]
  "A linking verb that takes être in a compound tense, inverted; the participle agrees (Est-elle devenue riche ?)."

rule cop.perfect-adverb: Cop[mood=?m, person=?p, number=?n, subj=no, marked=yes, neg=?ng, pnum=?pn, gender=?g, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> Verb[lemma=avoir, finite=yes, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Mod[neg=?ng, qnum=?pn, qgen=?g] Verb[lemma=être, form=pastpart]
  "être in a compound tense with an adverb (il a toujours été, je n'ai jamais été)."

rule cop.proclitic: Cop[mood=?m, person=?p, number=?n, subj=?s, marked=?k, neg=?ng, pnum=?pn, gender=?g] -> Clitics[attached=no, reflexive=no, acc=no, refl=?r, obj=?o, rnum=?n] Cop[mood=?m, person=?p, number=?n, person=?r, person!=?o, subj=?s, marked=?k, neg=?ng, pnum=?pn, gender=?g]
  "A pronoun before the linking verb (il m'est difficile, ça me semble bizarre, j'y suis). A me/te/nous/vous of the subject's own person is reflexive, not an indirect object (je me suis… is a pronominal verb)."

rule cop.proclitic-le: Cop[mood=?m, person=?p, number=?n, subj=?s, marked=?k, neg=?ng, pnum=?pn, gender=?g] -> Pron[attached=no, case=acc, lemma=le, number=sg, gender=m] Cop[mood=?m, person=?p, number=?n, subj=?s, marked=?k, neg=?ng, pnum=?pn, gender=?g]
  "le standing for an adjective (je le suis)."

rule cop.negation: Cop[mood=?m, person=?p, number=?n, subj=?s, marked=?k, neg=yes, pnum=?pn, gender=?g] -> Neg Cop[mood=?m, person=?p, number=?n, subj=?s, marked=?k, neg=no, pnum=?pn, gender=?g]
  "ne before the linking verb."

rule cop.negated-compound: Cop[mood=?m, person=?p, number=?n, subj=?s, marked=?k, neg=yes, pnum=?pn, gender=?g] -> Neg Cop[mood=?m, person=?p, number=?n, subj=?s, marked=?k, neg=yes, pnum=?pn, gender=?g]
  "ne before a compound linking verb that holds pas (il n'a pas été malade, il n'est pas devenu riche)."

rule cop.negation-word: Cop[mood=?m, person=?p, number=?n, subj=?s, marked=?k, neg=yes, pnum=?pn, gender=?g] -> Cop[mood=?m, person=?p, number=?n, subj=?s, marked=?k, neg=yes, pnum=?pn, gender=?g] NegAdv
  "pas, plus, jamais after the linking verb (il n'est pas là)."

rule cop.negation-spoken: Cop[mood=?m, person=?p, number=?n, subj=?s, marked=?k, neg=yes, pnum=?pn, gender=?g] -> Cop[mood=?m, person=?p, number=?n, subj=?s, marked=?k, neg=no, pnum=?pn, gender=?g] NegAdv[only=no]
  "pas without ne (c'est pas grave)."

rule cop.adverb: Cop[mood=?m, person=?p, number=?n, subj=?s, marked=?k, neg=?ng, pnum=?pn, gender=?g] -> Cop[mood=?m, person=?p, number=?n, subj=?s, marked=?k, neg=?ng, pnum=?pn, gender=?g] Adv
  "An adverb after the linking verb (il est très, c'est vraiment, elle est toujours)."

# ------------------------------------------------------ verb phrases

rule vp.verb: VP[bare=yes, cesubj=?cs, aperson=?ap, dperson=?dp, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, gap=?gp, irefl=?ir, irnum=?irn] -> V[cesubj=?cs, aperson=?ap, dperson=?dp, needs_obj=no, causative=no, gap=?gp, irefl=?ir, irnum=?irn, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s]
  "A verb on its own. Not one that needs a complement (needs_obj=yes: a reflexive compound read as an indirect object, ils se sont dit que…)."

rule vp.object: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, irefl=?ir, irnum=?irn] -> V[intrans=no, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, acc=no, etre=no, irefl=?ir, irnum=?irn] NP[case=obl|obj, bare=no]
  "The verb takes a direct object, unless le, la, les already is its object (je vois le chat, not *je le vois le chat). être takes none: what follows it says what the subject is. A noun without a determiner as the object is vp.bare-object, with listed verbs only. Not after a compound tense with être: a verb that takes être has no direct object (*elle est venue tous)."

rule vp.bare-object: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] -> V[intrans=no, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, acc=no, etre=no, lemma=avoir|faire|prendre|donner|rendre|porter|perdre|tenir|mettre|courir|garder|reprendre|chercher|demander|trouver|tirer|livrer|rendre|prêter|lâcher|ficher|foutre|chanter|parler|jouer|crier|manger|boire|lire|écrire|apprendre|enseigner|étudier|vendre|acheter|cultiver|fabriquer|produire|offrir|servir|risquer|subir|nier|avouer|annoncer|appeler|bâtir|garder|planter] NP[case=obl|obj, bare=yes, adj_twin=no]
  "A noun without a determiner as the object, in verb + noun phrases and with verbs that take a mass or generic noun (avoir faim, faire attention, prendre part, perdre patience, parler français, jouer aux cartes)."

rule vp.faire-partie: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] -> V[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, acc=no, etre=no, lemma=faire] Noun[lemma=partie, number=sg]
  "faire partie (de) = to be part of: partie is the noun here, though it is spelled like the participle of partir, which otherwise makes a bare noun need a determiner."

rule vp.bare-object-avoir-faire: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] -> V[intrans=no, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, acc=no, etre=no, lemma=avoir|faire] NP[case=obl|obj, bare=yes]
  "avoir and faire also take a bare noun that is an adjective too (avoir froid, avoir chaud, il fait chaud); after other verbs such a word is the adjective (se rendre heureux)."

rule vp.language-object: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] -> V[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, acc=no, etre=no, acc=no, lemma=parler|apprendre|étudier|enseigner|comprendre|écrire|lire|savoir|traduire|maîtriser] Nom
  "A language name without a determiner after parler, apprendre… (il parle français, j'apprends l'anglais is the same with the article). The noun may also be an adjective here (français)."

rule vp.infinitive: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, irefl=?p, irnum=?n] -> V[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, lemma=pouvoir|devoir|vouloir|savoir|aller|venir|manquer|aimer|préférer|adorer|détester|falloir|oser|sembler|paraître|désirer|espérer|compter|souhaiter|penser|croire|courir|monter|descendre|sortir|rentrer|partir|retourner|valoir|affirmer|prétendre|avouer|déclarer|nier|reconnaître|imaginer|savoir, acc=no] VP[form=inf, pnum=?pn, gender=?g, irefl=?p, irnum=?n]
  "A verb followed by an infinitive without a preposition: modal, motion, perception and causative verbs and a few others (je veux partir, il va pleuvoir, je l'entends chanter, fais-moi savoir). The subject controls the infinitive: an adjective after an infinitive linking verb agrees with it (elle veut être heureuse), and a reflexive pronoun on the infinitive is the subject's person and number (je veux me laver, not *je veux se laver)."

rule vp.infinitive-causative: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] -> V[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, lemma=voir|entendre|faire|laisser|regarder|écouter|sentir|envoyer, acc=no, dperson=?dp, dnum=?dn] VP[form=inf, irefl=?dp, irnum=?dn, pnum=?dn]
  "A perception or causative verb + infinitive with no direct object pronoun: the infinitive's agent is unsaid or an indirect pronoun, never the subject, so a reflexive on it follows that pronoun (je vois partir le train, elle me laisse me laver)."

rule vp.infinitive-object-control: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] -> V[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, lemma=voir|entendre|laisser|regarder|écouter|sentir|envoyer|empêcher, acc=yes, anum=?an, agen=?ag, aperson=?ap] VP[form=inf, pnum=?an, gender=?ag, irefl=?ap, irnum=?an]
  "With an object pronoun before a perception or causative verb, the infinitive describes that object: its predicate and a reflexive on it agree with the object (elle le laisse être heureux, elle me laisse me laver)."

rule vp.causative-object-control: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] -> V[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, lemma=faire, acc=yes, agreed=no, anum=?an, agen=?ag, aperson=?ap] VP[form=inf, pnum=?an, gender=?ag, irefl=?ap, irnum=?an]
  "faire with le, la, les + infinitive: a simple tense (elle les fait partir), or the invariable compound v.causative-perfect (elle les a fait partir); not an agreeing compound (*faits)."

rule vp.object-infinitive: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] -> V[intrans=no, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, lemma=voir|entendre|faire|laisser|regarder|écouter|sentir|envoyer, acc=no] NP[case=obl, number=?on, gender=?og] VP[form=inf, pnum=?on, gender=?og]
  "Perception and causative verbs: the object, then what it does (j'ai vu Tom partir)."

rule vp.preposition-infinitive: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, irefl=?p, irnum=?n] -> V[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, dperson=none, aperson=none] Prep[lemma=à|de] VP[form=inf, pnum=?pn, gender=?g, irefl=?p, irnum=?n]
  "A verb followed by à or de and an infinitive that its subject controls (il commence à pleuvoir, j'ai décidé de partir). A me or te object before the verb, or any direct object pronoun, is the infinitive's subject instead (vp.preposition-infinitive-object-control: elle me dit de me laver), except after promettre (vp.preposition-infinitive-promise)."

rule vp.preposition-infinitive-purpose: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, irefl=?p, irnum=?n] -> V[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] Prep[lemma=pour|par|sans] VP[form=inf, pnum=?pn, gender=?g, irefl=?p, irnum=?n]
  "pour, par, sans + an infinitive: its subject is the clause's subject even with an object pronoun (je suis venu pour me laver, je t'attends pour me laver)."

rule vp.preposition-infinitive-promise: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, irefl=?p, irnum=?n] -> V[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, lemma=promettre|jurer|parler|écrire|répondre|téléphoner|avouer|confier] Prep[lemma=de] VP[form=inf, pnum=?pn, gender=?g, irefl=?p, irnum=?n]
  "promettre and jurer, and verbs whose indirect object only receives the message (parler, écrire, répondre…), keep subject control with an indirect object (il me promet de se laver, elle me parle de partir)."

rule vp.preposition-infinitive-object-control: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] -> V[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, dperson=?dp, dnum=?dn, aperson=?ap, anum=?an, lemma=demander|dire|permettre|conseiller|ordonner|interdire|arriver|plaire|rester|convenir|appartenir|incomber|coûter|avertir|prévenir|contraindre|signifier|proposer|défendre|prier|empêcher|forcer|obliger|aider|inviter|encourager|apprendre|enseigner|persuader|convaincre|pousser|autoriser|charger|supplier|recommander|reprocher|remercier|féliciter|accuser|pardonner] Prep[lemma=à|de] VP[form=inf, irefl=?dp, irefl=?ap, irnum=?dn, irnum=?an, pnum=?dn, pnum=?an]
  "Verbs whose object controls the infinitive after à or de (il m'a demandé de me laver, je t'aide à porter), including impersonal verbs with an indirect object (il m'arrive de me tromper): the infinitive is checked against that object, not the subject."

rule vp.object-preposition-infinitive: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] -> V[intrans=no, etre=no, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, acc=no] NP[case=obl, inf_twin=no, number=?on, pnum=?opn, gender=?og] Prep[lemma=à|de] VP[form=inf, irefl=3, irnum=?on, pnum=?opn, gender=?og]
  "A verb, its object, then à or de and an infinitive (j'ai demandé à Tom de partir, il a aidé sa mère à cuisiner). The object is the infinitive's subject: a reflexive or predicate in it agrees with the object (elle force Tom à être heureux)."

rule vp.que-clause: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] -> V[cesubj=no, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] Conj[lemma=que] S[imp=no]
  "The verb introduces a clause with que (je pense que…, il faut que…)."

rule vp.object-que-clause: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] -> V[intrans=no, cesubj=no, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] NP[case=obl] Conj[lemma=que] S[imp=no]
  "A verb, an object and a que clause (dis à Tom que je viens)."

rule vp.indirect-question: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] -> V[cesubj=no, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] Wh S[imp=no, inv=no]
  "A question inside the sentence (dis-moi ce que tu veux, je ne sais pas quoi faire)."

rule vp.indirect-question-adverb: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] -> V[cesubj=no, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] QAdv S[imp=no, inv=no]
  "A question with où, quand, comment, pourquoi inside the sentence (je ne sais pas où il est)."

rule vp.indirect-question-stylistic: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] -> V[cesubj=no, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] QAdv VP[finite=yes, form=fin, subj=no, person=?sp, number=?sn, pnum=?spn, gender=?sg] NP[case=nom, partitive=no, person=?sp, number=?sn, pnum=?spn, gender=?sg]
  "An indirect question may put a noun subject after the verb, never a subject pronoun (je sais où est la gare, but not *où est-il). Not a partitive: comment cuire de la viande has an infinitive and an object, not a verb and its subject."

rule vp.indirect-question-si: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] -> V[cesubj=no, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] Conj[lemma=si] S[imp=no, inv=no]
  "si = whether (je me demande s'il viendra)."

rule vp.indirect-question-infinitive: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] -> V[cesubj=no, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] QAdv VP[form=inf]
  "A question word + infinitive (je ne sais pas où aller)."

rule vp.indirect-question-subject: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] -> V[cesubj=no, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] QPron[lemma=qui] VP[finite=yes, form=fin, subj=no, person=3, number=sg, pnum=sg]
  "qui as the subject of an indirect question (je sais qui vient)."

rule vp.indirect-question-phrase-subject: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] -> V[cesubj=no, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] WhP[number=?wn, gender=?wg] VP[finite=yes, form=fin, subj=no, person=3, number=?wn, pnum=?wn, gender=?wg]
  "A question phrase as the subject of an indirect question, agreeing with its verb (je sais quel train part)."

rule vp.copula: VP[state=?x, finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] -> Cop[mood=?m, person=?p, number=?n, subj=?s, marked=no, pnum=?pn, gender=?g] AP[cinf=no, pp=?x, participle_etre=no, number=?pn, gender=?g]
  "With être, devenir, sembler, rester, the adjective agrees with the subject (la maison est belle). A participle here is a state (la porte est fermée) only for verbs that take avoir; for an être verb it is a compound tense (elle est partie)."

rule vp.copula-marked: VP[finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] -> Cop[mood=?m, person=?p, number=?n, subj=?s, marked=yes, pnum=?pn, gender=?g] AP[cinf=no, pp=no, number=?pn, gender=?g]
  "After a été or fut, an adjective; a participle there is a passive (il a été malade, but il a été tué)."

rule vp.copula-noun: VP[finite=yes, form=fin, mood=?m, person=?p, number=?n, subj=?s, gender=?g] -> Cop[mood=?m, person=?p, number=?n, subj=?s, gender=?g] NP[case=obl, adj_twin=no]
  "être + a noun phrase says what the subject is (c'est un chat, il est médecin, c'est moi). A bare noun that is also an adjective is the adjective here (elle est heureuse, not the noun un heureux)."

rule vp.copula-phrase: VP[finite=yes, form=fin, mood=?m, person=?p, number=?n, subj=?s, gender=?g] -> Cop[mood=?m, person=?p, number=?n, subj=?s, gender=?g] PP
  "être + a phrase with a preposition (il est à la maison, c'est pour toi)."

rule vp.copula-alone: VP[finite=yes, form=fin, mood=?m, person=?p, number=?n, subj=?s, gender=?g, cesubj=?cs] -> Cop[mood=?m, person=?p, number=?n, subj=?s, gender=?g, cesubj=?cs]
  "être on its own (je pense, donc je suis; il est là — the adverb went to the linking verb)."

rule vp.copula-infinitive: VP[finite=yes, form=fin, mood=?m, person=?p, number=?n, pnum=?pn, gender=?g, subj=?s] -> Cop[mood=?m, person=?p, number=?n, subj=?s, pnum=?pn, gender=?g] AP[number=?pn, gender=?g] Prep[lemma=de|à] VP[form=inf, irefl=?p, irnum=?n, pnum=?pn, gender=?g]
  "être + an adjective + de or à + an infinitive whose subject is the clause's subject: a reflexive or a predicate in it agrees with that subject (je suis heureux de me laver, elle est fière d'être libre)."

rule vp.copula-infinitive-impersonal: VP[impers=yes, finite=yes, form=fin, mood=?m, person=3, number=sg, pnum=sg, gender=m, subj=?s] -> Cop[mood=?m, person=3, number=sg, subj=?s, pnum=sg, gender=m] AP[number=sg, gender=m] Prep[lemma=de|à] VP[form=inf]
  "Impersonal il or ce + a masculine singular adjective + de or à + an infinitive with no subject of its own: nothing in it agrees with il (il est difficile de se laver, il est important d'être heureuse, c'est facile à dire)."

rule vp.copula-noun-infinitive: VP[finite=yes, form=fin, mood=?m, person=?p, number=?n, subj=?s, gender=?g] -> Cop[mood=?m, person=?p, number=?n, subj=?s, gender=?g] NP[adj_twin=no] Prep[lemma=de|à] VP[form=inf]
  "être + noun + de + infinitive (c'est une honte de mentir)."

rule vp.copula-que: VP[finite=yes, form=fin, mood=?m, person=?p, number=?n, pnum=?pn, gender=?g, subj=?s] -> Cop[cesubj=no, mood=?m, person=?p, number=?n, subj=?s, pnum=?pn, gender=?g] AP[number=?pn, gender=?g] Conj[lemma=que] S[imp=no]
  "être + adjective + que + clause (il est clair que tu as raison)."

rule vp.passive-agent: VP[finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=no, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf, voice=passive] -> Verb[lemma=être, finite=yes, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Verb[form=pastpart, takes_avoir=yes, number=?pn, gender=?g] Prep[lemma=par] NP
  "être + participle + par + agent: the passive (il est aimé par tous)."

rule vp.passive-agent-negated: VP[finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=no, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf, voice=passive] -> Neg Verb[lemma=être, finite=yes, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Mod Verb[form=pastpart, takes_avoir=yes, number=?pn, gender=?g] Prep[lemma=par] NP
  "A negated passive with par + agent (il n'est pas aimé par ses voisins)."

rule vp.prepositional-phrase: VP[impers=?im, aperson=?oap, dperson=?odp, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, gap=?gp, irefl=?ir, irnum=?irn, state=?st] -> VP[impers=?im, aperson=?oap, dperson=?odp, gap=?gp, irefl=?ir, irnum=?irn, state=?st, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] PP[agent=no, pinf=yes|no, pnum=?pn, gender=?g, irefl=?p, irefl=?ir, irnum=?n, irnum=?irn]
  "A phrase with a preposition adds where, when, for whom or how. An infinitive in it (pour, sans, avant de…) has the clause's subject as its subject (je suis venu pour me laver)."

rule vp.prepositional-infinitive: VP[impers=?im, aperson=?oap, dperson=?odp, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, gap=?gp, irefl=?ir, irnum=?irn, state=?st] -> VP[impers=?im, aperson=?oap, dperson=?odp, aperson=none, dperson=none, gap=?gp, irefl=?ir, irnum=?irn, state=?st, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] PP[agent=no, pinf=da, pnum=?pn, gender=?g, irefl=?p, irefl=?ir, irnum=?n, irnum=?irn]
  "de or à + an infinitive after a verb phrase with no me/te or direct object pronoun: the clause's subject is its subject (cela ne sert à rien de le nier). With such a pronoun the pronoun is the subject, so only the object-control rules apply (elle me dit de me laver)."

rule vp.agent-phrase: VP[impers=?im, aperson=?oap, dperson=?odp, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, gap=?gp, irefl=?ir, irnum=?irn, state=?st] -> VP[impers=?im, aperson=?oap, dperson=?odp, gap=?gp, irefl=?ir, irnum=?irn, state=?st, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, state=no] PP[agent=yes]
  "par + a noun phrase after the verb. Not after être + participle read as a state: par + agent makes it a passive (la porte est fermée par le gardien)."

rule vp.adverb: VP[impers=?im, aperson=?oap, dperson=?odp, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, gap=?gp, irefl=?ir, irnum=?irn, state=?st] -> VP[impers=?im, aperson=?oap, dperson=?odp, gap=?gp, irefl=?ir, irnum=?irn, state=?st, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] Adv
  "An adverb after the verb phrase."

rule vp.time: VP[impers=?im, aperson=?oap, dperson=?odp, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, gap=?gp, irefl=?ir, irnum=?irn, state=?st] -> VP[impers=?im, aperson=?oap, dperson=?odp, gap=?gp, irefl=?ir, irnum=?irn, state=?st, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] TimeNP
  "A time expression after the verb (je travaille tous les jours)."

rule vp.ago: VP[impers=?im, aperson=?oap, dperson=?odp, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, gap=?gp, irefl=?ir, irnum=?irn, state=?st] -> VP[impers=?im, aperson=?oap, dperson=?odp, gap=?gp, irefl=?ir, irnum=?irn, state=?st, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] IlYa NP
  "il y a + a length of time = ago (je l'ai vu il y a deux ans)."

rule ilya.ago: IlYa -> Pron[lemma=il] Pron[lemma=y] Verb[lemma=avoir, person=3, number=sg]
  "il y a."

rule vp.floating-quantifier: VP[impers=?im, aperson=?oap, dperson=?odp, finite=?f, form=?fm, mood=?m, person=?p, number=pl, gender=?g, pnum=?pn, subj=?s, gap=?gp, irefl=?ir, irnum=?irn, state=?st] -> VP[impers=?im, aperson=?oap, dperson=?odp, gap=?gp, irefl=?ir, irnum=?irn, state=?st, finite=?f, form=?fm, mood=?m, person=?p, number=pl, gender=?g, pnum=?pn, subj=?s] Pron[lemma=tout, number=pl, gender=?g]
  "tous / toutes after the verb, for the whole plural subject (ils sont tous partis)."

rule vp.object-predicative: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] -> V[intrans=no, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, lemma=rendre|trouver|laisser|croire|considérer|juger|garder|tenir|voir|vouloir|avoir, acc=no] NP[case=obl, bare=no, number=?on, gender=?og] AP[number=?on, gender=?og]
  "Verb + object + an adjective saying what the object is or becomes (rendre les gens heureux, laisser la porte ouverte)."

rule vp.comparison: VP[impers=?im, aperson=?oap, dperson=?odp, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] -> VP[impers=?im, aperson=?oap, dperson=?odp, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] Conj[lemma=que] NP
  "plus, moins, autant … que + noun phrase (il court plus vite que moi)."

rule vp.aller-gerund: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] -> V[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, lemma=aller] Verb[form=ger|prespart]
  "aller + -ant: a steady change, in literary style (la dette va croissant)."

rule vp.naming-passive: VP[finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=no, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf, voice=passive] -> Verb[lemma=être, finite=yes, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Verb[lemma=appeler|nommer|surnommer|élire|considérer|déclarer|proclamer, form=pastpart, number=?pn, gender=?g] NP[case=obl, adj_twin=no]
  "être appelé / nommé / élu + a noun: what the subject is called or made, a passive (il était appelé le grain de la pauvreté)."

rule vp.un-peu: VP[impers=?im, aperson=?oap, dperson=?odp, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, gap=?gp, irefl=?ir, irnum=?irn, state=?st] -> VP[impers=?im, aperson=?oap, dperson=?odp, gap=?gp, irefl=?ir, irnum=?irn, state=?st, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] Det[lemma=un] Quant[lemma=peu]
  "un peu = a little (je parle un peu)."

rule vp.quantity: VP[impers=?im, aperson=?oap, dperson=?odp, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, gap=?gp, irefl=?ir, irnum=?irn, state=?st] -> VP[impers=?im, aperson=?oap, dperson=?odp, gap=?gp, irefl=?ir, irnum=?irn, state=?st, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] Quant
  "beaucoup, trop, assez after the verb (je t'aime beaucoup)."

# ------------------------------------------------- adjective phrases

rule ap.adjective: AP[pp=no, participle=?x, number=?n, gender=?g] -> Adj[participle=?x, number=?n, gender=?g]
  "An adjective."

rule ap.participle: AP[pp=yes, participle=?l, participle_etre=?e, number=?n, gender=?g] -> Verb[lemma=?l, form=pastpart, drifted=no, takes_etre=?e, number=?n, gender=?g]
  "A past participle used like an adjective; it is still the verb's participle (la porte fermée: fermer, past participle). Not for adjectives whose meaning drifted."

rule ap.adverb: AP[pp=?x, participle_etre=?e, number=?n, gender=?g, cinf=?ci, irefl=?ir, irnum=?irn] -> Adv AP[cinf=?ci, irefl=?ir, irnum=?irn, pp=?x, participle_etre=?e, number=?n, gender=?g]
  "An adverb before an adjective (très beau, plus grand, trop cher, si gentil)."

rule ap.toute: AP[pp=?x, participle_etre=?e, number=?n, gender=f, cinf=?ci, irefl=?ir, irnum=?irn] -> Predet[lemma=tout, gender=f, number=?n] AP[cinf=?ci, irefl=?ir, irnum=?irn, pp=?x, participle_etre=?e, number=?n, gender=f]
  "Adverbial tout agrees before a feminine adjective (toute petite, toutes seules); before anything else it is invariable tout (Adv)."

rule ap.complement: AP[pp=no, number=?n, gender=?g, cinf=?ci, irefl=?ir, irnum=?irn] -> AP[pp=no, participle=no, number=?n, gender=?g] PP[pinf=?ci, irefl=?ir, irnum=?irn, pnum=?n, gender=?g]
  "A phrase after an adjective (fier de toi, plein de gens, prêt pour le départ). After a participle the phrase makes it a participle phrase instead."

rule ap.infinitive: AP[pp=no, number=?n, gender=?g, cinf=yes, irefl=?ir, irnum=?irn] -> AP[pp=no, number=?n, gender=?g] Prep[lemma=de|à] VP[form=inf, irefl=?ir, irnum=?irn, pnum=?n, gender=?g]
  "An adjective + de or à + infinitive (content de te voir, prêt à partir)."

rule ap.tel-que: AP[pp=no, number=?n, gender=?g] -> Adj[lemma=tel, number=?n, gender=?g] Conj[lemma=que] S[imp=no]
  "tel que + a clause = such as, as (le langage tel que nous le connaissons): que is a conjunction here, so the clause keeps its own object pronoun."

rule ap.coordination: AP[pp=?x, number=?n, gender=?g, cinf=?ci, irefl=?ir, irnum=?irn] -> AP[cinf=?ci, irefl=?ir, irnum=?irn, pp=?x, number=?n, gender=?g] Conj[type=coord] AP[cinf=?ci, irefl=?ir, irnum=?irn, number=?n, gender=?g]
  "Two adjectives joined by et or ou."

rule ap.comparison: AP[pp=?x, number=?n, gender=?g, cinf=?ci, irefl=?ir, irnum=?irn] -> AP[cinf=?ci, irefl=?ir, irnum=?irn, pp=?x, number=?n, gender=?g] Conj[lemma=que] NP
  "plus, moins, aussi + adjective + que + noun phrase (plus grand que moi)."

rule ap.comparison-adverb: AP[pp=?x, number=?n, gender=?g, cinf=?ci, irefl=?ir, irnum=?irn] -> AP[cinf=?ci, irefl=?ir, irnum=?irn, pp=?x, number=?n, gender=?g] Conj[lemma=que] Adv
  "plus, moins + adjective + que + adverb (plus isolé que jamais, plus tard que prévu)."

rule ap.comparison-never: AP[pp=?x, number=?n, gender=?g, cinf=?ci, irefl=?ir, irnum=?irn] -> AP[cinf=?ci, irefl=?ir, irnum=?irn, pp=?x, number=?n, gender=?g] Conj[lemma=que] NegAdv[lemma=jamais]
  "… que jamais = than ever."

# ------------------------------------------------- participle phrases

rule partp.past: PartP[number=?n, gender=?g] -> Verb[form=pastpart, number=?n, gender=?g] Compl
  "A past participle with the verb's complements: passive or completed meaning, agreeing with the noun (écrite en anglais, construite par les Romains)."

rule partp.present: PartP -> Verb[form=prespart|ger] Compl
  "A present participle with the verb's complements: active meaning (un homme parlant trois langues)."

rule partp.present-object: PartP -> Verb[form=prespart|ger] NP[case=obl]
  "A present participle with its object (des élèves parlant français)."

rule compl.phrase: Compl -> PP
  "A complement of the participle."

rule compl.adverb: Compl -> Adv PP
  "An adverb and a complement."

rule compl.place: Compl -> Adv[lemma=là-bas|ici|là|dehors|partout|ensemble]
  "A place adverb as the participle's complement (ce garçon nageant là-bas)."

rule compl.more: Compl -> Compl PP
  "Another complement."

rule clause.participle-first: S[smood=?sm] -> PartP Punct S[smood=?sm]
  "A participle phrase at the start, then a comma (Arrivé à Paris, il appela sa mère)."

rule clause.gerund-first: S[smood=?sm] -> PP[gerund=yes, irefl=?sp, irnum=?sn, pnum=?spn, gender=?sg] Punct S[smood=?sm, sperson=?sp, snum=?sn, spnum=?spn, sgender=?sg]
  "A gérondif at the start, then a comma (En arrivant, il a vu…)."

# ------------------------------------------------- time expressions

rule time.det-noun: TimeNP[number=?n, gender=?g] -> Det[number=?n, gender=?g, next=?o] Noun[number=?n, gender=?g, onset=?o, lemma=jour|nuit|matin|soir|semaine|mois|an|année|heure|minute|seconde|fois|été|hiver|printemps|automne|lundi|mardi|mercredi|jeudi|vendredi|samedi|dimanche|week-end|après-midi|soirée|matinée|journée|instant|moment|siècle]
  "A time expression (ce matin, chaque jour, la semaine dernière, une fois)."

rule time.adjective-before: TimeNP[number=?n, gender=?g] -> Det[number=?n, gender=?g, next=?o] Adj[lemma=autre|même|dernier|prochain, number=?n, gender=?g, onset=?o] Noun[number=?n, gender=?g, lemma=jour|nuit|matin|soir|semaine|mois|an|année|fois]
  "A time noun with autre, même, dernier or prochain before it (l'autre jour, la même nuit, la dernière fois)."

rule time.all: TimeNP[number=?n, gender=?g] -> Predet[number=?n, gender=?g] TimeNP[number=?n, gender=?g]
  "tous les jours, toute la nuit."

rule time.adjective: TimeNP[number=?n, gender=?g] -> TimeNP[number=?n, gender=?g] AP[number=?n, gender=?g]
  "A time expression with an adjective (la semaine dernière, l'an prochain)."

rule time.adverb-noun: TimeNP -> Adv[lemma=hier|demain|aujourd'hui] Noun[lemma=matin|soir|après-midi]
  "hier soir, demain matin."

rule time.numeral: TimeNP[number=?n] -> Num[number=?n] Noun[number=?n, lemma=fois|heure|jour|an|minute|semaine|mois]
  "deux fois, trois heures."

# ------------------------------------------------- more shapes (from the Tatoeba no-parses)

rule vp.coordination: VP[impers=?im, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, gap=?gp, irefl=?ir, irnum=?irn] -> VP[impers=?im, gap=?gp, irefl=?ir, irnum=?irn, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] Conj[type=coord] VP[impers=?im, finite=?f, form=?fm, person=?p, number=?n, pnum=?pn, gender=?g, subj=no, gap=?gp, irefl=?ir, irnum=?irn, mood=?m]
  "Two verb phrases with one subject, joined by et, mais, ou, puis; a participle that agrees with nothing in either (gap) stays marked, so an object relative still checks it (il perdit patience et frappa le garçon); both agree with it, predicates too (elle est heureuse et fatiguée)."

rule vp.coordination-mixed-mood: VP[impers=?im, finite=?f, form=?fm, mood=ind, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, gap=?gp, irefl=?ir, irnum=?irn] -> VP[impers=?im, gap=?gp, irefl=?ir, irnum=?irn, finite=?f, form=?fm, mood=ind|cnd, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] Conj[type=coord] VP[impers=?im, finite=?f, form=?fm, person=?p, number=?n, pnum=?pn, gender=?g, subj=no, gap=?gp, irefl=?ir, irnum=?irn, mood=ind|cnd]
  "… or an indicative and a conditional (il viendra et il serait content: vient et serait)."

rule vp.coordination-negated: VP[impers=?im, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, gap=?gp, irefl=?ir, irnum=?irn] -> VP[impers=?im, gap=?gp, irefl=?ir, irnum=?irn, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] Conj[type=coord] Neg VP[impers=?im, finite=?f, form=?fm, person=?p, number=?n, pnum=?pn, gender=?g, subj=no, gap=?gp, irefl=?ir, irnum=?irn, mood=?m]
  "… mais ne + verb phrase (elle écrivit une lettre mais ne la posta pas)."

rule vp.coordination-negated-mixed-mood: VP[impers=?im, finite=?f, form=?fm, mood=ind, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, gap=?gp, irefl=?ir, irnum=?irn] -> VP[impers=?im, gap=?gp, irefl=?ir, irnum=?irn, finite=?f, form=?fm, mood=ind|cnd, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] Conj[type=coord] Neg VP[impers=?im, finite=?f, form=?fm, person=?p, number=?n, pnum=?pn, gender=?g, subj=no, gap=?gp, irefl=?ir, irnum=?irn, mood=ind|cnd]
  "… or an indicative and a conditional (il viendra et il serait content: vient et serait)."

rule clause.coordination-comma: S[imp=?i, smood=?sm] -> S[smood=?sm] Punct Conj[type=coord] S[imp=?i, smood=?sm]
  "A comma, then et, mais, car, donc and a clause."

rule clause.infinitive-subject: S[smood=?m] -> VP[form=inf] VP[finite=yes, form=fin, mood=ind|sub|cnd, mood=?m, subj=no, person=3, number=sg, pnum=sg, gender=m]
  "An infinitive as the subject (Fumer affectera votre santé, Voir c'est croire)."

rule clause.instruction: S[imp=yes] -> VP[form=inf]
  "An infinitive as an instruction, in recipes and notices (Plier la feuille en deux)."

rule clause.adjective-first-comma: S[imp=?i, inv=?iv, smood=?sm] -> AP[pp=no, number=?spn, gender=?sg] Punct S[imp=?i, inv=?iv, smood=?sm, spnum=?spn, sgender=?sg]
  "An adjective set before the clause describes its subject and agrees with it (Prêts, partez ! Fatiguée, elle s'est assise)."

rule clause.bien-sur-first: S[imp=?i, inv=?iv, smood=?sm] -> Adv[lemma=bien] Adj[lemma=sûr, number=sg, gender=m] Punct S[imp=?i, inv=?iv, smood=?sm]
  "bien sûr = of course, set before the clause (Bien sûr, je plaisante !)."

rule clause.dislocated-first: S[imp=?i, inv=?iv, smood=?sm] -> NP[case=obl, adj_twin=no] Punct S[imp=?i, inv=?iv, smood=?sm]
  "A stressed pronoun or a noun phrase first, picked up again in the clause (Toi, pourquoi as-tu attendu ? Moi, je reste)."

rule clause.dislocated-last: S[imp=?i, inv=?iv, smood=?sm] -> S[imp=?i, inv=?iv, smood=?sm] Punct NP
  "A noun phrase after a comma at the end, picked up again in the clause (Il est beau, ce chat)."

rule np.two-names: NP[person=3, number=sg, pnum=sg] -> ProperNoun ProperNoun
  "A name of two words (Giuseppe Verdi, Van Gogh)."

rule np.de-adjective: NP[person=3, number=sg, pnum=sg] -> Pron[lemma=quelqu'un|rien|personne|quoi|ceci|cela|ça] Prep[lemma=de] AP
  "rien, personne, quelqu'un + de + adjective (rien de nouveau, quelqu'un d'autre)."

rule np.quelque-chose-de: NP[person=3, number=sg, pnum=sg] -> Det[lemma=quelque] Noun[lemma=chose] Prep[lemma=de] AP[number=sg, gender=m]
  "quelque chose de + adjective (quelque chose de plus pressant)."

rule nom.place-adverb: Nom[needs_det=?d, inf_twin=?it, adj_twin=?at, number=?n, gender=?g, onset=?o] -> Nom[needs_det=?d, inf_twin=?it, adj_twin=?at, number=?n, gender=?g, onset=?o] Adv[lemma=là-bas|ici|là|là-haut|dehors]
  "A place adverb after the noun (ce chien là-bas)."

rule pp.en-tant-que: PP[agent=no] -> Prep[lemma=en] Quant[lemma=tant] Conj[lemma=que] NP
  "en tant que = as (en tant qu'officier public)."

rule clause.merci: S -> Intj[lemma=merci] Prep[lemma=de|pour] NP
  "merci de / pour + noun phrase (Merci pour le cadeau)."

rule clause.merci-infinitive: S -> Intj[lemma=merci] Prep[lemma=de|pour] VP[form=inf]
  "merci de / pour + infinitive (Merci de m'avoir aidé)."

rule vp.object-adverb-first: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] -> V[intrans=no, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, acc=no] Adv NP[case=obl]
  "An adverb between the verb and its object (j'aime beaucoup les opéras)."

rule vp.copula-nonfinite: VP[finite=no, form=?fm, subj=no, pnum=?pn, gender=?g, irefl=?ir, irnum=?irn] -> Verb[lemma=être|devenir|sembler|paraître|rester|demeurer, form=inf|prespart|ger, form=?fm] AP[irefl=?ir, irnum=?irn, participle_etre=no, number=?pn, gender=?g]
  "An infinitive or -ant linking verb + adjective (peut paraître étrange, étant malade)."

rule vp.copula-nonfinite-negated: VP[finite=no, form=inf, subj=no, pnum=?pn, gender=?g, irefl=?ir, irnum=?irn] -> Neg NegAdv[only=no] Verb[lemma=être|devenir|sembler|paraître|rester|demeurer, form=inf] AP[irefl=?ir, irnum=?irn, participle_etre=no, number=?pn, gender=?g]
  "ne pas before an infinitive linking verb + adjective (elle semble ne pas être heureuse)."

rule vp.copula-nonfinite-negated-noun: VP[finite=no, form=inf, subj=no] -> Neg NegAdv[only=no] Verb[lemma=être|devenir|rester, form=inf] NP[case=obl, adj_twin=no]
  "ne pas before an infinitive linking verb + noun phrase (pour ne pas être un fardeau)."

rule vp.copula-nonfinite-clitic: VP[finite=no, form=?fm, subj=no, pnum=?pn, gender=?g, irefl=?ir, irnum=?irn] -> Clitics[attached=no, reflexive=no, acc=no] Verb[lemma=être|devenir|sembler|paraître|rester|demeurer, form=inf|prespart|ger, form=?fm] AP[irefl=?ir, irnum=?irn, participle_etre=no, number=?pn, gender=?g]
  "An indirect pronoun before an infinitive linking verb + adjective (elle semble en être heureuse)."

rule vp.copula-past-infinitive: VP[finite=no, form=inf, subj=no, pnum=?pn, gender=?g, irefl=?ir, irnum=?irn, aux_mood=?auxm, aux_tense=?auxt, aux_person=?auxp, aux_number=?auxn, aux_form=?auxf] -> Verb[lemma=avoir, form=inf, mood=?auxm, tense=?auxt, person=?auxp, number=?auxn, form=?auxf] Verb[lemma=être, form=pastpart] AP[irefl=?ir, irnum=?irn, pp=no, number=?pn, gender=?g]
  "The past infinitive of être + adjective (elle semble avoir été heureuse). A participle there is a passive (v.passive-past-infinitive)."

rule vp.copula-past-infinitive-noun: VP[finite=no, form=inf, subj=no, aux_mood=?auxm, aux_tense=?auxt, aux_person=?auxp, aux_number=?auxn, aux_form=?auxf] -> Verb[lemma=avoir, form=inf, mood=?auxm, tense=?auxt, person=?auxp, number=?auxn, form=?auxf] Verb[lemma=être, form=pastpart] NP[case=obl, adj_twin=no]
  "The past infinitive of être + noun phrase (après avoir été médecin)."

rule vp.copula-nonfinite-noun: VP[finite=no, form=?fm, subj=no] -> Verb[lemma=être|devenir|rester, form=inf|prespart|ger, form=?fm] NP[case=obl, adj_twin=no]
  "An infinitive or -ant linking verb + noun phrase (devenir médecin, étant étudiant)."

rule vp.copula-nonfinite-adverb: VP[finite=no, form=?fm, subj=no, pnum=?pn, gender=?g, irefl=?ir, irnum=?irn] -> Verb[lemma=être|devenir|sembler|paraître|rester|demeurer, form=inf|prespart|ger, form=?fm] Adv AP[irefl=?ir, irnum=?irn, participle_etre=no, number=?pn, gender=?g]
  "… with an adverb after the linking verb (étant vraiment malade)."

rule vp.copula-nonfinite-adverb-noun: VP[finite=no, form=?fm, subj=no] -> Verb[lemma=être|devenir|rester, form=inf|prespart|ger, form=?fm] Adv NP[case=obl, adj_twin=no]
  "… with an adverb before the noun phrase (étant seulement étudiant)."

rule clause.participle-clause-first: S[imp=?i, inv=?iv, smood=?sm] -> VP[bare=no, form=prespart|ger, irefl=?sp, irnum=?sn, pnum=?spn, gender=?sg] Punct S[imp=?i, inv=?iv, smood=?sm, sperson=?sp, snum=?sn, spnum=?spn, sgender=?sg]
  "An -ant clause with complements first, then a comma (Étant étudiant, je… ; Ne sachant que faire, je…). Alone, the -ant form is an adjective."

rule clause.participle-clause-last: S[imp=?i, inv=?iv, smood=?sm] -> S[imp=?i, inv=?iv, smood=?sm, sperson=?sp, snum=?sn, spnum=?spn, sgender=?sg] Punct VP[bare=no, form=prespart|ger, irefl=?sp, irnum=?sn, pnum=?spn, gender=?sg]
  "An -ant clause after a comma, at the end (…, formant ainsi des nuages)."

rule np.article-name: NP[person=3, number=?n, gender=?g, pnum=?n] -> Det[definite=yes, number=?n, gender=?g] ProperNoun[gender=?g]
  "The article before a country, a region or a river (le Japon, la France, la Grande-Bretagne)."

rule np.one-alone: NP[case=obj, person=3, number=sg, pnum=sg, gender=?g] -> One[gender=?g]
  "un, une on its own, as a direct object, often with en (j'en ai un). Only there (case=obj), not after a preposition."

rule np.one-of: NP[person=3, number=sg, gender=?g, pnum=sg] -> One[gender=?g] PP
  "un, une + de + a plural (un des garçons, une de mes amies)."

rule np.the-one-of: NP[person=3, number=sg, gender=?g, pnum=sg] -> Det[lemma=le, number=sg] One[gender=?g] PP
  "l'un, l'une + de + a plural (l'une d'elles)."

rule clause.absolute: S[imp=?i, inv=?iv, smood=?sm] -> NP VP[form=prespart|ger] Punct S[imp=?i, inv=?iv, smood=?sm]
  "An absolute participle clause with its own subject, first (Les années passant, elle devenait plus belle)."

rule np.de-plural-adjective: NP[person=3, number=pl, gender=?g, pnum=pl] -> Prep[lemma=de] Adj[number=pl, gender=?g] Nom[number=pl, gender=?g]
  "de + adjective + plural noun, as a subject too (De nombreux artistes vivent à Paris)."

rule nom.name-after: Nom[needs_det=?d, inf_twin=?it, adj_twin=?at, number=?n, gender=?g, onset=?o] -> Nom[needs_det=?d, inf_twin=?it, adj_twin=?at, number=?n, gender=?g, onset=?o] ProperNoun
  "A name after a common noun (le lac Biwa, la rue Pasteur)."

rule v.floating-quantifier: V[intrans=?it, lemma=?l, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, acc=?a, neg=?ng, gap=?gp, irefl=?ir, irnum=?irn, needs_obj=?no, agreed=?agr, causative=?cz, etre=?e, anum=?an, agen=?ag, aperson=?ap, dperson=?dp, dnum=?dn] -> V[intrans=?it, gap=?gp, irefl=?ir, irnum=?irn, needs_obj=?no, agreed=?agr, causative=?cz, etre=?e, anum=?an, agen=?ag, aperson=?ap, dperson=?dp, dnum=?dn, lemma=?l, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, acc=?a, neg=?ng] Pron[lemma=tout, number=pl, number=?pn, gender=?g]
  "tous, toutes right after the verb (nous devrons tous mourir). tous agrees with the subject (ils sont partis tous, not *elle est venue tous)."

rule v.floating-quantifier-object: V[intrans=?it, lemma=?l, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, acc=?a, neg=?ng, gap=?gp, irefl=?ir, irnum=?irn, needs_obj=?no, agreed=?agr, causative=?cz, etre=?e, anum=?an, agen=?ag, aperson=?ap, dperson=?dp, dnum=?dn] -> V[intrans=?it, acc=yes, gap=?gp, irefl=?ir, irnum=?irn, needs_obj=?no, agreed=?agr, causative=?cz, etre=?e, anum=?an, agen=?ag, aperson=?ap, dperson=?dp, dnum=?dn, lemma=?l, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, acc=?a, neg=?ng] Pron[lemma=tout, number=pl, number=?an, gender=?ag]
  "tous after the verb referring to a direct object pronoun agrees with it (je les ai vus tous)."

rule vp.clitic-predicative: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] -> V[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, lemma=rendre|trouver|laisser|croire|considérer|juger|garder|tenir|voir|vouloir|imaginer|préférer|aimer, acc=yes, anum=?an, agen=?ag] AP[number=?an, gender=?ag]
  "A verb with le, la, les as its object and an adjective saying what the object is, agreeing with it (je la trouvai plongée dans un livre, tu ne peux pas le garder secret)."

rule vp.reflexive-predicative: VP[finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=no] -> Clitics[attached=no, reflexive=yes, acc=no, refl=?p, rnum=?n] Verb[lemma=rendre|trouver|laisser|croire|considérer|juger|garder|tenir|voir|vouloir|imaginer|préférer|aimer|sentir|montrer|déclarer|dire|savoir, etre=no, form=fin, mood=ind|sub|cnd, mood=?m, person=?p, number=?n] AP[number=?pn, gender=?g]
  "A reflexive object and an adjective saying what the subject sees, makes or finds itself; the adjective agrees with the subject (je me vois fatigué, elle se rend heureuse)."

rule vp.reflexive-predicative-negated: VP[finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=no] -> Neg Clitics[attached=no, reflexive=yes, acc=no, refl=?p, rnum=?n] Verb[lemma=rendre|trouver|laisser|croire|considérer|juger|garder|tenir|voir|vouloir|imaginer|préférer|aimer|sentir|montrer|déclarer|dire|savoir, etre=no, form=fin, mood=ind|sub|cnd, mood=?m, person=?p, number=?n] NegAdv[only=no] AP[number=?pn, gender=?g]
  "The same with ne … pas (elle ne se rend pas heureuse, je ne me vois pas fatigué)."

rule vp.reflexive-predicative-perfect: VP[finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=no, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> Clitics[attached=no, reflexive=yes, acc=no, refl=?p, rnum=?n] Verb[lemma=être, finite=yes, mood=ind|sub|cnd, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Verb[lemma=rendre|trouver|laisser|croire|considérer|juger|garder|tenir|voir|vouloir|imaginer|préférer|aimer|sentir|montrer|déclarer|dire|savoir, form=pastpart, number=?pn, gender=?g] AP[number=?pn, gender=?g]
  "The same in a compound tense: the participle and the adjective both agree with the subject (je me suis rendu heureux, elle s'est trouvée seule)."

rule vp.reflexive-predicative-perfect-negated: VP[finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=no, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> Neg Clitics[attached=no, reflexive=yes, acc=no, refl=?p, rnum=?n] Verb[lemma=être, finite=yes, mood=ind|sub|cnd, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] NegAdv[only=no] Verb[lemma=rendre|trouver|laisser|croire|considérer|juger|garder|tenir|voir|vouloir|imaginer|préférer|aimer|sentir|montrer|déclarer|dire|savoir, form=pastpart, number=?pn, gender=?g] AP[number=?pn, gender=?g]
  "The same with ne … pas (elle ne s'est pas rendue heureuse)."

rule vp.reflexive-predicative-nonfinite: VP[finite=no, form=inf, subj=no, pnum=?pn, gender=?g, irefl=?ir, irnum=?irn] -> Clitics[attached=no, reflexive=yes, acc=no, refl=?ir, rnum=?irn] Verb[lemma=rendre|trouver|laisser|croire|considérer|juger|garder|tenir|voir|vouloir|imaginer|préférer|aimer|sentir|montrer|déclarer|dire|savoir, form=inf] AP[number=?pn, gender=?g]
  "The same in an infinitive: the adjective and the reflexive pronoun agree with whoever controls the infinitive (elle veut se rendre heureuse)."

rule vp.reflexive-predicative-imperative: VP[finite=yes, form=fin, mood=imp, person=?p, number=?n, subj=no] -> Verb[lemma=rendre|trouver|laisser|croire|considérer|juger|garder|tenir|voir|vouloir|imaginer|préférer|aimer|sentir|montrer|déclarer|dire|savoir, form=fin, mood=imp, person=?p, number=?n, number=sg] EnCl[refl=?p, rnum=?n, acc=no] AP[number=sg]
  "An order with a reflexive pronoun and an adjective (rends-toi heureux, rendez-vous utiles)."

rule vp.reflexive-predicative-imperative-nous: VP[finite=yes, form=fin, mood=imp, person=?p, number=?n, subj=no] -> Verb[lemma=rendre|trouver|laisser|croire|considérer|juger|garder|tenir|voir|vouloir|imaginer|préférer|aimer|sentir|montrer|déclarer|dire|savoir, form=fin, mood=imp, person=?p, number=?n, person=1, number=pl] EnCl[refl=?p, rnum=?n, acc=no] AP[number=pl]
  "The same with nous: a plural adjective (rendons-nous utiles)."

rule vp.reflexive-predicative-imperative-vous: VP[finite=yes, form=fin, mood=imp, person=?p, number=?n, subj=no] -> Verb[lemma=rendre|trouver|laisser|croire|considérer|juger|garder|tenir|voir|vouloir|imaginer|préférer|aimer|sentir|montrer|déclarer|dire|savoir, form=fin, mood=imp, person=?p, number=?n, person=2, number=pl] EnCl[refl=?p, rnum=?n, acc=no] AP
  "The same with vous, which may address one person: the adjective is singular or plural (rendez-vous utile, rendez-vous utiles)."

rule vp.supposed: VP[finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] -> Cop[mood=?m, person=?p, number=?n, subj=?s, gender=?g] AP[participle=supposer|censer, number=?pn, gender=?g] VP[form=inf, pnum=?pn, gender=?g, irefl=?p, irnum=?n]
  "être supposé / censé + infinitive = be supposed to (il était supposé venir)."

rule vp.indirect-question-pronoun-infinitive: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] -> V[cesubj=no, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] QPron VP[form=inf]
  "quoi or qui + infinitive inside the sentence (je ne sais pas quoi dire)."

rule rel.ou-inverted: Rel -> RelPron[role=place] VP[finite=yes, form=fin, subj=no, person=?p, number=?n, pnum=?pn, gender=?g] NP[case=nom, person=?p, number=?n, pnum=?pn, gender=?g]
  "où + verb + noun subject (le pays où coule le lait)."

rule rel.object-inverted: Rel -> RelPron[role=object] VP[gap=no, finite=yes, form=fin, subj=no, person=?p, number=?n, pnum=?pn, gender=?g] NP[case=nom, person=?p, number=?n, pnum=?pn, gender=?g]
  "que + verb + noun subject (le livre que lit mon père)."

rule rel.object-agreement-inverted: Rel[number=?n, gender=?g, aux_mood=?auxm, aux_tense=?auxt, aux_person=?auxp, aux_number=?sn, aux_form=?auxf] -> RelPron[role=object] Verb[lemma=avoir, finite=yes, person=3, number=?sn, mood=?auxm, tense=?auxt, person=?auxp, form=?auxf] Verb[form=pastpart, takes_avoir=yes, number=?n, gender=?g] NP[case=nom, person=3, number=?sn]
  "que + avoir + a participle + the noun subject after it: the participle agrees with que, the antecedent (les pommes qu'a mangées Pierre)."

rule clause.incise-noun: S[smood=?sm] -> S[smood=?sm] Punct VP[finite=yes, form=fin, subj=no, person=3, number=?n, pnum=?pn, gender=?g] NP[case=nom, person=3, number=?n, pnum=?pn, gender=?g]
  "A reporting verb after the quotation, with a noun subject after it (…, dit Tom)."

rule clause.interjection-alone: S -> Intj
  "An interjection on its own (Bonjour ! Merci.)."

rule clause.adverb-pair-first: S[imp=?i, inv=?iv, smood=?sm] -> Adv Conj[type=coord] Adv S[imp=?i, inv=?iv, smood=?sm]
  "Two adverbs joined first (Tôt ou tard, nous saurons)."

rule ap.more-and-more: AP[pp=?x, number=?n, gender=?g, cinf=?ci, irefl=?ir, irnum=?irn] -> Prep[lemma=de] Adv[lemma=plus|moins] Prep[lemma=en] Adv[lemma=plus|moins] AP[cinf=?ci, irefl=?ir, irnum=?irn, pp=?x, number=?n, gender=?g]
  "de plus en plus, de moins en moins + adjective."

rule pp.coordination: PP[agent=no, irefl=?ir, irnum=?irn, pnum=?pn, gender=?g] -> PP[irefl=?ir, irnum=?irn, pnum=?pn, gender=?g] Conj[type=coord] PP[irefl=?ir, irnum=?irn, pnum=?pn, gender=?g]
  "Two phrases with a preposition joined by et, ou (à votre tante et à votre oncle)."

rule clause.phrase-last-comma: S[imp=?i, inv=?iv, smood=?sm] -> S[imp=?i, inv=?iv, smood=?sm, sperson=?sp, snum=?sn, spnum=?spn, sgender=?sg] Punct PP[irefl=?sp, irnum=?sn, pnum=?spn, gender=?sg]
  "A phrase with a preposition after a comma, at the end (Elle est partie, après le dîner)."

rule clause.adverb-phrase-last-comma: S[imp=?i, inv=?iv, smood=?sm] -> S[imp=?i, inv=?iv, smood=?sm] Punct Adv PP
  "An adverb and a phrase after a comma, at the end (…, même après sa mort)."

rule clause.subordinate-comma: S[imp=?i, inv=?iv, smood=?sm] -> S[imp=?i, inv=?iv, smood=?sm, cesubj=no] Punct Sub S[imp=no]
  "A comma, then a clause with si, quand, parce que… (Ferme la porte, s'il te plaît)."

rule ap.superlative: AP[pp=?x, number=?n, gender=?g, cinf=?ci, irefl=?ir, irnum=?irn] -> Det[definite=yes, lemma=le, number=?n, gender=?g] Adv[lemma=plus|moins] AP[cinf=?ci, irefl=?ir, irnum=?irn, pp=?x, number=?n, gender=?g]
  "The superlative after the noun: le plus, la moins + adjective (le chemin le plus court)."

rule time.date: TimeNP -> Det[lemma=le] Num Noun[lemma=janvier|février|mars|avril|mai|juin|juillet|août|septembre|octobre|novembre|décembre]
  "A date: le 28 juillet."

rule time.date-year: TimeNP -> Det[lemma=le] Num Noun[lemma=janvier|février|mars|avril|mai|juin|juillet|août|septembre|octobre|novembre|décembre] Num
  "A date with the year: le 28 juillet 1888."

rule pp.number: PP[agent=no] -> Prep Num
  "A preposition before a number, usually a year (en 1860, depuis 2010)."

rule clause.adverb-pair-first-comma: S[imp=?i, inv=?iv, smood=?sm] -> Adv Conj[type=coord] Adv Punct S[imp=?i, inv=?iv, smood=?sm]
  "Two adverbs joined first, then a comma (Tôt ou tard, nous le ferons)."

rule vp.phrase-object: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s] -> V[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, acc=no, etre=no] ShortPP NP[case=obl, bare=no]
  "A short phrase between the verb and its object (mettre en évidence quelques fautes)."

rule shortpp.bare: ShortPP -> Prep[lemma=en|à|de|par] Noun
  "A preposition and a bare noun, as in fixed verb phrases (en évidence, à jour, de côté)."

rule mod.tout-a-fait: Mod[neg=no] -> Adv[lemma=tout] Prep[lemma=à] Noun[lemma=fait]
  "tout à fait between the auxiliary and the participle (j'ai tout à fait compris)."

rule mod.pas-tout-a-fait: Mod[neg=yes] -> NegAdv Adv[lemma=tout] Prep[lemma=à] Noun[lemma=fait]
  "pas tout à fait (je n'ai pas tout à fait compris)."
