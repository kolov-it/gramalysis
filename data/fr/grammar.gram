# French grammar: simple and complex clauses, written on the Italian model.
#
# Feature names: person 1/2/3, number sg/pl, gender m/f, case nom/obl/acc/dat/
# refl/gen/loc, finite yes/no, form fin/inf/ger/prespart/pastpart, mood
# ind/sub/cnd/imp. A feature a word does not have is unknown and matches
# anything, so selections use dedicated categories (QPron, RelPron, Neg,
# NegAdv, Quant, Dem, SubLead) and `form=fin` on conjugated forms.
#
# `etre=yes` marks être (the lattice sets it): être takes no direct object and
# no object pronoun outside a compound tense, so `vp.object` and
# `v.proclitic` ask for `etre=no`; c'est un chat is `vp.copula-noun`.
#
# `state=yes` marks être + a participle read as a state (vp.copula), and the
# modifier-only VP rules carry it (vp.adverb, vp.time, …); a PP
# with `agent=yes` (par + a noun phrase, `pp.basic`) cannot follow it, since
# par + agent makes the participle a passive. The lattice gives every other
# preposition `agent=no`.
#
# `gap=yes` marks an avoir compound tense whose participle has no direct
# object before it (default agreement: j'ai mangé). Modifiers carry it up to
# the clause (vp.adverb, vp.prepositional-phrase, ne … pas), complements do
# not (les choses que j'ai dû faire: que is faire's object). rel.object
# refuses it, so a relative que before avoir + participle goes through
# rel.object-agreement, which checks the participle against the antecedent.
#
# A coordinated noun phrase is feminine when every conjunct is, masculine as
# soon as one is (np.coordination and its -masculine variants, lists, ni … ni),
# and keeps its conjuncts' case (il et elle is a subject, not an object).
#
# `pnum` is the number of a participle or adjective agreeing with the subject
# (elle est partie, ils sont fatigués). It is kept apart from the verb's own
# number because polite vous takes a plural verb and a singular predicate
# (vous êtes fatigué): every noun phrase has pnum = its number, except vous
# and on, which leave it open (the lattice sets a subject pronoun's pnum).
# An inverted subject pronoun passes its pnum and gender to Cop.
#
# Verb features carried upward: subj=yes when the verb has its own subject
# pronoun after it (inversion: parlez-vous), acc=yes when an object clitic
# already is its direct object (je le vois), neg=yes once ne or pas is there.
#
# Auxiliaries: takes_avoir / takes_etre come from the lexicon
# (grammar.auxiliaries). The Word Holder API does not give them for French
# yet, so both are unknown and every rule that selects on them accepts the
# verb: être + participle then reads both as a compound tense and as a state.

start Sentence

rule sentence.statement: Sentence -> S[inv=no, smood=ind|cnd]
  "A statement or an order. A clause whose verb is in the subjunctive needs que or a conjunction before it (smood=sub cannot stand alone)."

rule sentence.question: Sentence -> S[imp=no, smood=ind|cnd] Question
  "A question: a clause with a question mark (inversion, est-ce que, or just the intonation)."

# ---------------------------------------------------------------- clauses

rule clause.subject: S[saperson=?sap, gap=?gp, smood=?m, sperson=?p, snum=?n, spnum=?pn, sgender=?g] -> NP[case=nom, person=?p, number=?n, pnum=?pn, gender=?g] VP[impers=no, aperson=?sap, finite=yes, form=fin, mood=ind|sub|cnd, mood=?m, subj=no, person=?p, number=?n, pnum=?pn, gender=?g, gap=?gp]
  "The verb agrees with its subject in person and number, and an adjective or participle after être agrees with it too (pnum). French always says the subject, except in an order. Polite vous has no number: the verb is plural, the adjective singular (vous êtes fatigué)."

rule clause.impersonal-subject: S[gap=?gp, smood=?m, sperson=3, snum=sg, spnum=sg, sgender=m] -> Pron[case=nom, lemma=il|ce|ça|cela, gender=m, attached=no] VP[impers=yes, finite=yes, form=fin, mood=ind|sub|cnd, mood=?m, subj=no, person=3, number=sg, pnum=sg, gender=m, gap=?gp]
  "An impersonal il, ce, ça or cela before an impersonal construction (il est difficile de se laver, c'est facile à dire); only these subjects can take vp.copula-infinitive-impersonal, so a personal subject keeps its agreement checks (*Tom est heureux d'être heureuses)."

rule clause.inverted: S[inv=yes, gap=?gp, cesubj=?cs, smood=?m] -> VP[finite=yes, form=fin, subj=yes, gap=?gp, cesubj=?cs, mood=?m]
  "Inversion: the subject pronoun follows the verb, joined by a hyphen (Parlez-vous français ? A-t-il fini ?)."

rule clause.complex-inversion: S[inv=yes, gap=?gp, smood=?m] -> NP[person=3, number=?n, gender=?g] VP[impers=no, finite=yes, form=fin, subj=yes, person=3, number=?n, gender=?g, gap=?gp, mood=?m]
  "A noun subject, then the verb with il/elle after it, which agrees with it in number and gender (Pierre est-il là ? La femme est-elle heureuse ?)."

rule clause.imperative: S[imp=yes] -> VP[finite=yes, mood=imp, subj=no]
  "An order: the imperative has no subject (Ferme la porte, Suis-moi)."

rule clause.coordination: S[imp=?i, smood=?sm] -> S[smood=?sm] Conj[type=coord] S[imp=?i, smood=?sm]
  "Two clauses joined by et, ou, mais, car, donc."

rule clause.comma: S[imp=?i, smood=?sm] -> S[smood=?sm] Punct S[imp=?i, smood=?sm]
  "Two clauses separated by a comma."

rule clause.coordination-ind-cnd: S[imp=no, smood=ind] -> S[imp=no, smood=ind] Conj[type=coord] S[imp=no, smood=cnd]
  "Clauses with their own subjects need not share a mood: an indicative and a conditional can be joined (il est heureux et elle serait heureuse). The pair can stand alone, so it counts as indicative; a subjunctive clause still cannot join without que."

rule clause.coordination-cnd-ind: S[imp=no, smood=ind] -> S[imp=no, smood=cnd] Conj[type=coord] S[imp=no, smood=ind]
  "The same the other way round (elle serait heureuse mais il est triste)."

rule clause.comma-ind-cnd: S[imp=no, smood=ind] -> S[imp=no, smood=ind] Punct S[imp=no, smood=cnd]
  "An indicative and a conditional clause separated by a comma."

rule clause.comma-cnd-ind: S[imp=no, smood=ind] -> S[imp=no, smood=cnd] Punct S[imp=no, smood=ind]
  "A conditional and an indicative clause separated by a comma (je viendrais, mais je suis malade)."

rule clause.after-question: S[smood=?sm] -> S[smood=ind|cnd] Question S[smood=?sm]
  "A question, then another sentence."

rule clause.subordinate: S[inv=?iv, smood=?sm] -> S[inv=?iv, smood=?sm, cesubj=no] Sub S[imp=no]
  "A clause joined by quand, si, parce que, bien que… A bare est-ce is never the main clause here: est-ce que is the question marker (question.est-ce-que), so its clause keeps its own mood check."

rule clause.subordinate-first: S[imp=?i, inv=?iv, smood=?sm] -> Sub S[imp=no] Punct S[imp=?i, inv=?iv, smood=?sm]
  "A clause with quand, si, comme… first, then a comma (S'il pleut, je reste)."

rule clause.concessive-first: S[imp=?i, inv=?iv, smood=?sm] -> QPron[lemma=quoi|qui] Conj[lemma=que] S[smood=sub, imp=no] Punct S[imp=?i, inv=?iv, smood=?sm]
  "où que, quoi que, qui que + a subjunctive clause, then the main clause: wherever, whatever, whoever (Où que tu ailles, je te suivrai. Quoi qu'il en soit, j'ai fini)."

rule clause.concessive-where-first: S[imp=?i, inv=?iv, smood=?sm] -> QAdv[lemma=où] Conj[lemma=que] S[smood=sub, imp=no] Punct S[imp=?i, inv=?iv, smood=?sm]
  "où que + a subjunctive clause, then the main clause (Où que tu ailles, je te suivrai)."

rule clause.inverted-hypothesis: S[imp=?i, inv=?iv, smood=?sm] -> S[inv=yes, smood=sub, gap=no] Punct S[imp=?i, inv=?iv, smood=?sm]
  "An inverted subjunctive, then a comma and the main clause, as a literary condition: eût-il su, il serait venu = had he known; fût-il riche, … = even if he were rich."

rule clause.subordinate-first-no-comma: S[imp=?i, inv=?iv, smood=?sm] -> Sub S[imp=no] S[imp=?i, inv=?iv, smood=?sm]
  "A clause with quand or si first, without a comma."

rule clause.adverb-first: S[imp=?i, inv=?iv, smood=?sm] -> Adv S[imp=?i, inv=?iv, smood=?sm]
  "An adverb at the start of the clause (Hier, Peut-être, Maintenant)."

rule clause.adverb-inversion: S[inv=no, smood=?sm] -> Adv[lemma=peut-être|ainsi|aussi|encore] S[inv=yes, imp=no, smood=?sm]
  "After peut-être, ainsi, aussi or encore at the start, a statement may invert its subject (Peut-être nous verrons-nous ce soir). Other adverbs keep a question a question (Hier est-il heureux ?)."

rule clause.a-peine: S[inv=no, smood=?sm] -> Prep[lemma=à] Noun[lemma=peine] S[inv=yes, imp=no, smood=?sm]
  "à peine at the start inverts a statement (À peine l'eut-il dit qu'il le regretta)."

rule clause.peut-etre-que: S[inv=no, smood=?sm] -> Adv[lemma=peut-être] Conj[lemma=que] S[inv=no, imp=no, smood=?sm]
  "peut-être que + a clause = perhaps (Peut-être que ce sera la même chose)."

rule clause.adverb-first-comma: S[imp=?i, inv=?iv, smood=?sm] -> Adv Punct S[imp=?i, inv=?iv, smood=?sm]
  "An adverb at the start, then a comma."

rule clause.phrase-first: S[imp=?i, inv=?iv, smood=?sm] -> PP[irefl=?sp, irnum=?sn, pnum=?spn, gender=?sg] S[imp=?i, inv=?iv, smood=?sm, sperson=?sp, snum=?sn, spnum=?spn, sgender=?sg]
  "A phrase with a preposition at the start of the clause (Après le dîner, nous sortons)."

rule clause.phrase-first-comma: S[imp=?i, inv=?iv, smood=?sm] -> PP[irefl=?sp, irnum=?sn, pnum=?spn, gender=?sg] Punct S[imp=?i, inv=?iv, smood=?sm, sperson=?sp, snum=?sn, spnum=?spn, sgender=?sg]
  "A phrase with a preposition at the start, then a comma."

rule clause.time-first: S[imp=?i, inv=?iv, smood=?sm] -> TimeNP S[imp=?i, inv=?iv, smood=?sm]
  "A time expression at the start (Ce matin, il pleut)."

rule clause.time-first-comma: S[imp=?i, inv=?iv, smood=?sm] -> TimeNP Punct S[imp=?i, inv=?iv, smood=?sm]
  "A time expression at the start, then a comma."

rule clause.vocative-first: S[imp=?i, inv=?iv, smood=?sm] -> ProperNoun Punct S[imp=?i, inv=?iv, smood=?sm]
  "Addressing someone first (Tom, viens ici)."

rule clause.vocative-last: S[imp=?i, inv=?iv, smood=?sm] -> S[imp=?i, inv=?iv, smood=?sm] Punct ProperNoun
  "Addressing someone at the end (Viens ici, Tom)."

rule clause.interjection: S[imp=?i, inv=?iv, smood=?sm] -> Intj Punct S[imp=?i, inv=?iv, smood=?sm]
  "oui, non, merci, eh bien, then a comma (Oui, je sais)."

rule clause.interjection-bare: S[imp=?i, inv=?iv, smood=?sm] -> Intj S[imp=?i, inv=?iv, smood=?sm]
  "An interjection before the clause (Oh, Voici…)."

rule clause.incise: S[smood=?sm] -> S[smood=?sm] Punct VP[subj=yes]
  "A reporting verb after the quotation, with inversion (…, dit-il)."

rule clause.tag: S[smood=?sm] -> S[smood=?sm] Punct Neg Verb[lemma=être, person=3, number=sg] Pron[attached=yes, lemma=ce] NegAdv[only=no]
  "n'est-ce pas ? at the end asks for agreement."

rule clause.voici: S -> Intj[lemma=voici|voilà] NP
  "voici / voilà + a noun phrase (Voilà mon frère)."

rule clause.voici-clitic: S -> Clitics[attached=no] Intj[lemma=voici|voilà]
  "A pronoun before voici / voilà (Me voici, Le voilà)."

# ------------------------------------------------------- subordinators

rule sub.conjunction: Sub -> Conj[type=sub]
  "quand, si, lorsque, puisque, comme, que."

rule sub.que: Sub -> SubLead Conj[lemma=que]
  "A conjunction ending in que (parce que, bien que, pendant que, avant que, alors que, pour que)."

rule sub.jusqua-ce-que: Sub -> SubLead[lemma=jusque] Prep[lemma=à] Pron[lemma=ce] Conj[lemma=que]
  "jusqu'à ce que = until."

rule sub.de-sorte: Sub -> Prep[lemma=de] Noun[lemma=sorte|façon|manière] Conj[lemma=que]
  "de sorte que, de façon que = so that."

# ---------------------------------------------------------- questions

rule question.est-ce-que: S[inv=yes, smood=?sm, cesubj=?cs, gap=?gp] -> QMark S[smood=?sm, cesubj=?cs, imp=no, inv=no, gap=?gp]
  "est-ce que before a clause makes it a question (Est-ce que tu viens ?)."

rule qmark.est-ce-que: QMark -> Verb[lemma=être, mood=ind, tense=pres, person=3, number=sg] Pron[attached=yes, lemma=ce] Conj[lemma=que]
  "est-ce que: the question marker."

rule question.wh-adverb: S[inv=yes, smood=?sm, cesubj=?cs] -> QAdv S[smood=?sm, cesubj=?cs, imp=no]
  "où, quand, comment, pourquoi, combien open a question (Où vas-tu ? Comment tu t'appelles ?)."

rule question.wh-adverb-est-ce-que: S[inv=yes, smood=?sm, cesubj=?cs] -> QAdv QMark S[smood=?sm, cesubj=?cs, imp=no, inv=no]
  "A question word + est-ce que (Où est-ce que tu vas ?)."

rule question.wh-stylistic: S[inv=yes] -> QAdv VP[finite=yes, form=fin, mood=ind|cnd, subj=no, person=?p, number=?n, pnum=?pn, gender=?g] NP[case=nom, person=?p, number=?n, pnum=?pn, gender=?g]
  "After a question word the noun subject can follow the verb (Où est la gare ? Comment s'appelle ton frère ?)."

rule question.wh-subject: S[inv=yes] -> QPron[lemma=qui] VP[finite=yes, form=fin, mood=ind|cnd, subj=no, person=3, number=sg, pnum=sg]
  "qui as the subject (Qui est là ?)."

rule question.qui-predicate: S[inv=yes] -> QPron[lemma=qui] Cop[mood=ind|cnd, subj=no, person=3, number=?n] NP[case=nom, person=3, number=?n]
  "qui + être + the noun phrase it asks about; être agrees with that noun phrase (Qui sont ces hommes ?)."

rule question.wh-object: S[inv=yes, smood=?sm, cesubj=?cs] -> QPron S[smood=?sm, cesubj=?cs, imp=no, gap=no]
  "que, qui or quoi opens the question as its object (Que fais-tu ? Qui as-tu vu ?)."

rule question.qu-est-ce-que: S[inv=yes, smood=?sm, cesubj=?cs] -> QPron QMark S[smood=?sm, cesubj=?cs, imp=no, inv=no]
  "qu'est-ce que = what (Qu'est-ce que tu fais ?)."

rule question.qu-est-ce-qui: S[inv=yes] -> QPron Verb[lemma=être, mood=ind, tense=pres, person=3, number=sg] Pron[attached=yes, lemma=ce] RelPron[role=subject] VP[finite=yes, form=fin, subj=no, person=3, number=sg, pnum=sg, mood=ind|cnd]
  "qu'est-ce qui = what, as the subject (Qu'est-ce qui se passe ?)."

rule question.wh-phrase: S[inv=yes, smood=?sm, cesubj=?cs] -> WhP S[smood=?sm, cesubj=?cs, imp=no, gap=no]
  "A question phrase opens the question (Quel livre lis-tu ? Combien de temps faut-il ?). Before avoir + a participle that agrees with nothing it is the participle's object: question.wh-object-agreement."

rule question.wh-object-agreement: S[inv=yes, smood=?qm, aux_mood=?qm, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> WhP[number=?on, gender=?og] Verb[lemma=avoir, finite=yes, mood=ind|cnd|sub, mood=?qm, person=?p, number=?n, tense=?auxt, form=?auxf] Pron[attached=yes, case=nom, person=?p, number=?n] Verb[form=pastpart, takes_avoir=yes, number=?on, gender=?og]
  "A question phrase as the object of an inverted compound tense: the participle agrees with it (Quelles lettres as-tu écrites ?)."

rule question.wh-pronoun-object-agreement: S[inv=yes, smood=?qm, aux_mood=?qm, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> QPron[number=?on, gender=?og] Verb[lemma=avoir, finite=yes, mood=ind|cnd|sub, mood=?qm, person=?p, number=?n, tense=?auxt, form=?auxf] Pron[attached=yes, case=nom, person=?p, number=?n] Verb[form=pastpart, takes_avoir=yes, number=?on, gender=?og]
  "A question pronoun (que, qui, lequel…) as the object of an inverted compound tense: the participle agrees with it (Qu'as-tu fait ? Lesquelles as-tu écrites ?)."

rule question.wh-object-agreement-adverb: S[inv=yes, smood=?qm, aux_mood=?qm, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> WhP[number=?on, gender=?og] Verb[lemma=avoir, finite=yes, mood=ind|cnd|sub, mood=?qm, person=?p, number=?n, tense=?auxt, form=?auxf] Pron[attached=yes, case=nom, person=?p, number=?n] Mod Verb[form=pastpart, takes_avoir=yes, number=?on, gender=?og]
  "The same with an adverb (Quels livres as-tu déjà lus ?)."

rule question.wh-pronoun-object-agreement-adverb: S[inv=yes, smood=?qm, aux_mood=?qm, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> QPron[number=?on, gender=?og] Verb[lemma=avoir, finite=yes, mood=ind|cnd|sub, mood=?qm, person=?p, number=?n, tense=?auxt, form=?auxf] Pron[attached=yes, case=nom, person=?p, number=?n] Mod Verb[form=pastpart, takes_avoir=yes, number=?on, gender=?og]
  "A question pronoun (que, qui, lequel…) as the object of an inverted compound tense: the participle agrees with it (Qu'as-tu fait ? Lesquelles as-tu écrites ?)."

rule question.wh-object-agreement-negated: S[inv=yes, smood=?qm, aux_mood=?qm, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> WhP[number=?on, gender=?og] Neg Verb[lemma=avoir, finite=yes, mood=ind|cnd|sub, mood=?qm, person=?p, number=?n, tense=?auxt, form=?auxf] Pron[attached=yes, case=nom, person=?p, number=?n] Mod Verb[form=pastpart, takes_avoir=yes, number=?on, gender=?og]
  "The same with ne … pas (Quelles lettres n'as-tu pas écrites ?)."

rule question.wh-pronoun-object-agreement-negated: S[inv=yes, smood=?qm, aux_mood=?qm, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> QPron[number=?on, gender=?og] Neg Verb[lemma=avoir, finite=yes, mood=ind|cnd|sub, mood=?qm, person=?p, number=?n, tense=?auxt, form=?auxf] Pron[attached=yes, case=nom, person=?p, number=?n] Mod Verb[form=pastpart, takes_avoir=yes, number=?on, gender=?og]
  "A question pronoun (que, qui, lequel…) as the object of an inverted compound tense: the participle agrees with it (Qu'as-tu fait ? Lesquelles as-tu écrites ?)."

rule question.wh-object-agreement-more: S[inv=yes, smood=?qm, aux_mood=?qm, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> WhP[number=?on, gender=?og] Verb[lemma=avoir, finite=yes, mood=ind|cnd|sub, mood=?qm, person=?p, number=?n, tense=?auxt, form=?auxf] Pron[attached=yes, case=nom, person=?p, number=?n] Verb[form=pastpart, takes_avoir=yes, number=?on, gender=?og] Tail
  "The same, then more (Quelles lettres as-tu écrites hier ?)."

rule question.wh-object-agreement-est-ce-que: S[inv=yes, smood=?qm, aux_mood=?qm, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> WhP[number=?on, gender=?og] QMark NP[case=nom, person=?p, number=?n] Verb[lemma=avoir, finite=yes, mood=ind|cnd|sub, mood=?qm, person=?p, number=?n, tense=?auxt, form=?auxf] Verb[form=pastpart, takes_avoir=yes, number=?on, gender=?og]
  "A question phrase as the object, then est-ce que and the ordinary subject-first compound tense: the participle agrees with the question phrase (Quelles lettres est-ce que tu as écrites ?)."

rule question.wh-object-agreement-est-ce-que-adverb: S[inv=yes, smood=?qm, aux_mood=?qm, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> WhP[number=?on, gender=?og] QMark NP[case=nom, person=?p, number=?n] Neg Verb[lemma=avoir, finite=yes, mood=ind|cnd|sub, mood=?qm, person=?p, number=?n, tense=?auxt, form=?auxf] Mod Verb[form=pastpart, takes_avoir=yes, number=?on, gender=?og]
  "The same with ne … pas (Quelles lettres est-ce que tu n'as pas écrites ?)."

rule question.wh-object-agreement-est-ce-que-mod: S[inv=yes, smood=?qm, aux_mood=?qm, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> WhP[number=?on, gender=?og] QMark NP[case=nom, person=?p, number=?n] Verb[lemma=avoir, finite=yes, mood=ind|cnd|sub, mood=?qm, person=?p, number=?n, tense=?auxt, form=?auxf] Mod Verb[form=pastpart, takes_avoir=yes, number=?on, gender=?og]
  "The same with an adverb (Quels livres est-ce que tu as déjà lus ?)."

rule question.wh-pronoun-object-agreement-est-ce-que: S[inv=yes, smood=?qm, aux_mood=?qm, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> QPron[number=?on, gender=?og] QMark NP[case=nom, person=?p, number=?n] Verb[lemma=avoir, finite=yes, mood=ind|cnd|sub, mood=?qm, person=?p, number=?n, tense=?auxt, form=?auxf] Verb[form=pastpart, takes_avoir=yes, number=?on, gender=?og]
  "A question pronoun as the object, then est-ce que and a subject-first compound tense (Lesquelles est-ce que tu as écrites ?)."

rule question.wh-object-agreement-complex: S[inv=yes, smood=?qm, aux_mood=?qm, aux_tense=?auxt, aux_person=?auxp, aux_number=?n, aux_form=?auxf] -> WhP[number=?on, gender=?og] NP[person=3, number=?n, gender=?g] Verb[lemma=avoir, finite=yes, mood=ind|cnd|sub, mood=?qm, person=3, number=?n, tense=?auxt, person=?auxp, form=?auxf] Pron[attached=yes, case=nom, person=3, number=?n, gender=?g] Verb[form=pastpart, takes_avoir=yes, number=?on, gender=?og]
  "A question phrase as the object, a noun subject and inverted avoir: the participle agrees with the question phrase, the pronoun with the noun (Quelles lettres la femme a-t-elle écrites ?)."

rule question.wh-object-agreement-indirect: S[inv=yes, smood=?qm, aux_mood=?qm, aux_tense=?auxt, aux_person=?r, aux_number=?n, aux_form=?auxf] -> WhP[number=?on, gender=?og] Clitics[attached=no, reflexive=no, acc=no, refl=?r, obj=?o, rnum=?n] Verb[lemma=avoir, finite=yes, mood=ind|cnd|sub, mood=?qm, person=?p, number=?n, person=?r, person!=?o, tense=?auxt, form=?auxf] Pron[attached=yes, case=nom, person=?p, number=?n] Verb[form=pastpart, takes_avoir=yes, number=?on, gender=?og]
  "A question phrase as the object, an indirect pronoun before inverted avoir: the participle agrees with the question phrase (Quelles lettres lui as-tu écrites ?)."

rule question.wh-object-agreement-indirect-adverb: S[inv=yes, smood=?qm, aux_mood=?qm, aux_tense=?auxt, aux_person=?r, aux_number=?n, aux_form=?auxf] -> WhP[number=?on, gender=?og] Clitics[attached=no, reflexive=no, acc=no, refl=?r, obj=?o, rnum=?n] Verb[lemma=avoir, finite=yes, mood=ind|cnd|sub, mood=?qm, person=?p, number=?n, person=?r, person!=?o, tense=?auxt, form=?auxf] Pron[attached=yes, case=nom, person=?p, number=?n] Mod Verb[form=pastpart, takes_avoir=yes, number=?on, gender=?og]
  "The same with an adverb (Quelles lettres lui as-tu déjà écrites ?)."

rule question.wh-object-agreement-indirect-negated: S[inv=yes, smood=?qm, aux_mood=?qm, aux_tense=?auxt, aux_person=?r, aux_number=?n, aux_form=?auxf] -> WhP[number=?on, gender=?og] Neg Clitics[attached=no, reflexive=no, acc=no, refl=?r, obj=?o, rnum=?n] Verb[lemma=avoir, finite=yes, mood=ind|cnd|sub, mood=?qm, person=?p, number=?n, person=?r, person!=?o, tense=?auxt, form=?auxf] Pron[attached=yes, case=nom, person=?p, number=?n] Mod Verb[form=pastpart, takes_avoir=yes, number=?on, gender=?og]
  "The same with ne … pas (Quelles lettres ne lui as-tu pas écrites ?)."

rule question.wh-pronoun-object-agreement-more: S[inv=yes, smood=?qm, aux_mood=?qm, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> QPron[number=?on, gender=?og] Verb[lemma=avoir, finite=yes, mood=ind|cnd|sub, mood=?qm, person=?p, number=?n, tense=?auxt, form=?auxf] Pron[attached=yes, case=nom, person=?p, number=?n] Verb[form=pastpart, takes_avoir=yes, number=?on, gender=?og] Tail
  "A question pronoun (que, qui, lequel…) as the object of an inverted compound tense: the participle agrees with it (Qu'as-tu fait ? Lesquelles as-tu écrites ?)."

rule question.wh-phrase-subject: S[inv=yes] -> WhP[number=?n, gender=?g] VP[finite=yes, form=fin, mood=ind|cnd, subj=no, person=3, number=?n, pnum=?n, gender=?g]
  "A question phrase as the subject; the verb agrees with it (Quel train part à midi ? Quels trains partent ?)."

rule question.preposition: S[inv=yes, smood=?sm, cesubj=?cs] -> Prep Wh S[smood=?sm, cesubj=?cs, imp=no]
  "A preposition + question word opens the question (À quoi penses-tu ? Avec qui parles-tu ?)."

rule question.quel-predicate: S[inv=yes] -> QDet[number=?n, gender=?g] Cop[mood=ind|cnd, subj=no, person=3, number=?n] NP[person=3, number=?n, gender=?g]
  "quel + être + noun phrase (Quel est ton nom ?)."

rule question.quel-inverted: S[inv=yes] -> QDet VP[subj=yes, mood=ind|cnd]
  "quel + inverted être (Quelle heure est-il ?)."

rule question.final-wh: S[smood=?sm] -> S[imp=no, smood=?sm] QAdv
  "A question word at the end, in speech (Tu vas où ?)."

rule wh.pronoun: Wh -> QPron
  "A question pronoun."

rule wh.phrase: Wh -> WhP
  "A question phrase."

rule whp.determiner: WhP[number=?n, gender=?g] -> QDet[number=?n, gender=?g] Nom[number=?n, gender=?g]
  "quel + noun (quel livre, quelle heure)."

rule whp.combien: WhP[number=?n, gender=?g] -> QQuant Prep[lemma=de] Nom[number=?n, gender=?g]
  "combien de + noun (combien de temps)."

rule whp.lequel: WhP[number=?n, gender=?g] -> QPron[lemma=lequel, number=?n, gender=?g]
  "lequel, laquelle = which one."

# ------------------------------------------------------- noun phrases

rule np.name: NP[person=3, number=sg, gender=?g, pnum=sg] -> ProperNoun[gender=?g]
  "A name is a third-person singular noun phrase."

rule np.subject-pronoun: NP[case=nom, person=?p, number=?n, gender=?g, pnum=?pn] -> Pron[case=nom, attached=no, person=?p, number=?n, gender=?g, pnum=?pn]
  "A subject pronoun (je, tu, il, on, ce)."

rule np.l-on: NP[case=nom, person=3, number=sg] -> Det[lemma=le, next=v] Pron[lemma=on, case=nom]
  "l'on, the written form of on after et, si, que, où (que l'on sorte)."

rule np.pronoun: NP[case=obl, person=?p, number=?n, gender=?g, pnum=?n] -> Pron[case=obl, attached=no, person=?p, number=?n, gender=?g]
  "A stressed pronoun after a preposition or a verb (avec moi, c'est lui)."

rule np.article: NP[person=3, number=?n, gender=?g, pnum=?n] -> Det[number=?n, gender=?g, next=?o] Nom[number=?n, gender=?g, onset=?o]
  "The determiner agrees with its noun in gender and number, and its form follows the next word's first sound: le/la before a consonant or an aspirated h (le héros), l' before a vowel or a mute h (l'homme); ce/cet, mon amie."

rule np.quoi-que-ce-soit: NP[person=3, number=sg, gender=m, pnum=sg] -> QPron[lemma=quoi] Conj[lemma=que] Pron[lemma=ce] Verb[lemma=être, mood=sub, person=3, number=sg]
  "quoi que ce soit = anything at all, a fixed pronoun phrase (il ne dit quoi que ce soit)."

rule np.partitive: NP[person=3, number=?n, gender=?g, pnum=?n, partitive=yes] -> Prep[lemma=de] Det[definite=yes, lemma=le, number=?n, gender=?g, next=?o] Nom[number=?n, gender=?g, onset=?o]
  "de la, de l' before a noun: the partitive article, 'some' (de la confiture, de l'eau)."

rule np.de-bare: NP[case=obl, person=3, number=?n, gender=?g, pnum=?n] -> Prep[lemma=de] Nom[number=?n, gender=?g]
  "de + noun after a negation or before an adjective (pas de pain, de grands arbres)."

rule np.quantity: NP[person=3, number=?n, gender=?g, pnum=?n] -> Quant Prep[lemma=de] Nom[number=?n, gender=?g]
  "A quantity + de + noun (beaucoup de gens, trop de travail, peu de temps)."

rule np.quantity-np: NP[person=3, number=?n, gender=?g, pnum=?n] -> Quant Prep[lemma=de] NP[number=?n, gender=?g]
  "A quantity + de + a noun phrase (beaucoup de mes amis)."

rule np.un-peu: NP[person=3, number=?n, gender=?g, pnum=?n] -> Det[lemma=un] Quant[lemma=peu] Prep[lemma=de] Nom[number=?n, gender=?g]
  "un peu de + noun (un peu de sucre)."

rule np.numeral: NP[person=3, number=?n, gender=?g, pnum=?n] -> Num[number=?n] Nom[number=?n, gender=?g]
  "A number before a plural noun (deux chats)."

rule np.numeral-alone: NP[case=obl, person=3, number=?n, pnum=?n] -> Num[number=?n]
  "A number on its own (j'en ai deux)."

rule nom.numeral: Nom[number=?n, gender=?g, onset=?o] -> Num[number=?n, onset=?o] Nom[number=?n, gender=?g]
  "A number between the determiner and the noun (les deux enfants)."

rule nom.noun: Nom[needs_det=?d, inf_twin=?it, adj_twin=?at, number=?n, gender=?g, onset=?o] -> Noun[needs_det=?d, inf_twin=?it, adj_twin=?at, number=?n, gender=?g, onset=?o]
  "A noun."

rule nom.adjective-after: Nom[needs_det=?d, inf_twin=?it, adj_twin=?at, after_participle=?x, number=?n, gender=?g, onset=?o] -> Nom[needs_det=?d, inf_twin=?it, adj_twin=?at, number=?n, gender=?g, onset=?o] AP[participle=?x, number=?n, gender=?g]
  "An adjective after its noun agrees with it in gender and number."

rule nom.adjective-before: Nom[number=?n, gender=?g, onset=?o] -> Adj[number=?n, gender=?g, onset=?o] Nom[number=?n, gender=?g]
  "An adjective before its noun agrees with it (un grand arbre, une belle maison)."

rule nom.adverb-adjective-before: Nom[number=?n, gender=?g, onset=?o] -> Adv[onset=?o] Adj[number=?n, gender=?g] Nom[number=?n, gender=?g]
  "An adverb and an adjective before the noun (un très grand homme); the determiner follows the adverb's first sound."

rule nom.prepositional-phrase: Nom[needs_det=?d, inf_twin=?it, adj_twin=?at, number=?n, gender=?g, onset=?o] -> Nom[needs_det=?d, inf_twin=?it, adj_twin=?at, after_participle=no, number=?n, gender=?g, onset=?o] PP
  "A phrase with a preposition describes the noun (la maison de Tom, le livre sur la table)."

rule nom.participle-phrase: Nom[needs_det=?d, inf_twin=?it, adj_twin=?at, number=?n, gender=?g, onset=?o] -> Nom[needs_det=?d, inf_twin=?it, adj_twin=?at, number=?n, gender=?g, onset=?o] PartP[number=?n, gender=?g]
  "A participle with the verb's complements after the noun shortens a relative clause (une lettre écrite en anglais)."

rule nom.infinitive: Nom[needs_det=?d, inf_twin=?it, adj_twin=?at, number=?n, gender=?g, onset=?o] -> Nom[needs_det=?d, inf_twin=?it, adj_twin=?at, number=?n, gender=?g, onset=?o] Prep[lemma=à|de] VP[form=inf]
  "A noun + à or de + infinitive (une machine à laver, le temps de partir)."

rule np.predeterminer: NP[person=3, number=?n, gender=?g, pnum=?n] -> Predet[number=?n, gender=?g] NP[number=?n, gender=?g]
  "tout before the determiner agrees with the noun (tout le monde, tous les jours, toutes mes amies)."

rule np.demonstrative-relative: NP[person=3, number=?n, gender=?g, pnum=?n] -> Dem[number=?n, gender=?g] Rel[person=3, number=?n, pnum=?n, gender=?g]
  "celui, celle, ce + a relative clause (celui qui parle, ce que tu dis)."

rule np.demonstrative-phrase: NP[person=3, number=?n, gender=?g, pnum=?n] -> Dem[lemma=celui, number=?n, gender=?g] PP
  "celui, celle + de (celle de Tom)."

rule np.demonstrative-alone: NP[person=3, number=?n, gender=?g, pnum=?n] -> Dem[lemma=celui, number=?n, gender=?g] DemSuffix
  "celui-ci, celle-là = this one, that one."

rule nom.demonstrative-suffix: Nom[needs_det=?d, inf_twin=?it, adj_twin=?at, number=?n, gender=?g, onset=?o] -> Nom[needs_det=?d, inf_twin=?it, adj_twin=?at, number=?n, gender=?g, onset=?o] DemSuffix
  "-ci or -là after the noun points nearer or further (ce jour-là, cette fois-ci)."

rule np.relative: NP[person=?p, number=?n, gender=?g, case=?c, pnum=?pn] -> NP[person=?p, number=?n, gender=?g, case=?c, pnum=?pn] Rel[person=?p, number=?n, pnum=?pn, gender=?g]
  "A relative clause describes the noun phrase (l'homme qui parle, le livre que je lis)."

rule np.bare: NP[case=obl, bare=yes, adj_twin=?at, inf_twin=?it, person=3, number=?n, gender=?g, pnum=?n] -> Nom[needs_det=no, adj_twin=?at, inf_twin=?it, number=?n, gender=?g]
  "A noun without a determiner, as an object, after être or a preposition (avoir faim, il est médecin, en France); not as a subject."

rule np.coordination: NP[number=pl, pnum=pl, person=3, gender=f, case=?c] -> NP[person=3, gender=f, case=?c] Conj[type=coord] NP[person=3, gender=f, case=?c]
  "Two noun phrases joined by et, ou: third person when both are (Tom et Marie, le chat et le chien)."

rule np.coordination-masculine: NP[number=pl, pnum=pl, person=3, gender=m, case=?c] -> NP[person=3, gender=m, case=?c] Conj[type=coord] NP[person=3, case=?c]
  "… masculine as soon as one conjunct is masculine (le chat et la souris sont blancs)."

rule np.coordination-masculine-second: NP[number=pl, pnum=pl, person=3, gender=m, case=?c] -> NP[person=3, case=?c] Conj[type=coord] NP[person=3, gender=m, case=?c]
  "… or the second one."

rule np.coordination-first: NP[number=pl, pnum=pl, person=1, gender=f, case=?c] -> NP[person=1, gender=f, case=?c] Conj[type=coord] NP[gender=f, case=?c]
  "With a first-person conjunct the whole is first person (moi et Tom, nous et vous)."

rule np.coordination-first-masculine: NP[number=pl, pnum=pl, person=1, gender=m, case=?c] -> NP[person=1, gender=m, case=?c] Conj[type=coord] NP[case=?c]
  "… masculine as soon as one conjunct is masculine (le chat et la souris sont blancs)."

rule np.coordination-first-masculine-second: NP[number=pl, pnum=pl, person=1, gender=m, case=?c] -> NP[person=1, case=?c] Conj[type=coord] NP[gender=m, case=?c]
  "… or the second one."

rule np.coordination-first-second: NP[number=pl, pnum=pl, person=1, gender=f, case=?c] -> NP[person=2|3, gender=f, case=?c] Conj[type=coord] NP[person=1, gender=f, case=?c]
  "… or with the first person second (Tom et moi)."

rule np.coordination-first-second-masculine: NP[number=pl, pnum=pl, person=1, gender=m, case=?c] -> NP[person=2|3, gender=m, case=?c] Conj[type=coord] NP[person=1, case=?c]
  "… masculine as soon as one conjunct is masculine (le chat et la souris sont blancs)."

rule np.coordination-first-second-masculine-second: NP[number=pl, pnum=pl, person=1, gender=m, case=?c] -> NP[person=2|3, case=?c] Conj[type=coord] NP[person=1, gender=m, case=?c]
  "… or the second one."

rule np.coordination-second: NP[number=pl, pnum=pl, person=2, gender=f, case=?c] -> NP[person=2, gender=f, case=?c] Conj[type=coord] NP[person=2|3, gender=f, case=?c]
  "With a second-person conjunct and no first, second person (toi et Tom)."

rule np.coordination-second-masculine: NP[number=pl, pnum=pl, person=2, gender=m, case=?c] -> NP[person=2, gender=m, case=?c] Conj[type=coord] NP[person=2|3, case=?c]
  "… masculine as soon as one conjunct is masculine (le chat et la souris sont blancs)."

rule np.coordination-second-masculine-second: NP[number=pl, pnum=pl, person=2, gender=m, case=?c] -> NP[person=2, case=?c] Conj[type=coord] NP[person=2|3, gender=m, case=?c]
  "… or the second one."

rule np.coordination-second-second: NP[number=pl, pnum=pl, person=2, gender=f, case=?c] -> NP[person=3, gender=f, case=?c] Conj[type=coord] NP[person=2, gender=f, case=?c]
  "… or with the second person second (Tom et toi)."

rule np.coordination-second-second-masculine: NP[number=pl, pnum=pl, person=2, gender=m, case=?c] -> NP[person=3, gender=m, case=?c] Conj[type=coord] NP[person=2, case=?c]
  "… masculine as soon as one conjunct is masculine (le chat et la souris sont blancs)."

rule np.coordination-second-second-masculine-second: NP[number=pl, pnum=pl, person=2, gender=m, case=?c] -> NP[person=3, case=?c] Conj[type=coord] NP[person=2, gender=m, case=?c]
  "… or the second one."

rule np.list: NP[number=pl, pnum=pl, person=3, gender=f, case=?c] -> NP[person=3, gender=f, case=?c] Punct NPList[gender=f, case=?c]
  "A list of third-person noun phrases separated by commas, the last joined by et or ou (du pain, du vin et du fromage)."

rule np.list-masculine: NP[number=pl, pnum=pl, person=3, gender=m, case=?c] -> NP[person=3, gender=m, case=?c] Punct NPList[case=?c]
  "… masculine as soon as one conjunct is masculine (le chat et la souris sont blancs)."

rule np.list-masculine-second: NP[number=pl, pnum=pl, person=3, gender=m, case=?c] -> NP[person=3, case=?c] Punct NPList[gender=m, case=?c]
  "… or the second one."

rule nplist.last: NPList[gender=f, case=?c] -> NP[person=3, gender=f, case=?c] Conj[type=coord] NP[person=3, gender=f, case=?c]
  "The end of a list: … et …"

rule nplist.last-masculine: NPList[gender=m, case=?c] -> NP[person=3, gender=m, case=?c] Conj[type=coord] NP[person=3, case=?c]
  "… masculine as soon as one conjunct is masculine (le chat et la souris sont blancs)."

rule nplist.last-masculine-second: NPList[gender=m, case=?c] -> NP[person=3, case=?c] Conj[type=coord] NP[person=3, gender=m, case=?c]
  "… or the second one."

rule nplist.more: NPList[gender=f, case=?c] -> NP[person=3, gender=f, case=?c] Punct NPList[gender=f, case=?c]
  "A list item followed by a comma."

rule nplist.more-masculine: NPList[gender=m, case=?c] -> NP[person=3, gender=m, case=?c] Punct NPList[case=?c]
  "… masculine as soon as one conjunct is masculine (le chat et la souris sont blancs)."

rule nplist.more-masculine-second: NPList[gender=m, case=?c] -> NP[person=3, case=?c] Punct NPList[gender=m, case=?c]
  "… or the second one."

rule np.ni-ni: NP[number=pl, pnum=pl, person=3, gender=f, case=?c] -> Conj[lemma=ni] NP[person=3, gender=f, case=?c] Conj[lemma=ni] NP[person=3, gender=f, case=?c]
  "ni … ni = neither … nor, with third-person noun phrases."

rule np.ni-ni-masculine: NP[number=pl, pnum=pl, person=3, gender=m, case=?c] -> Conj[lemma=ni] NP[person=3, gender=m, case=?c] Conj[lemma=ni] NP[person=3, case=?c]
  "… masculine as soon as one conjunct is masculine (le chat et la souris sont blancs)."

rule np.ni-ni-masculine-second: NP[number=pl, pnum=pl, person=3, gender=m, case=?c] -> Conj[lemma=ni] NP[person=3, case=?c] Conj[lemma=ni] NP[person=3, gender=m, case=?c]
  "… or the second one."

# --------------------------------------------------- relative clauses

rule rel.subject: Rel[person=?p, number=?n, pnum=?pn, gender=?g] -> RelPron[role=subject] VP[impers=no, finite=yes, form=fin, mood=ind|sub|cnd, subj=no, person=?p, number=?n, pnum=?pn, gender=?g]
  "qui + verb: the noun is that verb's subject; the verb agrees with it, and so does an adjective or participle after être (l'homme qui parle, c'est moi qui suis, la femme qui est fatiguée)."

rule rel.object: Rel -> RelPron[role=object] S[imp=no, gap=no, saperson=none]
  "que + clause: the noun is that clause's object (le livre que je lis). Not with avoir + a participle that agrees with nothing (gap=yes): there que is the participle's object and rel.object-agreement checks it (les pommes que j'ai mangées, not *mangé). A clause whose verb already has a direct object pronoun has no place for que (*les lettres que je les ai lues)."

rule rel.object-agreement: Rel[number=?n, gender=?g] -> RelPron[role=object] NP[case=nom, person=?p, number=?sn] VAgr[person=?p, number=?sn, onum=?n, ogen=?g]
  "que + avoir + participle: the participle agrees with que, the object before it (les pommes que j'ai mangées)."

rule rel.object-agreement-more: Rel[number=?n, gender=?g] -> RelPron[role=object] NP[case=nom, person=?p, number=?sn] VAgr[person=?p, number=?sn, onum=?n, ogen=?g] Tail
  "que + avoir + an agreeing participle, then more (les lettres qu'il a écrites hier)."

rule rel.object-agreement-infinitive: Rel[number=?n, gender=?g, aux_mood=?auxm, aux_tense=?auxt, aux_person=?p, aux_number=?sn, aux_form=?auxf] -> RelPron[role=object] NP[case=nom, person=?p, number=?sn] Verb[lemma=avoir, finite=yes, person=?p, number=?sn, mood=?auxm, tense=?auxt, form=?auxf] Verb[form=pastpart, takes_avoir=yes, lemma=voir|entendre|regarder|écouter|sentir|apercevoir, number=?n, gender=?g] VP[form=inf]
  "The antecedent as the agent of a perception verb's infinitive: the participle agrees with it (les filles que j'ai vues partir). Not after faire, whose participle stays invariable, nor laisser (invariable since the 1990 spelling reform). When the antecedent is the infinitive's object the participle stays invariable (la chanson que j'ai entendu chanter), so that reading remains through rel.object."

rule rel.object-agreement-reflexive: Rel[number=?n, gender=?g, aux_mood=?auxm, aux_tense=?auxt, aux_person=?p, aux_number=?sn, aux_form=?auxf] -> RelPron[role=object] NP[case=nom, person=?p, number=?sn] Clitics[attached=no, reflexive=yes, acc=no, refl=?p, rnum=?sn] Verb[lemma=être, finite=yes, person=?p, number=?sn, mood=?auxm, tense=?auxt, form=?auxf] Verb[form=pastpart, number=?n, gender=?g]
  "que as the direct object of a pronominal compound: the reflexive is then indirect and the participle agrees with que (les lettres que je me suis écrites). The subject-agreeing reflexive compounds are gap=yes, so rel.object cannot take them."

rule vagr.perfect: VAgr[person=?p, number=?n, onum=?on, ogen=?og, aux_mood=?auxm, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> Verb[lemma=avoir, finite=yes, person=?p, number=?n, mood=?auxm, tense=?auxt, form=?auxf] Verb[form=pastpart, takes_avoir=yes, number=?on, gender=?og]
  "avoir + a participle agreeing with the object before it."

rule vagr.perfect-adverb: VAgr[person=?p, number=?n, onum=?on, ogen=?og, aux_mood=?auxm, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> Verb[lemma=avoir, finite=yes, person=?p, number=?n, mood=?auxm, tense=?auxt, form=?auxf] Mod Verb[form=pastpart, takes_avoir=yes, number=?on, gender=?og]
  "avoir + adverb + agreeing participle (que j'ai toujours aimées)."

rule vagr.negated: VAgr[person=?p, number=?n, onum=?on, ogen=?og, aux_mood=?auxm, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> Neg Verb[lemma=avoir, finite=yes, person=?p, number=?n, mood=?auxm, tense=?auxt, form=?auxf] Mod Verb[form=pastpart, takes_avoir=yes, number=?on, gender=?og]
  "ne + avoir + pas + agreeing participle (que je n'ai pas vues)."

rule vagr.clitic: VAgr[person=?p, number=?n, onum=?on, ogen=?og, aux_mood=?auxm, aux_tense=?auxt, aux_person=?r, aux_number=?n, aux_form=?auxf] -> Clitics[attached=no, acc=no, refl=?r, obj=?o, rnum=?n] Verb[lemma=avoir, finite=yes, person=?p, number=?n, person=?r, person!=?o, mood=?auxm, tense=?auxt, form=?auxf] Verb[form=pastpart, takes_avoir=yes, number=?on, gender=?og]
  "An indirect clitic + avoir + agreeing participle (la lettre qu'il m'a écrite)."

rule vagr.clitic-adverb: VAgr[person=?p, number=?n, onum=?on, ogen=?og, aux_mood=?auxm, aux_tense=?auxt, aux_person=?r, aux_number=?n, aux_form=?auxf] -> Clitics[attached=no, acc=no, refl=?r, obj=?o, rnum=?n] Verb[lemma=avoir, finite=yes, person=?p, number=?n, person=?r, person!=?o, mood=?auxm, tense=?auxt, form=?auxf] Mod Verb[form=pastpart, takes_avoir=yes, number=?on, gender=?og]
  "An indirect clitic, avoir, an adverb or pas, and an agreeing participle (la lettre que je lui ai déjà écrite)."

rule vagr.clitic-negated: VAgr[person=?p, number=?n, onum=?on, ogen=?og, aux_mood=?auxm, aux_tense=?auxt, aux_person=?r, aux_number=?n, aux_form=?auxf] -> Neg Clitics[attached=no, acc=no, refl=?r, obj=?o, rnum=?n] Verb[lemma=avoir, finite=yes, person=?p, number=?n, person=?r, person!=?o, mood=?auxm, tense=?auxt, form=?auxf] Mod Verb[form=pastpart, takes_avoir=yes, number=?on, gender=?og]
  "ne, an indirect clitic, avoir, pas and an agreeing participle (la lettre que je ne lui ai pas écrite)."

rule vagr.coordination: VAgr[person=?p, number=?n, onum=?on, ogen=?og] -> VAgr[person=?p, number=?n, onum=?on, ogen=?og] Conj[type=coord] VAgr[person=?p, number=?n, onum=?on, ogen=?og]
  "Two agreeing compound tenses joined by et, ou (les lettres que j'ai lues et ai écrites)."

rule vagr.shared-auxiliary: VAgr[person=?p, number=?n, onum=?on, ogen=?og, aux_mood=?auxm, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> Verb[lemma=avoir, finite=yes, person=?p, number=?n, mood=?auxm, tense=?auxt, form=?auxf] Verb[form=pastpart, takes_avoir=yes, number=?on, gender=?og] Conj[type=coord] Verb[form=pastpart, takes_avoir=yes, number=?on, gender=?og]
  "One avoir for two agreeing participles (les lettres que j'ai lues et relues)."

rule tail.phrase: Tail -> PP
  "A phrase after the verb."

rule tail.adverb: Tail -> Adv
  "An adverb after the verb."

rule tail.time: Tail -> TimeNP
  "A time expression after the verb."

rule tail.more: Tail -> Tail Tail
  "More after the verb."

rule rel.dont: Rel -> RelPron[role=gen] S[imp=no]
  "dont = of which, whose (le livre dont je parle)."

rule rel.ou: Rel -> RelPron[role=place] S[imp=no]
  "où = where, when (la ville où je vis, le jour où il est né)."

rule rel.preposition: Rel[number=?n, gender=?g] -> Prep RelPron[role=prep, number=?n, gender=?g] S[imp=no]
  "preposition + qui, quoi, lequel (la fille à qui je parle, la table sur laquelle)."

rule rel.contracted: Rel[number=?n, gender=?g] -> RelPron[role=prep, number=?n, gender=?g] S[imp=no]
  "auquel, duquel: the preposition is inside the word."

# ---------------------------------------------------- prepositions

rule pp.basic: PP[agent=?a] -> Prep[agent=?a] NP[case=obl, inf_twin=no]
  "A preposition takes a noun phrase (de + le = du, à + les = aux)."

rule pp.bare: PP[agent=no] -> Prep Nom[inf_twin=no]
  "A preposition before a noun without a determiner (en France, à pied, avec plaisir)."

rule pp.bare-en: PP[agent=no] -> Prep[lemma=en] Nom[inf_twin=yes]
  "A noun spelled like an infinitive is a bare noun only after en, which never takes an infinitive (en souvenir de); after de or à the word is the infinitive (pp.infinitive)."

rule pp.infinitive: PP[pinf=yes, pnum=?pn, gender=?g, irefl=?ir, irnum=?irn, agent=no] -> Prep[lemma=pour|sans|par|avant|après] VP[form=inf, pnum=?pn, gender=?g, irefl=?ir, irnum=?irn]
  "A preposition before an infinitive (pour faire, sans dire)."

rule pp.infinitive-de-a: PP[pinf=da, pnum=?pn, gender=?g, irefl=?ir, irnum=?irn, agent=no] -> Prep[lemma=de|à] VP[form=inf, pnum=?pn, gender=?g, irefl=?ir, irnum=?irn]
  "de or à + an infinitive: after a noun or an adjective (le temps de partir, facile à lire); after a verb it is the verb's complement (vp.preposition-infinitive and its object-control variants), not a free phrase."

rule pp.compound-infinitive: PP[pnum=?pn, gender=?g, irefl=?ir, irnum=?irn, agent=no] -> Prep[lemma=avant|afin|loin|près] Prep[lemma=de] VP[form=inf, pnum=?pn, gender=?g, irefl=?ir, irnum=?irn]
  "avant de, afin de + infinitive."

rule pp.gerund: PP[gerund=yes, agent=no, irefl=?ir, irnum=?irn, pnum=?pn, gender=?g] -> Prep[lemma=en] V[etre=no, form=ger|prespart, irefl=?ir, irnum=?irn, pnum=?pn, gender=?g]
  "en + -ant: the gérondif, at the same time or by doing (en mangeant, en le voyant)."

rule pp.gerund-object: PP[gerund=yes, agent=no, irefl=?ir, irnum=?irn, pnum=?pn, gender=?g] -> Prep[lemma=en] VP[form=ger|prespart, irefl=?ir, irnum=?irn, pnum=?pn, gender=?g]
  "en + -ant with its complements (en lisant le journal)."

rule pp.adverb-de: PP[agent=no] -> Adv Prep[lemma=de|à] NP
  "près de, loin de, grâce à + noun phrase."

rule pp.jusque: PP[agent=no] -> Prep[lemma=jusque] PP
  "jusqu'à, jusque dans."

rule pp.de-pp: PP[agent=no] -> Prep[lemma=de] PP
  "de chez moi, d'avant."

rule pp.adverb: PP[agent=no] -> Prep Adv
  "A preposition before an adverb (depuis longtemps, pour toujours, d'ici)."

# ---------------------------------------------- the verb and its clitics
#
# Clitics carries features for the verb to check: `refl` and `rnum`, the
# person and number of a reflexive clitic (they must be the verb's: je me
# lève, not *tu vous laves), and `obj`, the
# person of a 1st or 2nd person clitic that is not reflexive (it must differ
# from the verb's: tu me vois, not *je me vois for "I see me"… which is
# reflexive). `acc=yes` when the clitics hold the direct object, with its
# number and gender in anum/agen for a participle after avoir to agree with.

rule v.plain: V[lemma=?l, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, subj=no, acc=no, neg=no, etre=?e] -> Verb[lemma=?l, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, etre=?e]
  "A verb."

rule v.adverb-after: V[intrans=?it, lemma=?l, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, acc=?a, neg=?ng, gap=?gp, irefl=?ir, irnum=?irn, needs_obj=?no, agreed=?agr, causative=?cz, etre=?e, anum=?an, agen=?ag, aperson=?ap, dperson=?dp, dnum=?dn] -> V[intrans=?it, gap=?gp, irefl=?ir, irnum=?irn, needs_obj=?no, agreed=?agr, causative=?cz, etre=?e, anum=?an, agen=?ag, aperson=?ap, dperson=?dp, dnum=?dn, lemma=?l, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, acc=?a, neg=?ng] Adv
  "An adverb right after the verb (parle bien, est déjà, vient souvent)."

rule v.negation: V[intrans=?it, lemma=?l, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, acc=?a, neg=yes, gap=?gp, irefl=?ir, irnum=?irn, needs_obj=?no, agreed=?agr, causative=?cz, etre=?e, anum=?an, agen=?ag, aperson=?ap, dperson=?dp, dnum=?dn] -> Neg V[intrans=?it, encl=no, gap=?gp, irefl=?ir, irnum=?irn, needs_obj=?no, agreed=?agr, causative=?cz, etre=?e, anum=?an, agen=?ag, aperson=?ap, dperson=?dp, dnum=?dn, lemma=?l, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, acc=?a, neg=no]
  "ne before the verb and its clitics (je ne sais pas, il ne le voit plus)."

rule v.negation-word: V[intrans=?it, lemma=?l, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, acc=?a, neg=yes, gap=?gp, irefl=?ir, irnum=?irn, needs_obj=?no, agreed=?agr, causative=?cz, etre=?e, anum=?an, agen=?ag, aperson=?ap, dperson=?dp, dnum=?dn] -> V[intrans=?it, encl=no, gap=?gp, irefl=?ir, irnum=?irn, needs_obj=?no, agreed=?agr, causative=?cz, etre=?e, anum=?an, agen=?ag, aperson=?ap, dperson=?dp, dnum=?dn, lemma=?l, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, acc=?a, neg=yes] NegAdv
  "pas, plus, jamais, rien, que after the verb, with ne before it (je ne sais pas)."

rule v.negation-spoken: V[intrans=?it, lemma=?l, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, acc=?a, neg=yes, gap=?gp, irefl=?ir, irnum=?irn, needs_obj=?no, agreed=?agr, causative=?cz, etre=?e, anum=?an, agen=?ag, aperson=?ap, dperson=?dp, dnum=?dn] -> V[intrans=?it, encl=no, gap=?gp, irefl=?ir, irnum=?irn, needs_obj=?no, agreed=?agr, causative=?cz, etre=?e, anum=?an, agen=?ag, aperson=?ap, dperson=?dp, dnum=?dn, lemma=?l, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=?s, acc=?a, neg=no] NegAdv[only=no]
  "pas without ne, in speech (je sais pas)."

rule v.negation-infinitive: V[intrans=?it, lemma=?l, finite=no, form=inf, acc=?a, subj=no, neg=yes, anum=?an, agen=?ag, aperson=?ap, dperson=?dp, dnum=?dn, irefl=?ir, irnum=?irn, pnum=?pn, gender=?g] -> Neg NegAdv[only=no] V[intrans=?it, lemma=?l, form=inf, acc=?a, neg=no, anum=?an, agen=?ag, aperson=?ap, dperson=?dp, dnum=?dn, irefl=?ir, irnum=?irn, pnum=?pn, gender=?g]
  "ne pas before an infinitive (pour ne pas oublier)."

rule v.proclitic: V[lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, subj=no, acc=?a, neg=no, anum=?an, agen=?ag, aperson=?ap, dperson=?dp, dnum=?dn] -> Clitics[attached=no, acc=?a, refl=?r, obj=?o, anum=?an, agen=?ag, aperson=?ap, dperson=?dp, dnum=?dn, rnum=?n] Verb[lemma=?l, etre=no, form=fin, mood=ind|sub|cnd, mood=?m, person=?p, number=?n, gender=?g, person=?r, person!=?o]
  "Object pronouns go before a conjugated verb (je le lui donne, il s'en va)."

rule v.proclitic-nonfinite: V[lemma=?l, finite=no, form=?fm, subj=no, acc=?a, neg=no, anum=?an, agen=?ag, aperson=?ap, dperson=?dp, dnum=?dn, irefl=?ir, irnum=?irn] -> Clitics[attached=no, acc=?a, anum=?an, agen=?ag, aperson=?ap, dperson=?dp, dnum=?dn, refl=?ir, rnum=?irn] Verb[lemma=?l, finite=no, form=inf|ger|prespart, form=?fm]
  "Object pronouns go before an infinitive or an -ant form too (pour le faire, en le voyant)."

rule v.proclitic-inverted: V[lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, subj=yes, acc=?a, neg=no, gender=?g, anum=?an, agen=?ag, aperson=?ap, dperson=?dp, dnum=?dn] -> Clitics[attached=no, acc=?a, refl=?r, obj=?o, rnum=?n, anum=?an, agen=?ag, aperson=?ap, dperson=?dp, dnum=?dn] Verb[lemma=?l, etre=no, form=fin, mood=ind|sub|cnd, mood=?m, person=?p, number=?n, person=?r, person!=?o] Pron[attached=yes, case=nom, person=?p, number=?n, gender=?g]
  "Object pronouns, then the verb with its subject after it (Le connais-tu ? T'en souviens-tu ?)."

rule v.inverted: V[lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, subj=yes, acc=no, neg=no, etre=?e, gender=?g, cesubj=?dm] -> Verb[lemma=?l, etre=?e, form=fin, mood=ind|sub|cnd, mood=?m, person=?p, number=?n] Pron[attached=yes, case=nom, person=?p, number=?n, gender=?g, demonstrative=?dm]
  "Inversion: the subject pronoun after the verb (parlez-vous, a-t-il, puis-je)."

rule v.imperative-enclitic: V[encl=yes, lemma=?l, finite=yes, form=fin, mood=imp, person=?p, number=?n, subj=no, acc=?a, neg=no, anum=?an, agen=?ag, aperson=?ap, dperson=?dp, dnum=?dn] -> Verb[lemma=?l, form=fin, mood=imp, person=?p, number=?n] EnCl[acc=?a, refl=?p, obj!=?p, rnum=?n, anum=?an, agen=?ag, aperson=?ap, dperson=?dp, dnum=?dn]
  "In an order, the object pronouns follow the verb, with hyphens (donne-le-moi, lève-toi, allez-y)."

rule v.imperative-negated: V[lemma=?l, finite=yes, form=fin, mood=imp, person=?p, number=?n, subj=no, acc=?a, neg=yes, anum=?an, agen=?ag, aperson=?ap, dperson=?dp, dnum=?dn] -> Neg Clitics[attached=no, acc=?a, refl=?r, obj=?o, rnum=?n, anum=?an, agen=?ag, aperson=?ap, dperson=?dp, dnum=?dn] Verb[lemma=?l, form=fin, mood=imp, person=?p, number=?n, person=?r, person!=?o]
  "In a negative order the pronouns stay before the verb, after ne (ne me regarde pas, ne t'en fais pas)."

# compound tenses
rule v.perfect-avoir: V[lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, subj=no, acc=no, neg=no, gap=yes, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> Verb[lemma=avoir, finite=yes, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Verb[lemma=?l, form=pastpart, takes_avoir=yes, number=sg, gender=m]
  "A compound tense with avoir (j'ai fait). With no direct object before it, the participle does not agree."

rule v.perfect-avoir-shared: V[lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, subj=no, acc=no, neg=no, gap=yes, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> Verb[lemma=avoir, finite=yes, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Verb[form=pastpart, takes_avoir=yes, number=sg, gender=m] Conj[type=coord] Verb[lemma=?l, form=pastpart, takes_avoir=yes, number=sg, gender=m]
  "One avoir for two participles (j'ai mangé et bu)."

rule v.perfect-avoir-adverb: V[lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, pnum=?pn, subj=no, acc=no, neg=?ng, gap=yes, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> Verb[lemma=avoir, finite=yes, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Mod[neg=?ng, qnum=?pn] Verb[lemma=?l, form=pastpart, takes_avoir=yes, number=sg, gender=m]
  "An adverb or pas between avoir and the participle (j'ai déjà vu, je n'ai pas fini)."

rule v.perfect-etre: V[intrans=yes, lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=no, acc=no, neg=no, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> Verb[lemma=être, finite=yes, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Verb[lemma=?l, form=pastpart, takes_etre=yes, number=?pn, gender=?g]
  "A compound tense with être, for verbs that take être (aller, venir, partir, naître): the participle agrees with the subject (elle est partie)."

rule v.perfect-etre-shared: V[intrans=yes, lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=no, acc=no, neg=no, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> Verb[lemma=être, finite=yes, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Verb[form=pastpart, takes_etre=yes, number=?pn, gender=?g] Conj[type=coord] Verb[lemma=?l, form=pastpart, takes_etre=yes, number=?pn, gender=?g]
  "One être for two participles, both agreeing with the subject (elle est née et morte à Paris)."

rule v.perfect-etre-adverb: V[intrans=yes, lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=no, acc=no, neg=?ng, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> Verb[lemma=être, finite=yes, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Mod[neg=?ng, qnum=?pn, qgen=?g] Verb[lemma=?l, form=pastpart, takes_etre=yes, number=?pn, gender=?g]
  "An adverb or pas between être and the participle (elle est déjà partie, il n'est pas venu)."

rule v.proclitic-perfect-avoir: V[dperson=?dp, dnum=?dn, lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, subj=no, acc=no, neg=no, gap=yes, aux_mood=?m, aux_tense=?auxt, aux_person=?r, aux_number=?n, aux_form=?auxf] -> Clitics[dperson=?dp, dnum=?dn, attached=no, reflexive=no, acc=no, refl=?r, obj=?o, rnum=?n] Verb[lemma=avoir, finite=yes, mood=?m, person=?p, number=?n, person=?r, person!=?o, tense=?auxt, form=?auxf] Verb[lemma=?l, form=pastpart, takes_avoir=yes, number=sg, gender=m]
  "An indirect object pronoun before avoir (il m'a parlé, j'y ai pensé)."

rule v.proclitic-perfect-avoir-agree: V[dperson=?dp, dnum=?dn, lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, subj=no, acc=yes, neg=no, anum=?on, agen=?og, aperson=?ap, agreed=yes, aux_mood=?m, aux_tense=?auxt, aux_person=?r, aux_number=?n, aux_form=?auxf] -> Clitics[dperson=?dp, dnum=?dn, attached=no, reflexive=no, acc=yes, anum=?on, agen=?og, aperson=?ap, refl=?r, obj=?o, rnum=?n] Verb[lemma=avoir, finite=yes, mood=?m, person=?p, number=?n, person=?r, person!=?o, tense=?auxt, form=?auxf] Verb[lemma=?l, form=pastpart, takes_avoir=yes, number=?on, gender=?og]
  "A direct object pronoun before avoir: the participle agrees with it (je les ai vues, il l'a prise)."

rule v.proclitic-perfect-avoir-adverb: V[dperson=?dp, dnum=?dn, lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, subj=no, acc=no, neg=?ng, gap=yes, aux_mood=?m, aux_tense=?auxt, aux_person=?r, aux_number=?n, aux_form=?auxf] -> Clitics[dperson=?dp, dnum=?dn, attached=no, reflexive=no, acc=no, refl=?r, obj=?o, rnum=?n] Verb[lemma=avoir, finite=yes, mood=?m, person=?p, number=?n, person=?r, person!=?o, tense=?auxt, form=?auxf] Mod[neg=?ng] Verb[lemma=?l, form=pastpart, takes_avoir=yes, number=sg, gender=m]
  "An indirect pronoun before avoir, an adverb before the participle (il m'a déjà parlé)."

rule v.proclitic-perfect-avoir-agree-adverb: V[dperson=?dp, dnum=?dn, lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, subj=no, acc=yes, neg=?ng, anum=?on, agen=?og, aperson=?ap, agreed=yes, aux_mood=?m, aux_tense=?auxt, aux_person=?r, aux_number=?n, aux_form=?auxf] -> Clitics[dperson=?dp, dnum=?dn, attached=no, reflexive=no, acc=yes, anum=?on, agen=?og, aperson=?ap, refl=?r, obj=?o, rnum=?n] Verb[lemma=avoir, finite=yes, mood=?m, person=?p, number=?n, person=?r, person!=?o, tense=?auxt, form=?auxf] Mod[neg=?ng] Verb[lemma=?l, form=pastpart, takes_avoir=yes, number=?on, gender=?og]
  "A direct object pronoun before avoir, an adverb before the agreeing participle (je ne l'ai pas vue)."

rule v.causative-perfect: V[lemma=faire, finite=yes, form=fin, mood=?m, person=?p, number=?n, subj=no, acc=yes, neg=no, anum=?an, agen=?ag, aperson=?ap, dperson=?dp, dnum=?dn, causative=yes, aux_mood=?m, aux_tense=?auxt, aux_person=?r, aux_number=?n, aux_form=?auxf] -> Clitics[attached=no, reflexive=no, acc=yes, anum=?an, agen=?ag, aperson=?ap, dperson=?dp, dnum=?dn, refl=?r, obj=?o, rnum=?n] Verb[lemma=avoir, finite=yes, mood=?m, person=?p, number=?n, person=?r, person!=?o, tense=?auxt, form=?auxf] Verb[lemma=faire, form=pastpart, number=sg, gender=m]
  "Causative faire in a compound tense with an object pronoun: fait stays invariable, since the infinitive that follows (vp.causative-object-control) has the object (elle les a fait partir)."

rule v.causative-perfect-adverb: V[lemma=faire, finite=yes, form=fin, mood=?m, person=?p, number=?n, subj=no, acc=yes, neg=?ng, anum=?an, agen=?ag, aperson=?ap, dperson=?dp, dnum=?dn, causative=yes, aux_mood=?m, aux_tense=?auxt, aux_person=?r, aux_number=?n, aux_form=?auxf] -> Clitics[attached=no, reflexive=no, acc=yes, anum=?an, agen=?ag, aperson=?ap, dperson=?dp, dnum=?dn, refl=?r, obj=?o, rnum=?n] Verb[lemma=avoir, finite=yes, mood=?m, person=?p, number=?n, person=?r, person!=?o, tense=?auxt, form=?auxf] Mod[neg=?ng] Verb[lemma=faire, form=pastpart, number=sg, gender=m]
  "The same with an adverb or pas (elle les a déjà fait partir, elle ne les a pas fait partir)."

rule v.causative-perfect-inverted: V[lemma=faire, finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, subj=yes, acc=yes, neg=no, anum=?an, agen=?ag, aperson=?ap, dperson=?dp, dnum=?dn, causative=yes, aux_mood=?m, aux_tense=?auxt, aux_person=?r, aux_number=?n, aux_form=?auxf] -> Clitics[attached=no, reflexive=no, acc=yes, anum=?an, agen=?ag, aperson=?ap, dperson=?dp, dnum=?dn, refl=?r, obj=?o, rnum=?n] Verb[lemma=avoir, finite=yes, mood=?m, person=?p, number=?n, person=?r, person!=?o, tense=?auxt, form=?auxf] Pron[attached=yes, case=nom, person=?p, number=?n, gender=?g] Verb[lemma=faire, form=pastpart, number=sg, gender=m]
  "The same, inverted (Les a-t-elle fait partir ?)."

rule v.causative-perfect-inverted-adverb: V[lemma=faire, finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, subj=yes, acc=yes, neg=?ng, anum=?an, agen=?ag, aperson=?ap, dperson=?dp, dnum=?dn, causative=yes, aux_mood=?m, aux_tense=?auxt, aux_person=?r, aux_number=?n, aux_form=?auxf] -> Clitics[attached=no, reflexive=no, acc=yes, anum=?an, agen=?ag, aperson=?ap, dperson=?dp, dnum=?dn, refl=?r, obj=?o, rnum=?n] Verb[lemma=avoir, finite=yes, mood=?m, person=?p, number=?n, person=?r, person!=?o, tense=?auxt, form=?auxf] Pron[attached=yes, case=nom, person=?p, number=?n, gender=?g] Mod[neg=?ng] Verb[lemma=faire, form=pastpart, number=sg, gender=m]
