rule v.proclitic-perfect-etre: V[dperson=?dp, dnum=?dn, lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=no, acc=no, neg=?ng, aux_mood=?m, aux_tense=?auxt, aux_person=?r, aux_number=?n, aux_form=?auxf] -> Clitics[dperson=?dp, dnum=?dn, attached=no, reflexive=no, acc=no, refl=?r, obj=?o, rnum=?n] Verb[lemma=être, finite=yes, mood=?m, person=?p, number=?n, person=?r, person!=?o, tense=?auxt, form=?auxf] Mod[neg=?ng] Verb[lemma=?l, form=pastpart, takes_etre=yes, number=?pn, gender=?g]
  "A pronoun before être in a compound tense of an être verb, with an adverb (il en est déjà sorti)."

rule v.proclitic-perfect-etre-plain: V[dperson=?dp, dnum=?dn, lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, pnum=?pn, subj=no, acc=no, neg=no, aux_mood=?m, aux_tense=?auxt, aux_person=?r, aux_number=?n, aux_form=?auxf] -> Clitics[dperson=?dp, dnum=?dn, attached=no, reflexive=no, acc=no, refl=?r, obj=?o, rnum=?n] Verb[lemma=être, finite=yes, mood=?m, person=?p, number=?n, person=?r, person!=?o, tense=?auxt, form=?auxf] Verb[lemma=?l, form=pastpart, takes_etre=yes, number=?pn, gender=?g]
  "A pronoun before être in a compound tense of an être verb (j'y suis allé, il en est sorti)."

rule v.reflexive-perfect: V[gap=yes, lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, subj=no, acc=no, neg=no, pnum=?pn, gender=?g, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> Clitics[attached=no, reflexive=yes, acc=no, refl=?p, rnum=?n] Verb[lemma=être, finite=yes, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Verb[lemma=?l, form=pastpart, number=?pn, gender=?g]
  "A pronominal verb takes être in compound tenses, whatever its own auxiliary (elle s'est levée, ils se sont parlé)."
  "The reflexive pronoun is the direct object, so the participle agrees with the subject (elle s'est levée)."

rule v.reflexive-perfect-indirect: V[lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, subj=no, acc=no, neg=no, needs_obj=yes, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> Clitics[attached=no, reflexive=yes, acc=no, refl=?p, rnum=?n] Verb[lemma=être, finite=yes, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Verb[lemma=?l, form=pastpart, number=sg, gender=m]
  "The reflexive pronoun is an indirect object: the participle stays masculine singular, and a complement follows (elle s'est lavé les mains, ils se sont dit que…)."

rule v.reflexive-perfect-indirect-only: V[gap=yes, lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, subj=no, acc=no, neg=no, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> Clitics[attached=no, reflexive=yes, acc=no, refl=?p, rnum=?n] Verb[lemma=être, finite=yes, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Verb[lemma=?l, lemma=parler|téléphoner|écrire|sourire|plaire|déplaire|nuire|succéder|mentir|ressembler|rire|suffire|demander|répondre|convenir|survivre, form=pastpart, number=sg, gender=m]
  "Verbs whose reflexive can only be indirect (parler à, sourire à, plaire à…): the participle stays masculine singular even with nothing after it (elles se sont parlé, ils se sont souri)."

