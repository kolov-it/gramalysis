# Spanish grammar.
#
# Feature names: person 1/2/3, number sg/pl, gender m/f, case nom/obl/acc/dat/
# refl/sedat, finite yes/no, form fin/inf/ger/pastpart, mood ind/sub/cnd/imp.
# A feature a word does not have is unknown and matches anything, so rules
# select on features every candidate word carries: every verb has `class`
# (ser, estar, haber or lex), every conjugated form has form=fin, every
# clitic has `attached`, every adjective phrase has `participle`.

start S

# ---------------------------------------------------------------- clauses

rule clause.subject: S -> NP[case=nom, person=?p, number=?n, gender=?g] VP[finite=yes, person=?p, number=?n, gender=?g]
  "The verb agrees with its subject in person and number."

rule clause.null-subject: S -> VP[finite=yes]
  "Spanish can leave the subject out: the verb ending says who acts."

rule clause.subject-after: S -> VP[finite=yes, form=fin, person=?p, number=?n, gender=?g] NP[case=nom, person=?p, number=?n, gender=?g]
  "The subject can come after the verb (llegó Juan, me gusta el café)."

rule clause.coordination: S -> S Conj[type=coord] S
  "Two clauses joined by y, pero, o or ni."

rule clause.subordinate: S -> S Conj[type=sub] S
  "A clause joined by que, si, porque, cuando or aunque."

rule clause.subordinate-first: S -> Conj[type=sub] S Punct S
  "A clause with si, cuando or aunque first, then a comma (Si llueve, me quedo en casa)."

rule clause.subordinate-first-no-comma: S -> Conj[type=sub] S S
  "A clause with si, cuando or aunque first, without a comma."

rule clause.comma: S -> S Punct S
  "Two clauses separated by a comma."

rule clause.phrase-first: S -> PP S
  "A phrase with a preposition at the start of the clause (Después de cenar paseo por la playa)."

rule clause.phrase-first-comma: S -> PP Punct S
  "A phrase with a preposition at the start, then a comma."

rule clause.adverb-first: S -> Adv[neg=no] S
  "An adverb at the start of the clause (ayer, quizás, ahora)."

rule clause.adverb-first-comma: S -> Adv[neg=no] Punct S
  "An adverb and a comma at the start (Sin embargo, …; Bueno, …)."

rule clause.time-first: S -> TimeNP S
  "A time expression at the start of the clause (Cada mañana corro)."

rule clause.vocative-first: S -> ProperNoun Punct S
  "Addressing someone first, then a comma (Tom, ven aquí)."

rule clause.vocative-last: S -> S Punct ProperNoun
  "Addressing someone at the end, after a comma (Ven aquí, Tom)."

rule clause.interjection: S -> Intj Punct S
  "sí, no or another interjection, then a comma (Sí, lo sé)."

rule clause.interjection-alone: S -> Intj
  "An interjection on its own (¡Hola!, No.)."

rule clause.gerund-first: S -> VP[form=ger] Punct S
  "A gerund phrase first says how or while (Caminando por la calle, vi a Juan)."

rule clause.participle-first: S -> PartP Punct S
  "A participle phrase first says what was done before (Terminada la cena, salimos)."

# ---------------------------------------------------------- noun phrases

rule np.name: NP[person=3, number=sg, gender=?g] -> ProperNoun[gender=?g]
  "A name is a third-person singular noun phrase."

rule np.pronoun: NP[person=?p, number=?n, gender=?g, case=?c] -> Pron[clitic=no, person=?p, number=?n, gender=?g, case=?c]
  "A stressed pronoun stands on its own as a noun phrase."

rule np.article: NP[person=3, number=?n, gender=?g] -> Det[number=?n, gender=?g, next=?o] Nom[number=?n, gender=?g, onset=?o]
  "The article agrees with its noun in gender and number; a feminine noun starting with a stressed a takes el and un (el agua, un águila)."

rule np.numeral: NP[person=3, number=pl, gender=?g] -> Num Nom[number=pl, gender=?g]
  "A number before a plural noun (dos libros)."

rule np.article-numeral: NP[person=3, number=pl, gender=?g] -> Det[number=pl, gender=?g] Num Nom[number=pl, gender=?g]
  "An article and a number before a plural noun (los dos libros)."

rule np.possessive: NP[person=3, number=?n, gender=?g] -> Poss[number=?n, gender=?g] Nom[number=?n, gender=?g]
  "A possessive before the noun takes no article (mi casa, nuestras ideas)."

rule np.possessive-alone: NP[person=3, number=?n, gender=?g] -> Det[definite=yes, number=?n, gender=?g] PossAfter[number=?n, gender=?g]
  "The article and a stressed possessive stand for a noun (el mío, la tuya)."

rule nom.possessive-after: Nom[number=?n, gender=?g, onset=?o] -> Nom[number=?n, gender=?g, onset=?o] PossAfter[number=?n, gender=?g]
  "A stressed possessive after the noun (un amigo mío)."

rule np.predeterminer: NP[person=3, number=?n, gender=?g] -> Predet[number=?n, gender=?g] NP[number=?n, gender=?g]
  "todo before the article agrees with the noun (todos los días, toda la noche)."

rule np.bare: NP[case=obl, person=3, number=?n, gender=?g] -> Nom[number=?n, gender=?g]
  "A noun without an article, as an object or after a preposition (tengo hambre, como manzanas); not as a subject."

rule np.neuter-adjective: NP[person=3, number=sg] -> Neut AP
  "lo + adjective: what is so (lo bueno, lo importante)."

rule np.free-relative: NP[person=3, number=?n, gender=?g] -> Det[definite=yes, number=?n, gender=?g] Rel
  "The article + que stands for whoever or whatever does it (el que llegue primero, lo que dijiste)."

rule np.neuter-relative: NP[person=3, number=sg] -> Neut Rel
  "lo que: what (lo que dijiste)."

rule np.coordination: NP[number=pl] -> NP Conj[type=coord] NP
  "Two noun phrases joined by y, o or ni (Tom y Mary, tú y yo)."

rule np.coordination-disjunctive: NP[number=sg] -> NP[number=sg] Conj[lemma=o] NP[number=sg]
  "Two singular noun phrases joined by o can take a singular verb (Tom o Mary fue a Madrid)."

rule np.list: NP[number=pl] -> NP Punct NPList
  "A list of noun phrases separated by commas, the last joined by y or o."

rule nplist.last: NPList -> NP Conj[type=coord] NP
  "The end of a list: … y …"

rule nplist.more: NPList -> NP Punct NPList
  "A list item followed by a comma."

rule np.relative: NP[person=?p, number=?n, gender=?g, case=?c] -> NP[person=?p, number=?n, gender=?g, case=?c] Rel
  "A clause with que, quien or donde describes the noun (el libro que leo)."

rule np.relative-comma: NP[person=?p, number=?n, gender=?g, case=?c] -> NP[person=?p, number=?n, gender=?g, case=?c] Punct Rel
  "A clause after a comma adds to the noun (mi hermano, que vive en Madrid)."

rule nom.noun: Nom[number=?n, gender=?g, onset=?o] -> Noun[number=?n, gender=?g, onset=?o]
  "A noun."

rule nom.adjective-after: Nom[after_participle=?x, number=?n, gender=?g, onset=?o] -> Nom[number=?n, gender=?g, onset=?o] AP[participle=?x, number=?n, gender=?g]
  "An adjective after its noun agrees with it in gender and number."

rule nom.participle-before: Nom[number=?n, gender=?g, onset=?o] -> AP[prenominal=yes, number=?n, gender=?g, onset=?o] Nom[number=?n, gender=?g]
  "A participle before its noun, used like an adjective (el esperado resultado)."

rule nom.adjective-before: Nom[number=?n, gender=?g, onset=?o] -> Adj[number=?n, gender=?g, onset=?o] Nom[number=?n, gender=?g]
  "An adjective before its noun agrees with it in gender and number (una buena idea)."

rule nom.prepositional-phrase: Nom[number=?n, gender=?g, onset=?o] -> Nom[after_participle=no, number=?n, gender=?g, onset=?o] PP
  "A phrase with a preposition describes the noun (la casa de Tom). Right after a participle it belongs to the participle instead (un libro escrito en inglés)."

rule nom.participle-phrase: Nom[number=?n, gender=?g, onset=?o] -> Nom[number=?n, gender=?g, onset=?o] PartP[number=?n, gender=?g]
  "A participle with the verb's complements after the noun shortens a relative clause (un libro escrito en inglés = que fue escrito en inglés)."

rule partp.past: PartP[number=?n, gender=?g] -> Verb[form=pastpart, drifted=no, number=?n, gender=?g] Compl
  "A past participle with the verb's complements: passive or completed meaning, agreeing with the noun (escrito en inglés, construida por los romanos)."

rule partp.adverb: PartP[number=?n, gender=?g] -> Adv PartP[number=?n, gender=?g]
  "An adverb before the participle phrase (recién llegado de París, jamás alcanzado por una sonda)."

rule partp.absolute: PartP[number=?n, gender=?g] -> Verb[form=pastpart, drifted=no, number=?n, gender=?g] NP[number=?n, gender=?g]
  "A participle and the noun it describes, opening the sentence (Terminada la cena, …)."

rule compl.phrase: Compl -> PP
  "A complement of the participle."

rule compl.more: Compl -> Compl PP
  "Another complement."

# ------------------------------------------------- prepositional phrases

rule pp.basic: PP[prep=?l] -> Prep[lemma=?l] NP[case=obl]
  "A preposition takes a noun phrase (de + el = del, a + el = al)."

rule pp.bare: PP[prep=?l] -> Prep[lemma=?l] Nom
  "A preposition before a noun without an article (en casa, con cuidado)."

rule pp.infinitive: PP[prep=?l] -> Prep[lemma=?l] VP[form=inf]
  "A preposition before an infinitive (para hacer, sin decir, voy a comer)."

rule pp.que-clause: PP[prep=?l] -> Prep[lemma=?l] Conj[lemma=que] S
  "A preposition + que + clause (para que vengas, hasta que llegue)."

rule pp.adverb: PP[prep=?l] -> Adv[neg=no] PP[prep=?l]
  "An adverb before the phrase (justo en el centro, muy de mañana)."

rule pp.question: PP[prep=?l] -> Prep[lemma=?l] Wh S
  "A preposition + question word inside the sentence."

# --------------------------------------------- the verb and its clitics
#
# Clitics carries two features for the verb to check: `refl`, the person of a
# reflexive clitic (it must be the verb's person: te acuerdas, acuérdate),
# and `obj`, the person of a 1st or 2nd person clitic that is not reflexive
# (it must differ from the verb's: me das, but not *me doy for "I give me").

rule v.plain: V[lemma=?l, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> Verb[class=lex, lemma=?l, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g]
  "A verb (ser, estar and haber have rules of their own)."

rule v.adverb-after: V[lemma=?l, clitic_case=?k, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> V[lemma=?l, clitic_case=?k, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] Adv[neg=no]
  "An adverb right after the verb (habla bien, llegó tarde)."

rule v.proclitic: V[lemma=?l, clitic_case=?k, finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g] -> Clitics[attached=no, case=?k, refl=?r, obj=?o] V[lemma=?l, form=fin, mood=ind|sub|cnd, person=?p, number=?n, gender=?g, person=?r, person!=?o]
  "Clitic pronouns go before a conjugated verb (me lo da, se fue)."

rule v.enclitic-nonfinite: V[lemma=?l, clitic_case=?k, finite=no, form=?fm] -> Verb[class=lex|estar|haber|ser, lemma=?l, finite=no, form=inf|ger, form=?fm] Clitics[attached=yes, case=?k]
  "Clitic pronouns attach to the end of an infinitive or gerund (hacerlo, diciéndoselo)."

rule v.enclitic-imperative: V[lemma=?l, clitic_case=?k, finite=yes, form=fin, mood=imp, person=?p, number=?n] -> Verb[class=lex|estar|ser, lemma=?l, form=fin, mood=imp|sub, person=?p, number=?n] Clitics[attached=yes, case=?k, refl=?p, obj!=?p]
  "Clitic pronouns attach to the end of an affirmative command (dámelo, siéntese, hagámoslo)."

rule v.perfect: V[aux=haber, lemma=?l, finite=?f, form=?fm, mood=?m, person=?p, number=?n] -> Verb[class=haber, finite=?f, form=?fm, mood=?m, person=?p, number=?n] Verb[class=lex|estar|haber, lemma=?l, form=pastpart, gender=m, number=sg]
  "A compound tense: haber + past participle, which does not agree (he cerrado, había llegado, habiendo dicho)."

rule v.perfect-proclitic: V[aux=haber, lemma=?l, clitic_case=?k, finite=yes, form=fin, mood=?m, person=?p, number=?n] -> Clitics[attached=no, case=?k, refl=?r, obj=?o] Verb[class=haber, form=fin, mood=ind|sub|cnd, mood=?m, person=?p, number=?n, person=?r, person!=?o] Verb[class=lex|estar|haber, lemma=?l, form=pastpart, gender=m, number=sg]
  "Clitic pronouns before haber in a compound tense (lo he hecho, me he levantado)."

rule v.perfect-enclitic: V[aux=haber, lemma=?l, clitic_case=?k, finite=no, form=?fm] -> Verb[class=haber, finite=no, form=inf|ger, form=?fm] Clitics[attached=yes, case=?k] Verb[class=lex|estar|haber, lemma=?l, form=pastpart, gender=m, number=sg]
  "Clitics on haber in a compound infinitive or gerund (haberlo hecho, habiéndose ido)."

rule v.progressive: V[lemma=?l, clitic_case=?k, finite=?f, form=?fm, mood=?m, person=?p, number=?n] -> Verb[class=estar|lex, lemma=estar|seguir|ir|andar|venir|llevar|continuar, finite=?f, form=?fm, mood=?m, person=?p, number=?n] V[lemma=?l, clitic_case=?k, finite=no, form=ger]
  "estar, seguir, ir, andar, venir or llevar + gerund: an action in progress (estoy leyendo, sigue lloviendo)."

rule v.progressive-perfect: V[lemma=?l, clitic_case=?k, finite=?f, form=?fm, mood=?m, person=?p, number=?n] -> Verb[class=haber, finite=?f, form=?fm, mood=?m, person=?p, number=?n] Verb[lemma=estar, form=pastpart] V[lemma=?l, clitic_case=?k, finite=no, form=ger]
  "haber estado + gerund (he estado trabajando)."

rule clitics.reflexive: Clitics[reflexive=yes, attached=?a, refl=?p, case=?k] -> Pron[attached=?a, clitic=yes, case=?k, case=refl, person=?p]
  "A reflexive clitic: the action falls back on the subject (me lavo, acuérdate, se fue)."

rule clitics.local: Clitics[reflexive=no, attached=?a, obj=?p, case=?k] -> Pron[attached=?a, clitic=yes, case=?k, case=acc|dat, person=1|2, person=?p]
  "A 1st or 2nd person clitic pronoun (me, te, nos, os)."

rule clitics.other: Clitics[reflexive=no, attached=?a, case=?k] -> Pron[attached=?a, clitic=yes, case=?k, case=acc|dat, person=3]
  "A clitic pronoun: lo, la, los, las, le, les."

rule clitics.two-reflexive: Clitics[reflexive=yes, attached=?a, refl=?p, case=?k] -> Pron[attached=?a, clitic=yes, case=refl, person=?p] Pron[clitic=yes, case=?k, case=acc|dat]
  "A reflexive clitic before another one (me lo comí, se le cayó, se me olvidó)."

rule clitics.two-local: Clitics[reflexive=no, attached=?a, obj=?p, case=?k] -> Pron[attached=?a, clitic=yes, case=dat, person=1|2, person=?p] Pron[clitic=yes, case=?k, case=acc, person=3]
  "Two clitics: the indirect one comes first (me lo dio, dámelo, te la doy)."

rule clitics.two-other: Clitics[reflexive=no, attached=?a, case=?k] -> Pron[attached=?a, clitic=yes, case=sedat] Pron[clitic=yes, case=?k, case=acc, person=3]
  "le / les before lo, la, los, las becomes se (se lo doy, dígaselo)."

# ----------------------------------------------------------- verb phrases

rule vp.verb: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> V[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g]
  "A verb on its own."

rule vp.object: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> V[clitic_case=dat|refl|sedat, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] NP[case=obl]
  "The verb takes a direct object, unless lo, la, los or las already is its object (lo hice, not *lo hice un pastel)."

rule vp.object-personal: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> V[clitic_case=dat|refl|sedat, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] Prep[lemma=a] NP[case=obl, person=?op, person!=?p]
  "A person as the direct object takes a (veo a María, busco a mi hermano)."

rule vp.infinitive: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> V[clitic_case=dat|refl|sedat, lemma=poder|deber|querer|saber|soler|ver|oír|hacer|dejar|desear|preferir|necesitar|esperar|pensar|intentar|lograr|conseguir|decidir|prometer|odiar|amar|temer|evitar|parecer|gustar|encantar|importar|interesar|apetecer|sentir|escuchar|mirar|permitir|prohibir|mandar|merecer|procurar|pretender|planear|olvidar|recordar|lamentar|admitir|negar|asegurar|confesar|creer|declarar|afirmar|imaginar|resultar|convenir|bastar|costar|faltar|urgir|acordar|ansiar|anhelar|elegir|fingir|osar|rehusar|proponer|ordenar|impedir|aconsejar|sugerir|agradecer|confiar|ofrecer|jurar|aceptar|adorar|reconocer|detestar|soportar|aguantar|tolerar|suponer, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] VP[form=inf]
  "A verb followed by an infinitive without a preposition: modal, perception and causative verbs and those that take an infinitive as their object (quiero salir, lo vi llegar, me gusta leer)."

rule vp.infinitive-climbed: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> V[clitic_case=acc, lemma=poder|deber|querer|saber|soler|ver|oír|hacer|dejar|desear|preferir|necesitar|esperar|pensar|intentar|lograr|conseguir|decidir|prometer|odiar|amar|temer|evitar|parecer|gustar|encantar|importar|interesar|apetecer|sentir|escuchar|mirar|permitir|prohibir|mandar|merecer|procurar|pretender|planear|olvidar|recordar|lamentar|admitir|negar|asegurar|confesar|creer|declarar|afirmar|imaginar|resultar|convenir|bastar|costar|faltar|urgir|acordar|ansiar|anhelar|elegir|fingir|osar|rehusar|proponer|ordenar|impedir|aconsejar|sugerir|agradecer|confiar|ofrecer|jurar|aceptar|adorar|reconocer|detestar|soportar|aguantar|tolerar|suponer, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] V[form=inf]
  "A direct-object clitic before the verb belongs to the infinitive (lo puedo leer = puedo leerlo), which then takes no other object; phrases and adverbs still attach to the whole."

rule vp.tener-que: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> V[lemma=tener, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] Conj[lemma=que] VP[form=inf]
  "tener que + infinitive: having to (tengo que irme)."

rule vp.que-clause: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> V[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] Conj[lemma=que] S
  "The verb introduces a clause with que (dijo que…, quiero que vengas)."

rule vp.object-que-clause: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> V[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] NP[case=obl] Conj[lemma=que] S
  "Verb + person + que-clause (le dije a Juan que…, avisa a tu madre que…)."

rule vp.si-clause: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> V[lemma=saber|preguntar|ver|decidir|dudar|depender|mirar|comprobar|averiguar|importar|entender|recordar|decir|imaginar, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] Conj[lemma=si] S
  "A yes/no question inside the sentence (no sé si viene)."

rule vp.indirect-question: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> V[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] Wh S
  "A question inside the sentence (dime qué quieres, no sé cuál elegir)."

rule vp.indirect-question-adverb: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> V[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] QAdv S
  "A question with dónde, cuándo or cómo inside the sentence (no sé dónde está)."

rule vp.indirect-question-preposition: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> V[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] Prep Wh S
  "A question with a preposition inside the sentence (no sé de qué hablas, ¿sabes por qué llora?)."

rule vp.indirect-question-infinitive: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> V[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] QAdv VP[form=inf]
  "A question word + infinitive (no sé cómo hacerlo)."

rule vp.prepositional-phrase: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] PP
  "A prepositional phrase adds where, when, for whom or how."

rule vp.adverb: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] Adv[neg=no]
  "An adverb after the verb phrase."

rule vp.adverb-before: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> Adv[neg=no] VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g]
  "An adverb before the verb (ya lo sé, siempre llega tarde, también quiero)."

rule vp.negation: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> Adv[neg=yes] VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g]
  "no, nunca or tampoco goes right before the verb and its clitics."

rule vp.time: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] TimeNP
  "A time expression after the verb says when or how often (me entreno todos los días)."

rule vp.gerund: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] VP[form=ger]
  "A gerund after the verb says how (salió corriendo)."

rule vp.floating-quantifier: VP[finite=?f, form=?fm, mood=?m, person=?p, number=pl, gender=?g] -> VP[finite=?f, form=?fm, mood=?m, person=?p, number=pl, gender=?g] Pron[lemma=todo, number=pl]
  "todos / todas after the verb, for the whole plural subject (se fueron todos)."

rule vp.object-predicative: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> V[lemma=hacer|dejar|tener|encontrar|ver|sentir|considerar|llevar|mantener|poner|volver|creer|querer|preferir|imaginar|declarar|nombrar|elegir|llamar|traer, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] NP[case=obl, number=?on, gender=?og] AP[number=?on, gender=?og]
  "Verb + object + an adjective saying what the object is or becomes (dejó la puerta abierta, tengo las manos atadas)."

rule vp.clitic-predicative: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> V[lemma=hacer|dejar|tener|encontrar|ver|sentir|considerar|llevar|mantener|poner|volver|creer|querer|preferir|imaginar|declarar|nombrar|elegir|llamar|traer, clitic_case=acc, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] AP
  "Clitic object + verb + an adjective saying what the object is (la encontré dormida, lo tengo preparado)."

# ------------------------------------------------- haber: there is

rule vp.existential: VP[finite=?f, form=?fm, mood=?m, person=3, number=sg] -> Verb[class=haber, exist=yes, finite=?f, form=?fm, mood=?m, person=3, number=sg] NP[case=obl]
  "hay, había, habrá + a noun phrase: there is (hay un perro, había mucha gente)."

rule vp.existential-bare: VP[finite=yes, form=fin, mood=?m, person=3, number=sg] -> Verb[class=haber, exist=yes, finite=yes, mood=?m, person=3, number=sg]
  "hay on its own, its noun phrase already said (no hay, ¿hay?)."

rule vp.existential-clitic: VP[finite=yes, form=fin, mood=?m, person=3, number=sg] -> Clitics[attached=no, case=acc] Verb[class=haber, exist=yes, finite=yes, mood=?m, person=3, number=sg]
  "lo hay, las hay."

rule vp.existential-progressive: VP[finite=?f, form=?fm, mood=?m, person=3, number=sg] -> Verb[class=estar|lex, lemma=estar|seguir|ir|venir, finite=?f, form=?fm, mood=?m, person=3, number=sg] Verb[class=haber, form=ger] NP[case=obl]
  "estar / seguir + habiendo + a noun phrase: there is, in progress (está habiendo problemas)."

rule vp.haber-que: VP[finite=?f, form=?fm, mood=?m, person=3, number=sg] -> Verb[class=haber, exist=yes, finite=?f, form=?fm, mood=?m, person=3, number=sg] Conj[lemma=que] VP[form=inf]
  "hay que + infinitive: one has to (hay que estudiar)."

rule vp.haber-de: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n] -> Verb[class=haber, finite=?f, form=?fm, mood=?m, person=?p, number=?n] Prep[lemma=de] VP[form=inf]
  "haber de + infinitive: must, will (he de reconocer)."

rule vp.existential-perfect: VP[finite=?f, form=?fm, mood=?m, person=3, number=sg] -> Verb[class=haber, finite=?f, form=?fm, mood=?m, person=3, number=sg] Verb[class=haber, form=pastpart] NP[case=obl]
  "ha habido + a noun phrase: there has been (ha habido un accidente)."

# ------------------------------------------------- ser: what something is
#
# ser never stands as a plain verb: it says what the subject is (an
# adjective, a noun, a phrase with de, para, en…), forms the passive with an
# agreeing participle (fue construida), or is the ser of a question (¿Qué es
# eso?). So fue + a + place is ir, not ser.

rule serv.verb: SerV[finite=?f, form=?fm, mood=?m, person=?p, number=?n] -> Verb[class=ser, finite=?f, form=?fm, mood=?m, person=?p, number=?n]
  "ser."

rule serv.perfect: SerV[finite=?f, form=?fm, mood=?m, person=?p, number=?n] -> Verb[class=haber, finite=?f, form=?fm, mood=?m, person=?p, number=?n] Verb[class=ser, form=pastpart]
  "ser in a compound tense (ha sido, había sido)."

rule serv.proclitic: SerV[finite=yes, form=fin, mood=?m, person=?p, number=?n] -> Clitics[attached=no, reflexive=no, case=dat] SerV[form=fin, mood=?m, person=?p, number=?n]
  "A clitic for whom it is so (me es difícil, le fue imposible)."

rule serv.modal: SerV[finite=?f, form=?fm, mood=?m, person=?p, number=?n] -> V[lemma=poder|deber|soler|parecer|querer|desear|preferir|necesitar|esperar|pensar|intentar|lograr|conseguir|temer|odiar|amar|merecer, finite=?f, form=?fm, mood=?m, person=?p, number=?n] SerV[form=inf]
  "A verb that takes a bare infinitive, before ser (puede ser, debe ser, quiero ser)."

rule serv.modal-preposition: SerV[finite=?f, form=?fm, mood=?m, person=?p, number=?n] -> V[lemma=ir|acabar|volver|dejar|empezar|llegar, finite=?f, form=?fm, mood=?m, person=?p, number=?n] Prep[lemma=a|de] SerV[form=inf]
  "ir a ser, dejar de ser, llegar a ser."

rule serv.tener-que: SerV[finite=?f, form=?fm, mood=?m, person=?p, number=?n] -> V[lemma=tener, finite=?f, form=?fm, mood=?m, person=?p, number=?n] Conj[lemma=que] SerV[form=inf]
  "tener que ser."

rule vp.ser-possessive: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> SerV[finite=?f, form=?fm, mood=?m, person=?p, number=?n] PossAfter[number=?n, gender=?g]
  "ser + a stressed possessive says whose it is; it agrees with the subject (el libro es mío, las llaves son tuyas)."

rule vp.ser-clock: VP[finite=?f, form=?fm, mood=?m, person=3, number=sg] -> SerV[finite=?f, form=?fm, mood=?m, person=3, number=sg] Prep[lemma=a] Det[definite=yes, gender=f] Num
  "ser + a + a clock time: when an event is (la reunión fue a las cinco). Only a time: ser + a + a place is ir."

rule serv.progressive: SerV[finite=?f, form=?fm, mood=?m, person=?p, number=?n] -> Verb[class=estar|lex, lemma=estar|seguir|ir|andar|venir|continuar, finite=?f, form=?fm, mood=?m, person=?p, number=?n] Verb[class=ser, form=ger]
  "estar / seguir + siendo: ser in progress, for the passive and the copula (está siendo construida, sigue siendo difícil)."

rule vp.ser-lo: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n] -> Pron[attached=no, clitic=yes, case=acc, lemma=lo, gender=m, number=sg] SerV[finite=?f, form=?fm, mood=?m, person=?p, number=?n]
  "lo stands for a predicate already said (Ella lo es, lo fue)."

rule serv.enclitic: SerV[finite=no, form=?fm] -> Verb[class=ser, finite=no, form=inf|ger, form=?fm] Clitics[attached=yes, reflexive=no, case=dat]
  "A dative clitic attached to ser (puede serme útil, siéndole fiel)."

rule serv.negation: SerV[finite=?f, form=?fm, mood=?m, person=?p, number=?n] -> Adv[neg=yes] SerV[finite=?f, form=?fm, mood=?m, person=?p, number=?n]
  "no es, nunca fue."

rule vp.ser-adjective: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> SerV[finite=?f, form=?fm, mood=?m, person=?p, number=?n] AP[participle=no, number=?n, gender=?g]
  "ser + an adjective says what the subject is like; it agrees with the subject (la casa es bonita). A participle after ser is the passive instead."

rule vp.ser-noun: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> SerV[finite=?f, form=?fm, mood=?m, person=?p, number=?n] NP[case=nom|obl]
  "ser + a noun phrase says who or what the subject is (es un error, soy yo)."

rule vp.ser-phrase: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> SerV[finite=?f, form=?fm, mood=?m, person=?p, number=?n] PP[prep=de|para|en|por|con|sin|contra|entre|sobre|desde|hasta|como|según|durante]
  "ser + a phrase: origin, material, purpose, where or when an event is (es de Madrid, es para ti, la fiesta fue en casa); not a + place, which goes with ir."

rule vp.ser-adverb: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n] -> SerV[finite=?f, form=?fm, mood=?m, person=?p, number=?n] Adv[neg=no]
  "ser + an adverb (es así, fue ayer, es tarde)."

rule vp.ser-time: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n] -> SerV[finite=?f, form=?fm, mood=?m, person=?p, number=?n] TimeNP
  "ser + a time (fue la semana pasada)."

rule vp.ser-que: VP[finite=?f, form=?fm, mood=?m, person=3, number=sg] -> SerV[finite=?f, form=?fm, mood=?m, person=3, number=sg] Conj[lemma=que] S
  "es que…: the reason is that (es que no puedo)."

rule vp.ser-adjective-infinitive: VP[finite=?f, form=?fm, mood=?m, person=3, number=sg] -> SerV[finite=?f, form=?fm, mood=?m, person=3, number=sg] AP[participle=no] VP[form=inf]
  "ser + adjective + infinitive: the infinitive is the real subject (es difícil decirlo)."

rule vp.ser-adjective-que: VP[finite=?f, form=?fm, mood=?m, person=3, number=sg] -> SerV[finite=?f, form=?fm, mood=?m, person=3, number=sg] AP[participle=no] Conj[lemma=que] S
  "ser + adjective + que-clause (es posible que llueva, es mejor que vengas)."

rule vp.ser-noun-que: VP[finite=?f, form=?fm, mood=?m, person=3, number=sg] -> SerV[finite=?f, form=?fm, mood=?m, person=3, number=sg] NP Conj[lemma=que] S
  "ser + noun + que-clause (es hora de que…, es una pena que…)."

rule vp.ser-noun-infinitive: VP[finite=?f, form=?fm, mood=?m, person=3, number=sg] -> SerV[finite=?f, form=?fm, mood=?m, person=3, number=sg] NP VP[form=inf]
  "ser + noun + infinitive (es un placer conocerte)."

rule vp.ser-infinitive: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n] -> SerV[finite=?f, form=?fm, mood=?m, person=?p, number=?n] VP[form=inf]
  "ser + infinitive (lo importante es ganar, querer es poder)."

rule vp.passive: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> SerV[finite=?f, form=?fm, mood=?m, person=?p, number=?n] Verb[form=pastpart, drifted=no, number=?n, gender=?g]
  "ser + an agreeing past participle: the passive (fue construida, han sido vendidos, será publicado)."

rule vp.passive-adverb: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> SerV[finite=?f, form=?fm, mood=?m, person=?p, number=?n] AdvP Verb[form=pastpart, drifted=no, number=?n, gender=?g]
  "Adverbs between ser and the participle (fue muy criticado, fue muy bien recibido, es ampliamente usado)."

rule advp.one: AdvP -> Adv[neg=no]
  "An adverb."

rule advp.more: AdvP -> Adv[neg=no] AdvP
  "An adverb before another (muy bien, tan mal)."

# ------------------------------------------------- estar and other linking verbs
#
# estar + an agreeing participle is a state, an adjective use (la puerta
# está cerrada); so are quedar, parecer, resultar, seguir, andar, sentirse,
# verse, encontrarse and permanecer + participle.

rule cop.verb: Cop[lemma=?l, finite=?f, form=?fm, mood=?m, person=?p, number=?n] -> Verb[class=estar|lex, lemma=estar|parecer|quedar|resultar|seguir|andar|sentir|ver|encontrar|permanecer|mostrar|volver|poner|hacer|mantener|lucir|continuar, lemma=?l, finite=?f, form=?fm, mood=?m, person=?p, number=?n]
  "A linking verb: estar, parecer, quedar, resultar, seguir, sentirse, verse…"

rule cop.proclitic: Cop[lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n] -> Clitics[attached=no] Cop[lemma=?l, form=fin, mood=?m, person=?p, number=?n]
  "A clitic before the linking verb (me siento cansado, se quedó dormido, me parece bien)."

rule cop.enclitic: Cop[lemma=?l, finite=no, form=?fm] -> Verb[class=estar|lex, lemma=estar|quedar|sentir|ver|encontrar|volver|poner|hacer|mantener, lemma=?l, finite=no, form=inf|ger, form=?fm] Clitics[attached=yes, case=refl|dat]
  "A reflexive or dative clitic attached to an infinitive linking verb (estarle agradecido, quedarse quieto, sentirse solo)."

rule cop.perfect: Cop[lemma=?l, finite=?f, form=?fm, mood=?m, person=?p, number=?n] -> Verb[class=haber, finite=?f, form=?fm, mood=?m, person=?p, number=?n] Verb[class=estar|lex, lemma=estar|parecer|quedar|resultar|seguir|andar|sentir|ver|encontrar|permanecer|volver|poner|hacer, lemma=?l, form=pastpart]
  "A linking verb in a compound tense (ha estado, ha quedado)."

rule cop.perfect-proclitic: Cop[lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n] -> Clitics[attached=no] Verb[class=haber, finite=yes, mood=?m, person=?p, number=?n] Verb[class=estar|lex, lemma=quedar|sentir|ver|encontrar|volver|poner|hacer, lemma=?l, form=pastpart]
  "A clitic before a linking verb in a compound tense (se ha quedado, me he sentido)."

rule cop.modal: Cop[lemma=?l, finite=?f, form=?fm, mood=?m, person=?p, number=?n] -> V[lemma=poder|deber|soler|parecer|querer|desear|preferir|necesitar|esperar|pensar|intentar|lograr|conseguir|temer|odiar|merecer, finite=?f, form=?fm, mood=?m, person=?p, number=?n] Cop[lemma=?l, form=inf]
  "A modal before a linking verb (puede estar, debe estar)."

rule cop.progressive: Cop[lemma=?l, finite=?f, form=?fm, mood=?m, person=?p, number=?n] -> Verb[class=estar|lex, lemma=estar|seguir|andar|ir|venir, finite=?f, form=?fm, mood=?m, person=?p, number=?n] Cop[lemma=?l, form=ger]
  "A linking verb in progress keeps its complement (me estoy sintiendo cansado, se está poniendo nervioso)."

rule cop.negation: Cop[lemma=?l, finite=?f, form=?fm, mood=?m, person=?p, number=?n] -> Adv[neg=yes] Cop[lemma=?l, finite=?f, form=?fm, mood=?m, person=?p, number=?n]
  "no está, nunca estuvo."

rule vp.copula: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> Cop[finite=?f, form=?fm, mood=?m, person=?p, number=?n] AP[number=?n, gender=?g]
  "estar, parecer, quedar… + an adjective, which agrees with the subject; a participle here is a state, an adjective use (la puerta está cerrada)."

rule vp.copula-noun: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> Cop[lemma=parecer|resultar|seguir|volver|hacer|poner, finite=?f, form=?fm, mood=?m, person=?p, number=?n] NP[case=nom|obl]
  "parecer, resultar, seguir + a noun phrase (parece una buena idea, sigue siendo un niño)."

rule vp.copula-infinitive: VP[finite=?f, form=?fm, mood=?m, person=3, number=sg] -> Cop[lemma=parecer|resultar, finite=?f, form=?fm, mood=?m, person=3, number=sg] AP VP[form=inf]
  "parecer / resultar + adjective + infinitive (me resulta difícil creerlo)."

rule vp.copula-que: VP[finite=?f, form=?fm, mood=?m, person=3, number=sg] -> Cop[lemma=parecer|resultar|estar, finite=?f, form=?fm, mood=?m, person=3, number=sg] AP Conj[lemma=que] S
  "parecer / estar + adjective + que-clause (me parece raro que no venga, está claro que…)."

rule vp.parecer-que: VP[finite=?f, form=?fm, mood=?m, person=3, number=sg] -> Cop[lemma=parecer, finite=?f, form=?fm, mood=?m, person=3, number=sg] Conj[lemma=que] S
  "parece que…: it seems that."

rule vp.estar-adverb: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n] -> Cop[finite=?f, form=?fm, mood=?m, person=?p, number=?n] Adv[neg=no]
  "estar / quedar / sentirse + an adverb (está bien, me siento mal)."

rule vp.estar-phrase: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n] -> Cop[finite=?f, form=?fm, mood=?m, person=?p, number=?n] PP
  "estar / quedar + a phrase: where or how (está en casa, quedó en silencio)."

# ------------------------------------------------- adjective phrases

rule ap.adjective: AP[prenominal=no, participle=no, number=?n, gender=?g] -> Adj[participle=no, number=?n, gender=?g]
  "An adjective."

rule ap.participle: AP[prenominal=yes, participle=?l, number=?n, gender=?g, onset=?o] -> Verb[lemma=?l, form=pastpart, drifted=no, number=?n, gender=?g, onset=?o]
  "A past participle used like an adjective; it is still the verb's participle (la puerta cerrada: cerrar, participio). Not for adjectives whose meaning drifted (divertido)."

rule ap.adverb: AP[prenominal=no, participle=?x, number=?n, gender=?g] -> Adv[neg=no] AP[participle=?x, number=?n, gender=?g]
  "An adverb before an adjective (muy bonito, más alto, demasiado caro)."

rule ap.negation: AP[prenominal=no, participle=?x, number=?n, gender=?g] -> Adv[neg=yes] AP[participle=?x, number=?n, gender=?g]
  "no before an adjective (no muy lejos, nada fácil)."

rule ap.complement: AP[prenominal=no, participle=no, number=?n, gender=?g] -> AP[participle=no, number=?n, gender=?g] PP
  "A phrase after an adjective (lleno de gente, más alto que…, fácil de entender)."

rule ap.participle-complement: AP[prenominal=no, participle=?l, number=?n, gender=?g] -> AP[participle=?l, number=?n, gender=?g] PP[prep=de|con|a|en]
  "A participle used like an adjective can take a phrase too (cansado de esperar, cubierto de nieve, acostumbrado a…)."

rule ap.comparative: AP[prenominal=no, participle=no, number=?n, gender=?g] -> AP[participle=no, number=?n, gender=?g] Conj[lemma=que] NP
  "más / menos + adjective + que + noun phrase (más alto que tú)."

rule ap.como: AP[prenominal=no, participle=?x, number=?n, gender=?g] -> AP[participle=?x, number=?n, gender=?g] Prep[lemma=como] NP
  "tan + adjective + como (tan alto como su padre, blanco como la nieve)."

rule ap.coordination: AP[prenominal=no, participle=?x, number=?n, gender=?g] -> AP[participle=?x, number=?n, gender=?g] Conj[type=coord] AP[number=?n, gender=?g]
  "Two adjectives or participles joined by y, o or pero, agreeing with the noun (inteligente y práctico, abierta o cerrada, limpio y ordenado); the first decides whether the phrase is a participle."

# ------------------------------------------------- relative clauses

rule rel.subject: Rel -> RelPron[lemma=que|quien] VP[finite=yes, form=fin]
  "que + verb: the noun is the subject of that verb (el hombre que habla)."

rule rel.object: Rel -> RelPron[lemma=que] S
  "que + clause: the noun is that clause's object (el libro que leo)."

rule rel.preposition: Rel -> Prep RelPron[lemma=que|quien|cual|donde] S
  "preposition + que / quien (la chica con quien hablo, la casa en que vivo)."

rule rel.preposition-article: Rel -> Prep Det[definite=yes] RelPron[lemma=que|cual] S
  "preposition + article + que / cual (el tema del que hablamos, la razón por la cual)."

rule rel.copular: Rel -> RelPron[lemma=que] SerV
  "que + ser: the noun is ser's predicate (la persona que soy, lo que fue)."

rule rel.copular-subject: Rel -> RelPron[lemma=que] SerV NP[case=nom]
  "que + ser + subject (lo que es la vida)."

rule rel.where: Rel -> RelPron[lemma=donde] S
  "donde + clause (la ciudad donde vivo)."

rule rel.whose: Rel -> RelPron[lemma=que] VP[finite=yes, form=fin] NP
  "que + verb + its subject after it (el libro que escribió Juan)."

# ------------------------------------------------- questions

rule question.wh-adverb: S -> QAdv S
  "dónde, cuándo or cómo opens a question; the rest is an ordinary clause (¿Dónde lo has puesto?)."

rule question.wh-pronoun: S -> QPron S
  "qué, quién or cuál opens a question and stands for the missing subject or object (¿Quién viene? ¿Qué haces?)."

rule question.wh-phrase: S -> WhP S
  "A question phrase opens the question (¿Qué hora es? ¿Cuántos años tienes?)."

rule question.preposition: S -> Prep Wh S
  "A preposition + question word opens the question (¿Por qué lloras? ¿Con quién hablas?)."

rule question.preposition-adverb: S -> Prep QAdv S
  "A preposition + dónde (¿De dónde eres? ¿Hasta cuándo?)."

# A question clause whose question word stands for ser's or estar's
# predicate: it is used as a direct question and inside the sentence
# (no sé quién eres, no sé dónde está).

rule question.copular: S -> QS
  "A question about who, what, how or where something is (¿Quién eres? ¿Dónde está?)."

rule vp.indirect-question-copular: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> V[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] QS
  "A question about who, what or where something is, inside the sentence (no sé quién eres, no sé dónde está)."

rule qs.ser: QS -> Wh SerV
  "A question word + ser (¿Qué es? ¿Quién es? ¿Qué hora es?)."

rule qs.ser-subject: QS -> Wh SerV NP
  "A question word + ser + what is asked about (¿Qué es eso? ¿Cuál es tu nombre?)."

rule qs.adverb-ser: QS -> QAdv[lemma=cómo|dónde|cuándo] SerV NP
  "cómo / dónde + ser + subject (¿Cómo es tu casa? ¿Dónde es la fiesta?)."

rule qs.adverb-ser-bare: QS -> QAdv[lemma=cómo|dónde|cuándo] SerV
  "cómo / dónde + ser on its own (¿Cómo es? ¿Dónde fue?)."

rule qs.preposition-ser: QS -> Prep[lemma=de|desde|hasta|para] QAdv[lemma=dónde|cuándo] SerV
  "¿De dónde eres?"

rule qs.preposition-ser-subject: QS -> Prep[lemma=de|desde|hasta|para] QAdv[lemma=dónde|cuándo] SerV NP
  "¿De dónde es tu amigo?"

rule wh.pronoun: Wh -> QPron
  "A question pronoun."

rule wh.phrase: Wh -> WhP
  "A question phrase."

rule whp.determiner: WhP -> QDet[number=?n, gender=?g] Nom[number=?n, gender=?g]
  "qué, cuánto before a noun (qué hora, cuántos años)."

rule clause.exclamation: S -> QDet[lemma=qué] Nom
  "qué + noun as an exclamation (¡Qué lástima!)."

rule clause.exclamation-adjective: S -> QDet[lemma=qué] AP
  "qué + adjective as an exclamation (¡Qué bonito!)."

rule clause.ser-alone: S -> Adv SerV
  "así es, ya está: an adverb and ser."

rule clause.or-not: S -> S Conj[lemma=o] Intj[lemma=no]
  "… o no? asks for a yes or no."

# ------------------------------------------------- time expressions without a preposition

rule time.det-noun: TimeNP -> Det Noun[lemma=día|noche|mañana|tarde|semana|mes|año|hora|minuto|segundo|vez|verano|invierno|primavera|otoño|domingo|lunes|martes|miércoles|jueves|viernes|sábado|momento|rato|fin|siglo|década|temporada]
  "A time expression (cada día, esta mañana, el año pasado)."

rule time.numeral: TimeNP -> Num Noun[lemma=día|noche|semana|mes|año|hora|minuto|segundo|vez|siglo|década]
  "A number of days, hours, times (dos veces, tres años)."

rule time.predeterminer: TimeNP -> Predet TimeNP
  "todos los días, toda la noche."

rule time.adjective: TimeNP -> TimeNP AP
  "A time expression with an adjective (la semana pasada)."

rule time.hace: TimeNP -> Verb[lemma=hacer, person=3, number=sg, tense=pres|impf] TimeNP
  "hace + a time: ago (hace dos años)."

rule time.hace-adverb: TimeNP -> Verb[lemma=hacer, person=3, number=sg, tense=pres|impf] Adv[neg=no]
  "hace mucho, hace poco: long ago, a short while ago."

# ------------------------------------------------- more shapes

rule vp.indirect-question-wh-infinitive: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> V[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] Wh VP[form=inf]
  "qué / cuál + infinitive inside the sentence (no sé qué hacer)."

rule clause.infinitive-subject: S -> VP[form=inf] VP[finite=yes, person=3, number=sg]
  "An infinitive as the subject (Fumar mata, Viajar es caro)."

rule clause.infinitive-subject-after: S -> VP[finite=yes, form=fin, person=3, number=sg] VP[form=inf]
  "An infinitive as the subject after the verb (me gusta leer, ayuda saber que…, cuesta creerlo)."

rule np.infinitive: NP[person=3, number=sg, gender=m] -> Det[definite=yes, gender=m, number=sg] VP[form=inf]
  "el + infinitive: the action as a noun (el fumar, el comer)."

rule pp.al-infinitive: PP[prep=al] -> Prep[lemma=a] Det[definite=yes, gender=m, number=sg] VP[form=inf]
  "al + infinitive: when or as doing it (al llegar, al parecer)."

rule vp.depictive: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> V[lemma=nacer|morir|llegar|salir|volver|vivir|venir|regresar|despertar|dormir|acabar|terminar|caer|entrar|crecer|trabajar|estudiar|comer|beber|partir|aparecer, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] AP[number=?n, gender=?g]
  "An adjective or a participle used like one after a verb of coming, going, being born or dying says how the subject was (nació pobre, llegó cansada, llegó cargado de flores)."

rule np.focus: NP[person=?p, number=?n, gender=?g, case=?c] -> Focus NP[person=?p, number=?n, gender=?g, case=?c]
  "sólo, también, incluso or ni before a noun phrase (sólo culpa tuya, ni idea, incluso los niños)."

rule pp.focus: PP[prep=?l] -> Focus PP[prep=?l]
  "sólo, también or incluso before a phrase (sólo para ti)."

rule vp.focus: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> Focus VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g]
  "sólo, también or incluso before the verb (también quiero ir)."

rule qs.preposition-wh: QS -> Prep[lemma=de|para|con|desde|sobre|por|contra] Wh SerV
  "A preposition + question pronoun as ser's predicate (¿De quién es? ¿Para quién fue?)."

rule qs.preposition-wh-subject: QS -> Prep[lemma=de|para|con|desde|sobre|por|contra] Wh SerV NP
  "¿De quién es este libro?"

rule qs.estar: QS -> QAdv Cop[lemma=estar]
  "¿Cómo estás? ¿Dónde está?"

rule qs.estar-subject: QS -> QAdv Cop[lemma=estar] NP[case=nom]
  "¿Dónde está el agua? ¿Cómo está tu madre?"

rule partp.recent: PartP[number=?n, gender=?g] -> Adv[lemma=recién] Verb[form=pastpart, drifted=no, number=?n, gender=?g]
  "recién + participle says when it was done (pasto recién cortado)."

rule vp.passive-coordinated: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> SerV[finite=?f, form=?fm, mood=?m, person=?p, number=?n] Verb[form=pastpart, drifted=no, number=?n, gender=?g] Conj[type=coord] Verb[form=pastpart, drifted=no, number=?n, gender=?g]
  "One ser for two participles (fue torturado y asesinado)."

rule vp.passive-agent: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> SerV[finite=?f, form=?fm, mood=?m, person=?p, number=?n] Verb[form=pastpart, number=?n, gender=?g] PP[prep=por|como]
  "ser + participle + por + agent (or como + what) is the passive, also for a participle that is an adjective of its own (fue exagerado por los medios, ha sido considerado como un soñador)."

rule vp.ser-adverb-noun: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n] -> SerV[finite=?f, form=?fm, mood=?m, person=?p, number=?n] Adv[neg=no] NP[case=nom|obl]
  "ser + an adverb + a noun phrase (fue probablemente lo que…, es también un amigo)."

rule clause.phrase-last: S -> S Punct PP
  "A phrase after a comma at the end (Tome asiento, por favor)."

rule clause.adverb-last: S -> S Punct Adv
  "An adverb after a comma at the end (Lo siento, de verdad; Ven, rápido)."

rule clause.conj-first: S -> Conj[type=coord] S
  "pero, y or o opening the sentence links it to the one before (Pero yo adoro dormir)."

rule np.article-numeral-alone: NP[person=3, number=pl] -> Det[definite=yes, number=pl] Num
  "The article and a number: a time or the ones counted (a las diez, los dos)."

rule np.numeral-alone: NP[person=3] -> Num
  "A number on its own (tengo tres)."

rule np.every: NP[person=3, number=sg, gender=?g] -> Predet[number=sg, gender=?g] Nom[number=sg, gender=?g]
  "todo / toda + a noun without article: every (toda persona, todo hombre)."

rule pp.adverb-complement: PP[prep=?l] -> Prep[lemma=?l] Adv[neg=no]
  "A preposition before an adverb of place or time (de aquí, hacia atrás, hasta ahora, para siempre)."

rule pp.compound: PP[prep=?l] -> Adv[lemma=después|antes|cerca|lejos|dentro|fuera|encima|debajo|delante|detrás|además|alrededor|enfrente|acerca|luego|frente|junto|respecto] PP[prep=?l, prep=de|a]
  "An adverb + de or a forms a compound preposition (después de, antes de, cerca de, además de, junto a, frente a)."

rule vp.negative-after: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] Adv[neg=yes, lemma=nunca|jamás|tampoco]
  "nunca, jamás or tampoco after the verb, with no before it (no miente nunca)."

rule vp.clitic-todo: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> V[clitic_case=acc, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] Pron[lemma=todo]
  "lo + verb + todo: everything (el tiempo lo cura todo)."

rule vp.comparative: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] Adv[lemma=más|menos] Conj[lemma=que] NP
  "verb + más / menos que + someone (no valgo más que tú)."

rule pp.coordination: PP[prep=?l] -> PP[prep=?l] Conj[type=coord] PP[prep=?l]
  "Two phrases with the same preposition joined by y or o (en billetes o en monedas, a Madrid y a Roma)."

rule vp.coordination: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] Conj[type=coord] VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n]
  "Two verb phrases with one subject (canta y baila, ni sabe ni puede)."

rule np.article-adjective: NP[person=3, number=?n, gender=?g] -> Det[number=?n, gender=?g] AP[number=?n, gender=?g]
  "The article + an adjective stands for a person or thing (los pobres, el más alto, los rechazados)."

rule np.name-more: NP[person=3, number=sg] -> ProperNoun ProperNoun
  "A name of two words (Charles Dickens, Trygve Lie)."

rule np.que-infinitive: NP[person=?p, number=?n, gender=?g, case=?c] -> NP[person=?p, number=?n, gender=?g, case=?c] Conj[lemma=que] VP[form=inf]
  "nada / mucho / algo + que + infinitive: something to do (no hay nada que temer)."

rule clause.inverted: S -> V[finite=yes, form=fin, person=?p, number=?n] NP[case=nom, person=?p, number=?n] NP[case=obl]
  "verb + subject + object in a question (¿Tiene usted un fósforo?)."

rule vp.object-predicative-before: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> V[lemma=llevar|tener|tomar|dejar|pedir|coger, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] AP[number=?on, gender=?og] NP[case=obl, number=?on, gender=?og]
  "llevar puesto, tomar prestado + the object (lleva puesto un abrigo, tomó prestada una sierra)."

rule cop.enclitic-imperative: Cop[lemma=?l, finite=yes, form=fin, mood=imp, person=?p, number=?n] -> Verb[class=estar|lex, lemma=estar|quedar|mantener|sentir|poner|volver|hacer, lemma=?l, mood=imp|sub, person=?p, number=?n] Clitics[attached=yes, reflexive=yes, refl=?p]
  "A clitic attached to a linking verb's command (mantente alejado, quédate quieto)."

rule pp.gracias: PP[prep=a] -> Noun[lemma=gracia] PP[prep=a]
  "gracias a: thanks to (gracias a ti)."

rule ap.a-little: AP[prenominal=no, participle=?x, number=?n, gender=?g] -> Det[lemma=un] Noun[lemma=poco] AP[participle=?x, number=?n, gender=?g]
  "un poco + adjective: a little (un poco cansado)."

rule vp.a-little: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] Det[lemma=un] Noun[lemma=poco]
  "verb + un poco: a little (espera un poco)."

rule np.quien: NP[person=3, number=sg] -> RelPron[lemma=quien] VP[finite=yes, form=fin]
  "quien + verb: whoever (Quien sabe, hace)."

rule pp.adjective: PP[prep=?l] -> Prep[lemma=?l] Adj[participle=no, gender=m, number=sg]
  "A preposition + an adjective as a set phrase (de inmediato, por completo, de nuevo, en serio)."

rule nom.name-after: Nom[number=?n, gender=?g, onset=?o] -> Nom[number=?n, gender=?g, onset=?o] ProperNoun
  "A name after the noun (el monte Fuji, el río Amazonas)."

rule np.apposition: NP[person=?p, number=?n, gender=?g, case=?c] -> NP[person=?p, number=?n, gender=?g, case=?c] Punct NP
  "A noun phrase after a comma says the same again (un naipe, cualquier naipe)."

rule vp.passive-naming: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g] -> SerV[finite=?f, form=?fm, mood=?m, person=?p, number=?n] Verb[lemma=elegir|nombrar|llamar|considerar|declarar|proclamar|coronar, form=pastpart, number=?n, gender=?g] NP
  "ser elegido / nombrado / considerado + what the subject was made (fue elegido alcalde)."
