# Italian grammar, first version: simple clauses.
#
# Feature names: person 1/2/3, number sg/pl, gender m/f, case nom/obl/acc/dat/
# refl/gen/loc, finite yes/no, form inf/ger/pastpart/…, mood ind/sub/cnd/imp.
# A feature a word does not have (e.g. a noun's gender when the dictionary
# does not give it) is unknown and matches anything.
#
# takes_di yes/no: the verb takes a di phrase (data/it/di-verbs.tsv).
# takes_a yes/no: the verb takes an a phrase as its indirect object
# (data/it/dative-verbs.tsv).
# utterance yes/no: the noun is a sentence without an article
# (data/it/bare-utterance-nouns.tsv). prep: a
# prepositional phrase's preposition. partitive yes: del pane, dei ragazzi.

start Text

# -------------------------------------------------------------- sentences
#
# A sentence is a clause, or a noun phrase without a verb: an exclamation, a
# title, a list. Both are returned when both fit (La veste di seta per mia
# moglie! is a dress of silk and "he dresses her in silk").

rule text.clause: Text -> S
  "A sentence with a verb."

rule text.fragment: Text -> Frag
  "A sentence without a verb."

rule frag.noun-phrase: Frag -> NP[case=nom]
  "A noun phrase on its own is a sentence: an exclamation or a title (La forza del destino!)."

rule frag.bare-adjective: Frag -> Adj[utterance=yes, number=?n, gender=?g] Nom[number=?n, gender=?g]
  "A few adjectives make the noun after them a sentence without an article: wishes and pity (Buon viaggio!, Povero diavolo!)."

rule frag.bare-noun: Frag -> Nom[utterance=yes]
  "A few nouns are a sentence without an article: thanks, wishes, greetings, reactions, insults and endearments (Grazie per il vostro invito!, Pazienza!, Pezzo d'asino!, Tesoro mio!, Buon viaggio!). They are listed in data/it/bare-utterance-nouns.tsv."

rule frag.list: Frag -> Frag Punct[lemma=;|:] NP
  "After ; or : another noun phrase: the next item of a list, or a new name for what came before (La rovina in due case; lo scompiglio in tutto il paesello)."

# Roles (subject, verb, direct-object, indirect-object, subject-complement,
# object-complement, agent, adverbial) are marked on a rule's children:
# `NP[case=nom]:subject`. A word takes the role of the innermost marked phrase
# that holds it. A clitic pronoun marked `:case` takes its role from its case:
# lo/la/li/le (acc) are direct objects, gli/le (dat) indirect objects, ci/vi of
# place (loc) adverbials; a reflexive (refl) or ne (gen) has none of its own
# and belongs to the verb group.
case-roles acc=direct-object, dat=indirect-object, loc=adverbial

# ---------------------------------------------------------------- clauses

rule clause.subject: S -> NP[case=nom, person=?p, number=?n, gender=?g]:subject VP[finite=yes, person=?p, number=?n, gender=?g]
  "The verb agrees with its subject in person and number."

rule clause.null-subject: S -> VP[finite=yes]
  "Italian can leave the subject out: the verb ending says who acts."

rule clause.coordination: S -> S Conj[type=coord] S
  "Two clauses joined by e, ma or o."

# ---------------------------------------------------------- noun phrases

rule np.name: NP[person=3, number=sg, gender=?g] -> ProperNoun[gender=?g]
  "A name is a third-person singular noun phrase."

rule np.pronoun: NP[person=?p, number=?n, gender=?g, case=?c] -> Pron[clitic=no, person=?p, number=?n, gender=?g, case=?c]
  "A stressed pronoun stands on its own as a noun phrase."

rule np.article: NP[person=3, number=?n, gender=?g] -> Det[number=?n, gender=?g, next=?o] Nom[number=?n, gender=?g, onset=?o]
  "The article agrees with its noun in gender and number, and its form follows the next word's first sound: il/i/un before a consonant (il cane), lo/gli/uno before s + consonant, z, gn, ps (lo zio, lo studente), l'/gli before a vowel (l'amico)."

rule np.partitive: NP[person=3, number=?n, gender=?g, partitive=yes] -> PartNP[number=?n, gender=?g]
  "A partitive is a noun phrase (mangio del pane)."

rule partnp.article: PartNP[number=?n, gender=?g] -> Prep[lemma=di] Det[definite=yes, number=?n, gender=?g, next=?o] Nom[number=?n, gender=?g, onset=?o]
  "di + the definite article before a noun means 'some': the partitive article (del pane, delle cose)."

rule partnp.everything: PartNP[number=sg] -> Prep[lemma=di] Pron[lemma=tutto, number=sg, case=obl]
  "di tutto: a bit of everything (mangia di tutto, c'è di tutto)."

rule partnp.relative: PartNP[number=?n, gender=?g] -> PartNP[number=?n, gender=?g] Rel
  "A clause with che or cui describes the partitive's noun (dei ragazzi che giocano)."

rule np.numeral: NP[person=3, number=pl, gender=?g] -> Num Nom[number=pl, gender=?g]
  "A number before a plural noun."

rule nom.noun: Nom[number=?n, gender=?g, onset=?o, utterance=?u] -> Noun[number=?n, gender=?g, onset=?o, utterance=?u]
  "A noun."

rule nom.adjective-after: Nom[number=?n, gender=?g, onset=?o, utterance=?u] -> Nom[number=?n, gender=?g, onset=?o, utterance=?u] AP[number=?n, gender=?g]
  "An adjective after its noun agrees with it in gender and number."

rule nom.adjective-before: Nom[number=?n, gender=?g, onset=?o, utterance=?u] -> Adj[number=?n, gender=?g, onset=?o] Nom[number=?n, gender=?g, utterance=?u]
  "An adjective before its noun agrees with it in gender and number."

# ------------------------------------------------- prepositional phrases

rule pp.basic: PP[prep=?x, infinitive=no] -> Prep[lemma=?x] NP[case=obl]
  "A preposition takes a noun phrase (di + il = del, a + la = alla)."

# --------------------------------------------- the verb and its clitics
#
# Clitics carries two features for the verb to check: `refl`, the person of a
# reflexive clitic (it must be the verb's person: ti ricordi, ricordati), and
# `obj`, the person of a 1st or 2nd person clitic that is not reflexive (it
# must differ from the verb's: mi dai, but not *mi do for "I give me").

rule v.plain: V[lemma=?l, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta] -> Verb[lemma=?l, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta]
  "A verb."

rule cop.verb: Cop[mood=?m, person=?p, number=?n, takes_di=?d, takes_a=?ta] -> Verb[lemma=essere|sembrare|diventare|restare|rimanere|stare, finite=yes, mood=?m, person=?p, number=?n, takes_di=?d, takes_a=?ta]
  "A linking verb: essere, sembrare, diventare, restare, rimanere, stare."

rule cop.adverb: Cop[mood=?m, person=?p, number=?n, takes_di=?d, takes_a=?ta] -> Cop[mood=?m, person=?p, number=?n, takes_di=?d, takes_a=?ta] Adv[neg=no]:adverbial
  "An adverb right after the linking verb (è solo, è molto)."

rule v.adverb-after: V[lemma=?l, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta] -> V[lemma=?l, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta] Adv[neg=no]:adverbial
  "An adverb right after the verb (è solo, parla bene, ho già)."

rule v.perfect-avere-adverb: V[aux=avere, lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, takes_di=?d, takes_a=?ta, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> Verb[lemma=avere, finite=yes, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Adv[neg=no]:adverbial Verb[lemma=?l, form=pastpart, takes_avere=yes, takes_di=?d, takes_a=?ta]
  "An adverb between avere and the participle (ho già fatto, non ho mai visto)."

rule v.perfect-essere-adverb: V[aux=essere, lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> Verb[lemma=essere, finite=yes, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Adv[neg=no]:adverbial Verb[lemma=?l, form=pastpart, takes_essere=yes, number=?n, gender=?g, takes_di=?d, takes_a=?ta]
  "An adverb between essere and the participle (è già partita)."

rule v.proclitic: V[lemma=?l, clitic_case=?k, finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta] -> Clitics[attached=no, case=?k, refl=?r, obj=?o] Verb[lemma=?l, form=fin, mood=ind|sub|cnd, person=?p, number=?n, gender=?g, person=?r, person!=?o, takes_di=?d, takes_a=?ta]
  "Clitic pronouns go before a conjugated verb (me lo dà)."

rule v.enclitic-nonfinite: V[clitic_case=?k, finite=no, form=?fm, takes_di=?d, takes_a=?ta] -> Verb[finite=no, form=?fm, takes_di=?d, takes_a=?ta] Clitics[attached=yes, case=?k]
  "Clitic pronouns attach to the end of an infinitive or gerund (prenderlo, prendendolo)."

rule v.enclitic-imperative: V[clitic_case=?k, finite=yes, form=fin, mood=imp, person=?p, number=?n, takes_di=?d, takes_a=?ta] -> Verb[mood=imp, person=?p, number=?n, takes_di=?d, takes_a=?ta] Clitics[attached=yes, case=?k, refl=?p, obj!=?p]
  "Clitic pronouns attach to the end of an affirmative imperative (dammelo, ricordati)."

rule v.perfect-avere: V[aux=avere, lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, takes_di=?d, takes_a=?ta, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> Verb[lemma=avere, finite=yes, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Verb[lemma=?l, form=pastpart, takes_avere=yes, takes_di=?d, takes_a=?ta]
  "A compound tense with avere, for verbs that take avere: avere + past participle (ho fatto)."

rule v.perfect-essere: V[aux=essere, lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> Verb[lemma=essere, finite=yes, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Verb[lemma=?l, form=pastpart, takes_essere=yes, number=?n, gender=?g, takes_di=?d, takes_a=?ta]
  "A compound tense with essere, for verbs that take essere (arrivare, salire, andare): the participle agrees with the subject (è arrivata, sono salite)."

rule v.passive-venire: V[aux=essere, lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf, voice=passive] -> Verb[lemma=venire, finite=yes, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Verb[lemma=?l, form=pastpart, takes_avere=yes, number=?n, gender=?g, takes_di=?d, takes_a=?ta]
  "The passive with venire + past participle: always an action (vennero bruciate, vengono pulite)."

rule v.passive-event: V[aux=essere, lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf, voice=passive] -> Verb[lemma=essere, finite=yes, tense=pret|fut, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Verb[lemma=?l, form=pastpart, takes_avere=yes, number=?n, gender=?g, takes_di=?d, takes_a=?ta]
  "The passive with essere in the passato remoto or the future: an event, not a state (furono bruciate, sarà comunicato)."

rule v.passive-perfect: V[aux=essere, lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf, voice=passive] -> Verb[lemma=essere, finite=yes, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Verb[lemma=essere, form=pastpart, number=?n, gender=?g] Verb[lemma=?l, form=pastpart, takes_avere=yes, number=?n, gender=?g, takes_di=?d, takes_a=?ta]
  "The passive in a compound tense: è stato + participle (è stato bloccato, sono state vendute)."

rule v.perfect-infinitive: V[finite=no, form=inf, takes_di=?d, takes_a=?ta, aux_mood=?auxm, aux_tense=?auxt, aux_person=?auxp, aux_number=?auxn, aux_form=?auxf] -> Verb[lemma=avere|essere, form=inf, mood=?auxm, tense=?auxt, person=?auxp, number=?auxn, form=?auxf] Verb[form=pastpart, takes_di=?d, takes_a=?ta]
  "The perfect infinitive: avere or essere + past participle (di aver commesso, dopo essere arrivato)."

rule v.progressive: V[lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, takes_di=?d, takes_a=?ta, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf, aux_progressive=yes] -> Verb[lemma=stare, finite=yes, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Verb[lemma=?l, form=ger, takes_di=?d, takes_a=?ta]
  "stare + gerund: an action in progress (stanno crescendo)."

rule v.proclitic-progressive: V[lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, takes_di=?d, takes_a=?ta, aux_mood=?m, aux_tense=?auxt, aux_person=?r, aux_number=?n, aux_form=?auxf, aux_progressive=yes] -> Clitics[attached=no, refl=?r, obj=?o] Verb[lemma=stare, finite=yes, mood=?m, person=?p, number=?n, person=?r, person!=?o, tense=?auxt, form=?auxf] Verb[lemma=?l, form=ger, takes_di=?d, takes_a=?ta]
  "Clitics before stare + gerund (lo sto facendo)."

rule v.proclitic-perfect-avere-adverb: V[aux=avere, lemma=?l, clitic_case=?k, finite=yes, form=fin, mood=?m, person=?p, number=?n, takes_di=?d, takes_a=?ta, aux_mood=?m, aux_tense=?auxt, aux_person=?r, aux_number=?n, aux_form=?auxf] -> Clitics[attached=no, case=?k, refl=?r, obj=?o] Verb[lemma=avere, finite=yes, mood=?m, person=?p, number=?n, person=?r, person!=?o, tense=?auxt, form=?auxf] Adv[neg=no]:adverbial Verb[lemma=?l, form=pastpart, takes_avere=yes, takes_di=?d, takes_a=?ta]
  "Clitic pronouns before avere in a compound tense (l'ho fatto, mi hai quasi ucciso)."

rule v.proclitic-perfect-essere-adverb: V[aux=essere, lemma=?l, clitic_case=?k, finite=yes, form=fin, mood=?m, person=?p, number=?n, takes_di=?d, takes_a=?ta, aux_mood=?m, aux_tense=?auxt, aux_person=?r, aux_number=?n, aux_form=?auxf] -> Clitics[attached=no, reflexive=no, case=?k, refl=?r, obj=?o] Verb[lemma=essere, finite=yes, mood=?m, person=?p, number=?n, person=?r, person!=?o, tense=?auxt, form=?auxf] Adv[neg=no]:adverbial Verb[lemma=?l, form=pastpart, takes_essere=yes, takes_di=?d, takes_a=?ta]
  "Clitic pronouns before essere in a compound tense of an essere verb (ci sono andato, ne sono uscita)."

rule v.reflexive-perfect-adverb: V[aux=essere, lemma=?l, clitic_case=?k, finite=yes, form=fin, mood=?m, person=?p, number=?n, takes_di=?d, takes_a=?ta, aux_mood=?m, aux_tense=?auxt, aux_person=?r, aux_number=?n, aux_form=?auxf] -> Clitics[attached=no, reflexive=yes, case=?k, refl=?r, obj=?o] Verb[lemma=essere, finite=yes, mood=?m, person=?p, number=?n, person=?r, person!=?o, tense=?auxt, form=?auxf] Adv[neg=no]:adverbial Verb[lemma=?l, form=pastpart, takes_di=?d, takes_a=?ta]
  "A reflexive verb takes essere in compound tenses, whatever its own auxiliary (mi sono alzato, si è svolta)."

rule v.proclitic-perfect-avere: V[aux=avere, lemma=?l, clitic_case=?k, finite=yes, form=fin, mood=?m, person=?p, number=?n, takes_di=?d, takes_a=?ta, aux_mood=?m, aux_tense=?auxt, aux_person=?r, aux_number=?n, aux_form=?auxf] -> Clitics[attached=no, case=?k, refl=?r, obj=?o] Verb[lemma=avere, finite=yes, mood=?m, person=?p, number=?n, person=?r, person!=?o, tense=?auxt, form=?auxf] Verb[lemma=?l, form=pastpart, takes_avere=yes, takes_di=?d, takes_a=?ta]
  "Clitic pronouns before avere in a compound tense (l'ho fatto)."

rule v.proclitic-perfect-essere: V[aux=essere, lemma=?l, clitic_case=?k, finite=yes, form=fin, mood=?m, person=?p, number=?n, takes_di=?d, takes_a=?ta, aux_mood=?m, aux_tense=?auxt, aux_person=?r, aux_number=?n, aux_form=?auxf] -> Clitics[attached=no, reflexive=no, case=?k, refl=?r, obj=?o] Verb[lemma=essere, finite=yes, mood=?m, person=?p, number=?n, person=?r, person!=?o, tense=?auxt, form=?auxf] Verb[lemma=?l, form=pastpart, takes_essere=yes, takes_di=?d, takes_a=?ta]
  "Clitic pronouns before essere in a compound tense of an essere verb (ci sono andato, ne sono uscita)."

rule v.reflexive-perfect: V[aux=essere, lemma=?l, clitic_case=?k, finite=yes, form=fin, mood=?m, person=?p, number=?n, takes_di=?d, takes_a=?ta, aux_mood=?m, aux_tense=?auxt, aux_person=?r, aux_number=?n, aux_form=?auxf] -> Clitics[attached=no, reflexive=yes, case=?k, refl=?r, obj=?o] Verb[lemma=essere, finite=yes, mood=?m, person=?p, number=?n, person=?r, person!=?o, tense=?auxt, form=?auxf] Verb[lemma=?l, form=pastpart, takes_di=?d, takes_a=?ta]
  "A reflexive verb takes essere in compound tenses, whatever its own auxiliary (mi sono alzato, si è svolta)."

rule clitics.reflexive: Clitics[reflexive=yes, attached=?a, refl=?p, case=?k] -> Pron[attached=?a, clitic=yes, combining=no, case=?k, case=refl, person=?p]:case
  "A reflexive clitic: the action falls back on the subject (ricordati, mi lavo)."

rule clitics.local: Clitics[reflexive=no, attached=?a, obj=?p, case=?k] -> Pron[attached=?a, clitic=yes, combining=no, case=?k, case=acc|dat, person=1|2, person=?p]:case
  "A 1st or 2nd person clitic pronoun (mi, ti, ci, vi)."

rule clitics.other: Clitics[reflexive=no, attached=?a, case=?k] -> Pron[attached=?a, clitic=yes, combining=no, case=?k, case=acc|dat|gen|loc, person=3]:case
  "A clitic pronoun: lo, la, li, le, gli, ne, ci."

rule clitics.two-reflexive: Clitics[reflexive=yes, attached=?a, refl=?p, case=?k] -> Pron[attached=?a, clitic=yes, combining=yes, case=refl, person=?p]:case Pron[clitic=yes, case=?k, case=acc|gen]:case
  "A reflexive clitic before lo/la/li/le/ne turns into me, te, se, ce, ve (andarsene, me lo ricordo)."

rule clitics.two-local: Clitics[reflexive=no, attached=?a, obj=?p, case=?k] -> Pron[attached=?a, clitic=yes, combining=yes, case=dat, person=1|2, person=?p]:case Pron[clitic=yes, case=?k, case=acc|gen]:case
  "Two clitics: the indirect one comes first and turns into me, te, ce or ve (dammelo, te lo do)."

rule clitics.two-other: Clitics[reflexive=no, attached=?a, case=?k] -> Pron[attached=?a, clitic=yes, combining=yes, case=dat|loc, person=3]:case Pron[clitic=yes, case=?k, case=acc|gen]:case
  "Two clitics: gli/le before lo/la/li/le/ne fuse into glie- (glielo), ci becomes ce (ce n'è)."

# ----------------------------------------------------------- verb phrases

rule vp.verb: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta] -> V[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta]:verb
  "A verb on its own."

rule vp.object: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta] -> V[aux=avere, clitic_case=dat|refl|gen|loc, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta]:verb NP[case=obl]:direct-object
  "The verb takes a direct object, unless lo/la/li/le already is its object (l'ho fatto, not *l'ho un fatto)."

rule vp.infinitive: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta] -> V[lemma=volere|potere|dovere|sapere|solere|fare|lasciare|sentire|vedere|udire|guardare|ascoltare|osservare|preferire|desiderare|osare|amare|odiare|adorare|piacere|bisognare|occorrere|sembrare|parere, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta]:verb VP[form=inf]
  "A verb followed by an infinitive without a preposition: modal, perception and causative verbs and a few others (voglio partire, lo vedo arrivare, fammi sapere)."

rule vp.preposition-infinitive: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta] -> V[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta]:verb Prep[lemma=a|di|da] VP[form=inf]
  "A verb followed by a, di or da and an infinitive (riusciva a trovare, ha deciso di partire)."

rule vp.che-clause: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta] -> V[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta]:verb Conj[lemma=che] S
  "The verb introduces a clause with che (disse che…)."

rule vp.copula: VP[finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta] -> Cop[mood=?m, person=?p, number=?n, takes_di=?d, takes_a=?ta]:verb AP[participle_essere=no, number=?n, gender=?g]:subject-complement
  "With essere, sembrare, diventare, restare, rimanere or stare, the adjective agrees with the subject in gender and number (la casa è bella). A participle here is a state (le luci sono accese) only for verbs that take avere; for an essere verb it is a compound tense (sono salite)."

rule vp.copula-noun: VP[finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta] -> Cop[mood=?m, person=?p, number=?n, takes_di=?d, takes_a=?ta]:verb NP[case=nom|obl]:subject-complement
  "essere + a noun phrase says what the subject is (è un graffio)."

rule vp.prepositional-phrase: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta] -> VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta] PP[prep!=di]:adverbial
  "A prepositional phrase adds where, when, for whom or how. Not one with di: that one belongs to the noun before it (la porta di casa), or the verb takes it (parlare di)."

rule vp.di-complement: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=yes, takes_a=?ta] -> VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=yes, takes_a=?ta] PP[prep=di, infinitive=no]:adverbial
  "A verb that takes di: what it is about, made of, full of or caused by (parlare di te, vestire di seta, riempire di vino, morire di fame). The verbs are listed in data/it/di-verbs.tsv."

rule vp.a-indirect-object: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=yes] -> VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=yes] PP[prep=a, infinitive=no]:indirect-object
  "A verb that takes an indirect object: a + whom it is given, told, shown or done to, or who it pleases (ho dato il libro a Maria, ho detto la verità al ragazzo, telefono a Maria, il film piace a Marco). A dative pronoun can stand for it (le ho dato il libro). The verbs are listed in data/it/dative-verbs.tsv; the a phrase can still say where or when, so both readings are returned."

rule vp.di-infinitive: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta] -> VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta] PP[prep=di, infinitive=yes]:adverbial
  "di + infinitive after the verb and its complements (ho detto a Tom di venire)."

rule vp.di-adverbial: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta] -> VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta] DiAdv:adverbial
  "A fixed phrase with di says when or how, after any verb (esce di notte, corre di fretta, lo fa di nuovo)."

rule vp.yes-no: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta] -> V[lemma=dire|pensare|credere|sperare|rispondere|temere|parere|sembrare|fare|decidere|giurare|dubitare|immaginare|supporre|ritenere, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta]:verb Prep[lemma=di]:direct-object Intj[lemma=sì|no]:direct-object
  "di sì, di no after a verb of saying, thinking or hoping (penso di sì, ha detto di no, mi sembra di sì)."

rule vp.adverb-di: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta] -> VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta] Adv[lemma=più|meno|prima|dopo|fuori|dentro|dietro|invece|oltre]:adverbial PP[prep=di]:adverbial
  "An adverb with its own di phrase after the verb (lavora più di me, parte prima di cena, chiude la porta dietro di sé)."

rule diadv.noun: DiAdv -> Prep[lemma=di] DiNoun
  "di + a time or manner noun (di notte, d'estate, di corsa, di fretta, di colpo, d'accordo, di cuore, di moda, di gusto, di passaggio, di conseguenza, di regola, di fatto)."

rule dinoun.noun: DiNoun[number=?n, gender=?g] -> Noun[number=?n, gender=?g, lemma=notte|giorno|sera|mattina|mattino|pomeriggio|estate|inverno|primavera|autunno|domenica|lunedì|martedì|mercoledì|giovedì|venerdì|sabato|corsa|fretta|colpo|scatto|seguito|solito|continuo|accordo|cuore|proposito|persona|fronte|fianco|moda|stucco|sorpresa|gusto|voglia|getto|passaggio|ritorno|fila|traverso|sfuggita|soppiatto|conseguenza|fatto|regola|norma|grado|botto|lato|soprassalto|sbieco|riflesso|lena|furia|slancio|galoppo|carriera|passo|petto|spalla|profilo|striscio|sbalzo|rimbalzo|malavoglia|pianta]
  "A noun of such a phrase."

rule dinoun.adjective-before: DiNoun[number=?n, gender=?g] -> Adj[number=?n, gender=?g] DiNoun[number=?n, gender=?g]
  "It can take an adjective before it (di comune accordo, di buon cuore)."

rule dinoun.adjective-after: DiNoun[number=?n, gender=?g] -> DiNoun[number=?n, gender=?g] AP[number=?n, gender=?g]
  "Or an adjective after it (di notte fonda)."

rule diadv.out-of: DiAdv -> Prep[lemma=di] Noun[lemma=casa|mano|bocca|occhio|mezzo|torno|dosso|vista]
  "di + a bare noun: out of, away from (uscire di casa, cadere di mano, perdere d'occhio, togliersi di mezzo)."

rule diadv.adjective: DiAdv -> Prep[lemma=di] Adj[gender=m, number=sg, lemma=nuovo|solito|sicuro|certo|rado|recente|frequente|continuo]
  "di + an adjective as a fixed phrase (di nuovo, di solito, di sicuro, di rado)."

rule diadv.participle: DiAdv -> Prep[lemma=di] Verb[lemma=nascondere, form=pastpart, gender=m, number=sg]
  "di nascosto: secretly."

rule diadv.adverb: DiAdv -> Prep[lemma=di] Adv[lemma=più|meno|nuovo|sicuro|certo|continuo|solito|qua|là|sopra|sotto]
  "di + an adverb (di più, di meno, di qua, di sopra)."


rule diadv.from-to: DiAdv -> Prep[lemma=di] Nom Prep[lemma=in] Nom
  "di … in …: from one to the next (di fiore in fiore, di casa in casa)."

rule diadv.now-and-then: DiAdv -> Prep[lemma=di] Adv[lemma=tanto] Prep[lemma=in] Adv[lemma=tanto]
  "di tanto in tanto: now and then."

rule diadv.now-and-then-quando: DiAdv -> Prep[lemma=di] QAdv[lemma=quando] Prep[lemma=in] QAdv[lemma=quando]
  "di quando in quando: now and then."

rule vp.adverb: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta] -> VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta] Adv[neg=no]:adverbial
  "An adverb after the verb."

rule vp.negation: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta] -> Adv[lemma=non]:adverbial VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta]
  "non goes right before the verb and its clitics."

# ------------------------------------------------- adjective phrases

rule ap.adjective: AP[participle=?x, participle_di=no, number=?n, gender=?g] -> Adj[participle=?x, number=?n, gender=?g]
  "An adjective."

rule ap.participle: AP[participle=?l, participle_essere=?e, participle_di=?d, number=?n, gender=?g] -> Verb[lemma=?l, form=pastpart, drifted=no, takes_essere=?e, takes_di=?d, number=?n, gender=?g]
  "A past participle used like an adjective; it is still the verb's participle (le luci accese: accendere, participio passato). Not for adjectives whose meaning drifted (esatto)."

rule ap.present-participle: AP[participle=?l, participle_di=no, number=?n, gender=?g] -> Verb[lemma=?l, form=prespart, number=?n, gender=?g]
  "A present participle used like an adjective, a state (il treno fuggente: fuggire, participio presente); with the verb's complements it is a participle phrase instead (tremanti nel vento)."

rule ap.adverb: AP[participle_di=no, number=?n, gender=?g] -> Adv[neg=no] AP[number=?n, gender=?g]
  "An adverb before an adjective (molto bello, più alto, troppo caro)."

rule ap.complement: AP[participle_di=no, number=?n, gender=?g] -> AP[participle=no, number=?n, gender=?g] PP
  "A phrase after an adjective (pieno di gente, più alto di te). After a participle the phrase makes it a participle phrase instead (scritto in inglese)."

rule ap.participle-di: AP[participle_essere=?e, participle_di=no, number=?n, gender=?g] -> AP[participle_essere=?e, participle_di=yes, number=?n, gender=?g] PP[prep=di, infinitive=no]
  "A participle used like an adjective keeps the di phrase its verb takes (rimane circondata di gente, il cielo è coperto di nuvole)."

# ------------------------------------------------- more noun phrases

rule np.possessive: NP[person=3, number=?n, gender=?g] -> Det[number=?n, gender=?g, next=?o] Poss[number=?n, gender=?g, onset=?o] Nom[number=?n, gender=?g]
  "Article + possessive + noun; the possessive agrees with the noun, not the owner (la sua casa)."

rule np.possessive-bare: NP[person=3, number=?n, gender=?g] -> Poss[number=?n, gender=?g] Nom[number=?n, gender=?g]
  "A possessive without an article, as with a singular family noun (mia madre)."

rule nom.possessive-after: Nom[number=?n, gender=?g, onset=?o, utterance=?u] -> Nom[number=?n, gender=?g, onset=?o, utterance=?u] Poss[number=?n, gender=?g]
  "A possessive after the noun (a casa mia)."

rule np.predeterminer: NP[person=3, number=?n, gender=?g] -> Predet[number=?n, gender=?g] NP[number=?n, gender=?g]
  "tutto before the article agrees with the noun (tutti i giorni, tutta la notte)."

rule np.bare: NP[case=obl, person=3, number=?n, gender=?g] -> Nom[number=?n, gender=?g]
  "A noun without an article, as an object or after a preposition (ho fame, mangio mele, prendo spunto); not as a subject."

rule np.coordination: NP[number=pl] -> NP Conj[type=coord, lemma=e|o|ma|né|oppure|ossia|ovvero|nonché] NP
  "Two noun phrases joined by e, o, ma (Tom e Mary, io e lui). Only these and nonché: a word the dictionary calls a conjunction without saying which kind (quasi, pure) does not join noun phrases."

rule nom.prepositional-phrase: Nom[number=?n, gender=?g, onset=?o, utterance=?u] -> Nom[number=?n, gender=?g, onset=?o, utterance=?u] PP
  "A phrase with a preposition describes the noun (la casa di Tom, il libro sul tavolo). After a participle it can also describe the noun, so un suono soffocato di pianti is both a muffled sound of crying and a sound suffocated by crying."

rule np.relative: NP[person=?p, number=?n, gender=?g, case=?c] -> NP[person=?p, number=?n, gender=?g, case=?c, partitive=no] Rel
  "A clause with che or cui describes the noun (il libro che leggo); for a partitive, partnp.relative."

rule rel.subject: Rel -> RelPron[lemma=che] VP[finite=yes, form=fin]
  "che + verb: the noun is the subject of that verb (l'uomo che parla)."

rule rel.object: Rel -> RelPron[lemma=che] S
  "che + clause: the noun is that clause's object (il libro che leggo)."

rule rel.cui: Rel -> Prep RelPron[lemma=cui] S
  "preposition + cui (il modo in cui canti, la ragazza di cui parlo)."

rule np.more-than: NP[person=3, number=?n, gender=?g] -> Adv[lemma=più|meno] Prep[lemma=di] NP[case=obl, number=?n, gender=?g]
  "più di or meno di before a quantity (più di cento persone, in meno di trenta minuti)."

rule pp.di-pronoun: PP[prep=?x, infinitive=no] -> Prep[lemma=?x, lemma=verso|su|sopra|sotto|contro|dietro|dentro|entro|senza|presso|dopo|prima|fuori|oltre] Prep[lemma=di] Pron[clitic=no, case=obl]
  "Some prepositions take di before a stressed pronoun (verso di te, su di me, contro di lui, dietro di sé)."

rule np.pronoun-of: NP[person=3, number=?n, gender=?g, case=?c] -> Pron[clitic=no, lemma=qualcosa|niente|nulla|qualcuno|nessuno|ognuno|ciascuno|uno|alcuno|quello|questo|molto|tanto|poco|altro, number=?n, gender=?g, case=?c] PP[prep=di, infinitive=no]
  "A pronoun with di + a noun phrase: which of them, or what of it (ciascuno di noi, quello di Tom, nulla del suo passato)."

rule np.indefinite-adjective: NP[person=3, number=sg, case=?c] -> Pron[clitic=no, lemma=qualcosa|niente|nulla|qualcuno|nessuno, case=?c] Prep[lemma=di] AP[number=sg, gender=m]
  "qualcosa, niente, nulla + di + an adjective (qualcosa di nuovo, nulla di sospetto)."

rule pp.bare: PP[prep=?x, infinitive=no] -> Prep[lemma=?x] Nom
  "A preposition before a noun without an article (a casa, in macchina, con piacere)."

rule pp.infinitive: PP[prep=?x, infinitive=yes] -> Prep[lemma=?x] VP[form=inf]
  "A preposition before an infinitive (per fare, senza dire)."

# ------------------------------------------------- clauses: more shapes

rule clause.subject-after: S -> VP[finite=yes, form=fin, person=?p, number=?n, gender=?g] NP[case=nom, partitive=no, person=?p, number=?n, gender=?g]:subject
  "The subject can come after the verb (è arrivato Marco)."

rule clause.partitive-subject-after: S -> VP[finite=yes, form=fin, person=3, number=pl, gender=?g] PartNP[number=pl, gender=?g]:subject
  "A partitive subject after the verb is plural (sono arrivati dei ragazzi): del destino is not 'some destiny'."

rule clause.ce-partitive: S -> Pron[lemma=ci, clitic=yes, attached=no]:case Verb[lemma=essere, finite=yes, person=3, number=sg]:verb PartNP[number=sg]:subject
  "c'è + a singular partitive: there is some of a mass (c'è del pane, c'era della brava gente). Elsewhere a singular partitive is not a subject after the verb."

rule clause.phrase-first: S -> PP:adverbial S
  "A phrase with a preposition at the start of the clause (Dopo cena cammino sulla spiaggia)."

rule clause.adverb-first: S -> Adv[neg=no]:adverbial S
  "An adverb at the start of the clause (ieri, forse, ora)."

rule clause.subordinate: S -> S Conj[type=sub] S
  "A clause joined by quando, se, perché or che."

rule clause.subordinate-first: S -> Conj[type=sub] S Punct S
  "A clause with quando, se or perché first, then a comma (Se piove, resto a casa)."

rule clause.comma: S -> S Punct S
  "Two clauses separated by a comma."

rule clause.noun-phrase-after: S -> S Punct[lemma=;|:] NP
  "After a clause, ; or : and a noun phrase that names what the clause spoke of, or adds to it (Descrissi una lotta fra il leone e la tigre: argomento in armonia con la mia natura)."

rule clause.vocative-first: S -> ProperNoun Punct S
  "Addressing someone first, then a comma (Tom, vieni qui)."

rule clause.vocative-last: S -> S Punct ProperNoun
  "Addressing someone at the end, after a comma (Vieni qui, Tom)."

rule clause.interjection: S -> Intj Punct S
  "sì, no or ecco, then a comma (Sì, lo so)."

rule clause.or-not: S -> S Conj[lemma=o] Intj[lemma=no]
  "... o no? asks for a yes or no."

# ------------------------------------------------- questions

rule question.wh-adverb: S -> QAdv S
  "dove, quando, come or perché opens a question; the rest is an ordinary clause (Dove li hai messi?)."

rule question.wh-pronoun: S -> QPron S
  "chi, cosa or che opens a question and stands for the missing subject or object (Chi viene? Cosa fai?)."

rule question.wh-phrase: S -> WhP S
  "A question phrase opens the question (Che ora è? Quanti anni hai?)."

rule question.preposition: S -> Prep Wh S
  "A preposition + question word opens the question (A che ora ceni? Con chi parli?)."

rule wh.pronoun: Wh -> QPron
  "A question pronoun."

rule wh.phrase: Wh -> WhP
  "A question phrase."

rule whp.determiner: WhP -> QDet[number=?n, gender=?g] Nom[number=?n, gender=?g]
  "che, quale or quanto before a noun (che ora, quanti anni)."

rule whp.che-cosa: WhP -> QDet[lemma=che] QPron[lemma=cosa]
  "che cosa = what."

rule ap.coordination: AP[participle_di=no, number=?n, gender=?g] -> AP[number=?n, gender=?g] Conj[type=coord] AP[number=?n, gender=?g]
  "Two adjectives joined by e or o (intelligente e pratico, sani e salvi)."

rule np.list: NP[number=pl] -> NP Punct NPList
  "A list of noun phrases separated by commas, the last joined by e or o (cibo, feste e balli)."

rule nplist.last: NPList -> NP Conj[type=coord, lemma=e|o|ma|né|oppure|ossia|ovvero|nonché] NP
  "The end of a list: … e …"

rule nplist.more: NPList -> NP Punct NPList
  "A list item followed by a comma."

# extraposed infinitive, copula with clitics and in compound tenses
rule vp.copula-infinitive: VP[finite=yes, form=fin, mood=?m, person=3, number=sg, takes_di=?d, takes_a=?ta] -> Cop[mood=?m, person=3, number=sg, takes_di=?d, takes_a=?ta]:verb AP:subject-complement VP[form=inf]:subject
  "essere + adjective + infinitive: the infinitive is the real subject (è sbagliato dire bugie)."

rule cop.di-adverbial: Cop[mood=?m, person=?p, number=?n, takes_di=?d, takes_a=?ta] -> Cop[mood=?m, person=?p, number=?n, takes_di=?d, takes_a=?ta] DiAdv:adverbial
  "A fixed di phrase right after the linking verb (è diventato di nuovo attivo, è di solito puntuale)."

rule cop.proclitic: Cop[mood=?m, person=?p, number=?n, takes_di=?d, takes_a=?ta] -> Clitics[attached=no] Cop[mood=?m, person=?p, number=?n, takes_di=?d, takes_a=?ta]
  "A clitic before the linking verb (mi è sconosciuto, mi sembra strano)."

rule cop.perfect: Cop[mood=?m, person=?p, number=?n, takes_di=?d, takes_a=?ta, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> Verb[lemma=essere, finite=yes, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Verb[lemma=essere|sembrare|diventare|restare|rimanere|stare|risultare, form=pastpart, number=?n, takes_di=?d, takes_a=?ta]
  "A linking verb in a compound tense (è stato, è diventata, è risultato)."

# indirect questions
rule vp.indirect-question: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta] -> V[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta]:verb Wh S
  "A question inside the sentence (dimmi cosa mangi, non so quale prendere)."

rule vp.indirect-question-adverb: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta] -> V[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta]:verb QAdv S
  "A question with dove, quando, come or perché inside the sentence (non so dove sia)."

rule vp.indirect-question-preposition: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta] -> V[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta]:verb Prep Wh S
  "A question with a preposition inside the sentence (non so a cosa serva)."

# subordinate clause first, no comma; exclamations; sentences in a row
rule clause.subordinate-first-no-comma: S -> Conj[type=sub] S S
  "A clause with quando, se or perché first, without a comma (Quando incontri parole nuove devi cercarle)."

rule clause.exclamation: S -> QDet[lemma=che] Nom
  "che + noun as an exclamation (Che spreco!)."

# time expressions without a preposition
rule time.det-noun: TimeNP -> Det Noun[lemma=giorno|notte|mattina|sera|pomeriggio|settimana|mese|anno|ora|minuto|secondo|volta|estate|inverno|primavera|autunno|domenica|lunedì|martedì|mercoledì|giovedì|venerdì|sabato]
  "A time expression (ogni giorno, molte ore, la settimana scorsa)."

rule time.adjective: TimeNP -> TimeNP AP
  "A time expression with an adjective (la settimana scorsa)."

rule vp.time: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta] -> VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta] TimeNP:adverbial
  "A time expression after the verb says when or how often (mi esercito ogni giorno)."

rule clause.time-first: S -> TimeNP:adverbial S
  "A time expression at the start of the clause (Ogni mattina corro)."

# ------------------------------------------------- participle phrases
#
# A participle after a noun with the verb's own complements is a shortened
# relative clause: un giornale scritto in inglese (= che è stato scritto),
# il fiume passante per Parigi (= che passa). Mood participio; tense passato
# (passive or completed meaning) or presente (active, at the same time).

rule nom.participle-phrase: Nom[number=?n, gender=?g, onset=?o, utterance=?u] -> Nom[number=?n, gender=?g, onset=?o, utterance=?u] PartP[number=?n, gender=?g]
  "A participle phrase after the noun shortens a relative clause (un giornale scritto in inglese = che è stato scritto in inglese)."

rule partp.past: PartP[number=?n, gender=?g] -> Verb[form=pastpart, drifted=no, number=?n, gender=?g]:verb Compl:adverbial
  "Participio passato with the verb's complements: passive or completed meaning, agreeing with the noun (scritto in inglese, scritto da Tom)."

rule partp.present: PartP[number=?n, gender=?g] -> Verb[form=prespart, number=?n, gender=?g]:verb Compl:adverbial
  "Participio presente with the verb's complements: active meaning, at the same time, agreeing with the noun (passante per Parigi, tremanti nel vento)."

rule compl.phrase: Compl -> PP
  "A complement of the participle."

rule compl.more: Compl -> Compl PP
  "Another complement."

rule compl.adverb-phrase: Compl -> Adv[neg=no] PP
  "An adverb with its own prepositional phrase as the complement (dinanzi a casa, fuori di casa)."

rule clause.participle-first: S -> PartP Punct S
  "A participle clause before the main clause, then a comma: it says what happened first (Arrivato a casa, ho mangiato)."

rule clause.absolute-participle: S -> Verb[form=pastpart, drifted=no, number=?n, gender=?g]:verb NP[case=nom, number=?n, gender=?g]:subject Punct S
  "An absolute participle with its own noun phrase, agreeing with it in gender and number (Finito il lavoro, siamo usciti; Giunta la sera, tornammo a casa)."

rule pp.dopo-participle: PP[prep=dopo, infinitive=no] -> Prep[lemma=dopo] Verb[form=pastpart, drifted=no]
  "dopo + past participle: after doing it (dopo mangiato)."

rule vp.passive-agent: VP[finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf, voice=passive] -> Verb[lemma=essere, finite=yes, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf]:verb Verb[form=pastpart, takes_avere=yes, number=?n, gender=?g, takes_di=?d, takes_a=?ta]:verb Prep[lemma=da]:agent NP:agent
  "essere + past participle + da + agent: the passive (è amato da tutti)."

rule vp.copula-infinitive-adjective: VP[finite=no, form=inf, takes_di=?d, takes_a=?ta] -> Verb[lemma=essere|sembrare|diventare|restare|rimanere|stare, form=inf, takes_di=?d, takes_a=?ta]:verb AP[participle_essere=no]:subject-complement
  "An infinitive linking verb + adjective (essere imbarazzate)."

rule vp.floating-quantifier: VP[finite=?f, form=?fm, mood=?m, person=?p, number=pl, gender=?g, takes_di=?d, takes_a=?ta] -> VP[finite=?f, form=?fm, mood=?m, person=?p, number=pl, gender=?g, takes_di=?d, takes_a=?ta] Pron[lemma=tutto, number=pl]:subject
  "tutti / tutte after the verb, for the whole plural subject (se ne sono andati tutti)."

rule vp.naming-passive: VP[finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf, voice=passive] -> Verb[lemma=essere|venire, finite=yes, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf]:verb Verb[lemma=dire|chiamare|considerare|nominare|eleggere|ritenere|definire, form=pastpart, number=?n, gender=?g, takes_di=?d, takes_a=?ta]:verb NP:subject-complement
  "essere detto / chiamato / considerato + a noun: what the subject is called or considered (è detta petroliera)."

rule clause.phrase-after-comma: S -> S Punct[lemma!=.|?|!] PP[prep!=di]:adverbial
  "A comma, then a phrase with a preposition that adds how or where to the clause (rispose il ragazzo, con voce concitata)."

rule clause.indirect-object-first: S -> PP[prep=a, infinitive=no]:indirect-object VP[finite=yes, takes_a=yes]
  "The indirect object can come first, before a verb that takes one (a Marco piace, a Maria ho dato il libro)."

rule clause.indirect-object-first-subject-after: S -> PP[prep=a, infinitive=no]:indirect-object VP[finite=yes, form=fin, takes_a=yes, person=?p, number=?n, gender=?g] NP[case=nom, partitive=no, person=?p, number=?n, gender=?g]:subject
  "The indirect object first and the subject after the verb (a Marco piace il film)."

rule clause.indirect-object-first-subject-before: S -> PP[prep=a, infinitive=no]:indirect-object NP[case=nom, person=?p, number=?n, gender=?g]:subject VP[finite=yes, takes_a=yes, person=?p, number=?n, gender=?g]
  "The indirect object first, then the subject and the verb (a Marco il film piace)."

rule clause.phrase-first-comma: S -> PP:adverbial Punct S
  "A phrase with a preposition at the start, then a comma (Durante il viaggio verso Parigi, ci siamo fermati)."

rule vp.object-predicative: VP[finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta] -> V[lemma=rendere|fare|trovare|considerare|lasciare|tenere|avere|vedere|volere, finite=?f, form=?fm, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta]:verb NP[case=obl, number=?on, gender=?og]:direct-object AP[number=?on, gender=?og]:object-complement
  "Verb + object + an adjective saying what the object is or becomes (rendere le cose peggiori, ho le mani legate, ha lasciato la porta aperta)."

rule v.perfect-coordinated: V[aux=essere, lemma=?l, finite=yes, form=fin, mood=?m, person=?p, number=?n, gender=?g, takes_di=?d, takes_a=?ta, aux_mood=?m, aux_tense=?auxt, aux_person=?p, aux_number=?n, aux_form=?auxf] -> Verb[lemma=essere, finite=yes, mood=?m, person=?p, number=?n, tense=?auxt, form=?auxf] Verb[form=pastpart, takes_essere=yes, number=?n, gender=?g] Conj[type=coord] Verb[lemma=?l, form=pastpart, takes_essere=yes, number=?n, gender=?g, takes_di=?d, takes_a=?ta]
  "One auxiliary for two participles (sono nato e cresciuto)."
